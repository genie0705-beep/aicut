{
  "mainHtml": "<div class=\"dash-content\">\n\n      <!-- HOME TAB -->\n      <div id=\"tab-c-home\" class=\"dash-tab\">\n        <!-- 환영 히어로 리디자인 -->\n        <div class=\"cwh2\" style=\"background:linear-gradient(135deg,#0f0f1a,#1a0a3e);border-radius:20px;padding:28px 32px;margin-bottom:20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:20px\">\n          <div>\n            <h2 id=\"clientWelcomeTitle\" style=\"font-size:20px;font-weight:700;color:#fff;margin:0 0 4px\">안녕하세요 👋</h2>\n            <p id=\"clientWelcomeSub\" style=\"font-size:14px;color:rgba(255,255,255,0.5);margin:0\">오늘도 에이컷과 함께해요</p>\n          </div>\n          <div style=\"display:flex;gap:24px;flex-wrap:wrap\">\n            <div style=\"text-align:center\">\n              <div style=\"font-size:22px;font-weight:800;color:#a78bfa\" id=\"hdr-active\">0</div>\n              <div style=\"font-size:11px;color:rgba(255,255,255,0.45);margin-top:2px\">진행중</div>\n            </div>\n            <div style=\"text-align:center\">\n              <div style=\"font-size:22px;font-weight:800;color:#34d399\" id=\"hdr-done\">0</div>\n              <div style=\"font-size:11px;color:rgba(255,255,255,0.45);margin-top:2px\">완료</div>\n            </div>\n            <div style=\"text-align:center\">\n              <div style=\"font-size:22px;font-weight:800;color:#fff\" id=\"hdr-month\">0</div>\n              <div style=\"font-size:11px;color:rgba(255,255,255,0.45);margin-top:2px\">이번달</div>\n            </div>\n          </div>\n        </div>\n\n        <!-- 신규 가입자 온보딩 안내 (의뢰 0건일 때만 표시) -->\n        <div id=\"onboardingGuide\" style=\"display:none;background:linear-gradient(135deg,#ede9ff,#f5f3ff);border:1px solid var(--accent-light);border-radius:16px;padding:28px;margin-bottom:24px\">\n          <div style=\"font-size:18px;font-weight:800;color:var(--primary);margin-bottom:8px\">🎬 에이컷 시작 가이드</div>\n          <div style=\"font-size:14px;color:var(--gray-600);margin-bottom:20px;line-height:1.6\">아래 3단계로 첫 영상 편집을 의뢰해보세요. 평균 48시간 내 납품됩니다.</div>\n          <div style=\"display:flex;flex-direction:column;gap:12px\">\n            <div style=\"display:flex;align-items:center;gap:14px;background:white;border-radius:10px;padding:14px 16px;cursor:pointer\" onclick=\"showTab('client','c-upload',null)\">\n              <div style=\"width:36px;height:36px;border-radius:50%;background:var(--accent);color:white;font-weight:800;font-size:15px;display:flex;align-items:center;justify-content:center;flex-shrink:0\">1</div>\n              <div>\n                <div style=\"font-size:14px;font-weight:700;color:var(--primary)\">월 정기 계약 상담 신청</div>\n                <div style=\"font-size:12px;color:var(--gray-400);margin-top:2px\">STARTER 월 49만 ~ ENTERPRISE 맞춤 협의 · 전담 에디터 배정</div>\n              </div>\n              <div style=\"margin-left:auto;color:var(--accent);font-size:18px\">→</div>\n            </div>\n            <div style=\"display:flex;align-items:center;gap:14px;background:white;border-radius:10px;padding:14px 16px\">\n              <div style=\"width:36px;height:36px;border-radius:50%;background:var(--gray-200);color:var(--gray-500);font-weight:800;font-size:15px;display:flex;align-items:center;justify-content:center;flex-shrink:0\">2</div>\n              <div>\n                <div style=\"font-size:14px;font-weight:700;color:var(--gray-400)\">원본 파일 전달</div>\n                <div style=\"font-size:12px;color:var(--gray-400);margin-top:2px\">결제 완료 후 구글 드라이브 링크로 원본 영상 전달</div>\n              </div>\n            </div>\n            <div style=\"display:flex;align-items:center;gap:14px;background:white;border-radius:10px;padding:14px 16px\">\n              <div style=\"width:36px;height:36px;border-radius:50%;background:var(--gray-200);color:var(--gray-500);font-weight:800;font-size:15px;display:flex;align-items:center;justify-content:center;flex-shrink:0\">3</div>\n              <div>\n                <div style=\"font-size:14px;font-weight:700;color:var(--gray-400)\">완성본 수령</div>\n                <div style=\"font-size:12px;color:var(--gray-400);margin-top:2px\">평균 48시간 내 납품 · 수정 요청 가능</div>\n              </div>\n            </div>\n          </div>\n          <button class=\"btn btn-primary btn-full\" style=\"margin-top:20px;font-size:15px\" onclick=\"showTab('client','c-upload',null)\">🎬 첫 의뢰 시작하기 →</button>\n        </div>\n\n        <!-- 통계 카드 -->\n        <div class=\"stat-cards-grid\">\n          <div class=\"stat-card-new sc-purple\">\n            <span class=\"sc-icon\">📁</span>\n            <div class=\"sc-label\">총 의뢰</div>\n            <div class=\"sc-val\" id=\"statTotal\">0</div>\n          </div>\n          <div class=\"stat-card-new sc-pink\">\n            <span class=\"sc-icon\">⚡</span>\n            <div class=\"sc-label\">진행 중</div>\n            <div class=\"sc-val\" id=\"statActive\">0</div>\n          </div>\n          <div class=\"stat-card-new sc-green\">\n            <span class=\"sc-icon\">✅</span>\n            <div class=\"sc-label\">완료</div>\n            <div class=\"sc-val\" id=\"statDone\">0</div>\n          </div>\n          <div class=\"stat-card-new sc-amber\">\n            <span class=\"sc-icon\">💳</s",
