                <div style="display:flex;align-items:center;justify-content:space-between;gap:6px;font-size:11px"><span style="color:var(--gray-500);white-space:nowrap">1차 — 인트로 조정</span><span style="font-size:10px;font-weight:700;color:#059669;background:#d1fae5;padding:1px 7px;border-radius:10px;flex-shrink:0">완료</span></div>
                <div style="display:flex;align-items:center;justify-content:space-between;gap:6px;font-size:11px"><span style="color:var(--gray-500);white-space:nowrap">2차 — 자막 변경</span><span style="font-size:10px;font-weight:700;color:#059669;background:#d1fae5;padding:1px 7px;border-radius:10px;flex-shrink:0">완료</span></div>
                <div style="display:flex;align-items:center;justify-content:space-between;gap:6px;font-size:11px"><span style="color:var(--gray-500);white-space:nowrap">3차 — 컬러 조정</span><span style="font-size:10px;font-weight:700;color:#92400e;background:#fef3c7;padding:1px 7px;border-radius:10px;flex-shrink:0">진행중</span></div>
