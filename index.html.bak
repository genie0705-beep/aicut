  <!-- 네비 -->
  <div style="display:flex;align-items:center;justify-content:center;gap:14px;margin-top:24px">
    <button onclick="pGoSlide((psCur-1+5)%5)" style="width:40px;height:40px;border-radius:50%;border:1.5px solid var(--gray-200);background:white;font-size:16px;cursor:pointer;transition:all .2s">←</button>
    <div id="psDots" style="display:flex;gap:7px;align-items:center">
      <div onclick="pGoSlide(0)" style="width:20px;height:6px;border-radius:3px;background:#5c3de8;cursor:pointer;transition:all .3s"></div>
      <div onclick="pGoSlide(1)" style="width:6px;height:6px;border-radius:50%;background:var(--gray-200);cursor:pointer;transition:all .3s"></div>
      <div onclick="pGoSlide(2)" style="width:6px;height:6px;border-radius:50%;background:var(--gray-200);cursor:pointer;transition:all .3s"></div>
      <div onclick="pGoSlide(3)" style="width:6px;height:6px;border-radius:50%;background:var(--gray-200);cursor:pointer;transition:all .3s"></div>
      <div onclick="pGoSlide(4)" style="width:6px;height:6px;border-radius:50%;background:var(--gray-200);cursor:pointer;transition:all .3s"></div>
    </div>
    <button onclick="pGoSlide((psCur+1)%5)" style="width:40px;height:40px;border-radius:50%;border:1.5px solid var(--gray-200);background:white;font-size:16px;cursor:pointer;transition:all .2s">→</button>
  </div>

  <script>
  var psCur = 0, psTotal = 5, psAuto;
  window.pGoSlide = function(n) {
    psCur = ((n % psTotal) + psTotal) % psTotal;
    var slider = document.getElementById('psSlider');
    if (slider) slider.style.transform = 'translateX(-' + (psCur * 100) + '%)';

    // 스텝 인디케이터
    document.querySelectorAll('.ps-si').forEach(function(s, i) {
      var num = s.querySelector('.ps-sn');
      var lbl = s.querySelector('div:last-child');
      if (i <= psCur) {
        num.style.cssText = 'width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:800;transition:all .3s;background:#5c3de8;color:white;border:2px solid #5c3de8;' + (i === psCur ? 'box-shadow:0 0 0 5px rgba(92,61,232,0.15)' : 'box-shadow:none');
        lbl.style.color = '#5c3de8'; lbl.style.fontWeight = '700';
      } else {
        num.style.cssText = 'width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:800;transition:all .3s;background:var(--gray-100,#f3f4f6);color:#9ca3af;border:2px solid #e5e7eb;box-shadow:none';
        lbl.style.color = '#9ca3af'; lbl.style.fontWeight = '500';
      }
    });

    // 연결선 진행
    var line = document.getElementById('psLine');
    if (line) line.style.width = (psCur / (psTotal-1) * 80) + '%';

    // 점 인디케이터
    document.querySelectorAll('#psDots div').forEach(function(d, i) {
      d.style.width = i === psCur ? '20px' : '6px';
      d.style.borderRadius = i === psCur ? '3px' : '50%';
      d.style.background = i === psCur ? '#5c3de8' : '';
    });
  };

  function psStartAuto() {
    clearInterval(psAuto);
    psAuto = setInterval(function() { pGoSlide((psCur+1) % psTotal); }, 3500);
  }
  document.getElementById('steps-section').addEventListener('click', psStartAuto);
  psStartAuto();
  </script>

</section>

