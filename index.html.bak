      <div style="font-size:clamp(32px,8vw,80px);font-weight:900;line-height:1;letter-spacing:-1px;margin-top:0;background:linear-gradient(135deg,#ffffff,#a78bfa);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text"><span class="stats-count" data-target="92">92</span><span style="font-size:0.6em">%</span></div>
    </div>

    <div class="stats-divider" style="width:1px;height:50px;background:rgba(255,255,255,0.15);flex-shrink:0;align-self:center;height:clamp(40px,8vw,60px)"></div>

    <div style="text-align:center;flex:1;min-width:0;padding:0 clamp(8px,2.5vw,48px)">
      <div style="font-size:14px;font-weight:700;color:rgba(255,255,255,0.55);letter-spacing:0.3px;margin-bottom:8px;text-transform:uppercase;font-size:clamp(11px,2vw,14px);white-space:nowrap" data-i18n="stat_ontime">납기 준수율</div>
      <div style="font-size:clamp(32px,8vw,80px);font-weight:900;line-height:1;letter-spacing:-1px;margin-top:0;background:linear-gradient(135deg,#ffffff,#a78bfa);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text"><span class="stats-count" data-target="100">100</span><span style="font-size:0.6em">%</span></div>
