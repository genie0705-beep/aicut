/* ===== 고객 화면 비주얼 v3 ===== */

/* [1] 통계 카드 4개 색상 */
#page-client .stat-card-new.sc-purple { background: #f3f0ff; border-color: #c4b5fd; }
#page-client .stat-card-new.sc-purple .sc-icon { filter: none; }
#page-client .stat-card-new.sc-purple .sc-val { color: #6c63ff; }

#page-client .stat-card-new.sc-pink { background: #fff7ed; border-color: #fdba74; }
#page-client .stat-card-new.sc-pink .sc-val { color: #ea580c; }

#page-client .stat-card-new.sc-green { background: #f0fdf4; border-color: #86efac; }
#page-client .stat-card-new.sc-green .sc-val { color: #059669; }

#page-client .stat-card-new.sc-amber { background: #eff6ff; border-color: #93c5fd; }
#page-client .stat-card-new.sc-amber .sc-val { color: #2563eb; }

/* [1] 통계 카드 공통 둥글기·그림자 */
#page-client .stat-card-new {
  border-radius: 16px;
  box-shadow: 0 1px 8px rgba(0,0,0,.06), 0 0 0 1px rgba(0,0,0,.04);
  border-width: 1px;
}

/* [2] 주문 카드 배지 */
#page-client .badge { border-radius: 8px; font-size: 12px; padding: 4px 10px; }

/* [3] 단계 바 도트 현재 단계 1.3배 */
#page-client .spv-item.active .spv-dot { transform: scale(1.3); }

/* [4] 액션 박스 공통 — 좌측 보더 5px */
#page-client .action-box { border-left-width: 5px; border-radius: 12px; }

/* [5] 대시보드 패널 */
#page-client .panel { border-radius: 16px; border-color: #ede9ff; }

/* [6] 사이드바 로고 보라 강조 */
#page-client .sb-logo { color: #1e1b4b; }
#page-client .sb-logo span { color: #6c63ff; font-weight: 900; }

/* [6] 사이드바 활성 메뉴 — 아이콘도 보라 */
#page-client .sb-menu a.active .sb-icon { filter: none; color: #6c63ff; }

/* 주문 카드 border-radius */
#page-client .order-card { border-radius: 16px; }

/* 빈 상태 버튼 */
#page-client .empty-state-new button { border-radius: 50px; padding: 12px 28px; font-size: 14px; }

/* 검수 피드백 좌측 보더 */
#page-client .review-feedback-card { border-left-width: 5px; border-radius: 12px; }

/* 환영 히어로 카드 */
#page-client .client-welcome-hero { box-shadow: 0 4px 24px rgba(108,99,255,.25); }

/* 모바일 조정 */
@media(max-width: 640px) {
  #page-client .stat-card-new { border-radius: 14px; }
  #page-client .order-card { border-radius: 14px; }
  #page-client .action-box { border-radius: 10px; }
}
</style>
  <style>
@media(max-width:640px){
  #guidePopup{
    position:fixed!important;
    bottom:80px!important;
    left:20px!important;
    right:20px!important;
    top:auto!important;
    max-width:none!important;
    width:auto!important;
  }
  #guideTailTop,#guideTailBot{display:none!important}
}

/* ===== 진행 단계 바 애니메이션 ===== */

/* 1. 현재 단계 펄스 */
@keyframes spvPulse {
  0%   { box-shadow: 0 0 0 0 rgba(108,99,255,.5), 0 4px 12px rgba(108,99,255,.35); }
  70%  { box-shadow: 0 0 0 12px rgba(108,99,255,0), 0 4px 12px rgba(108,99,255,.2); }
  100% { box-shadow: 0 0 0 0 rgba(108,99,255,0), 0 4px 12px rgba(108,99,255,.35); }
}
.spv-item.active .spv-dot {
  animation: spvPulse 1.8s ease-in-out infinite;
}

/* 2. 완료 단계 체크 팝인 */
@keyframes spvCheckPop {
  0%   { transform: scale(0) rotate(-15deg); opacity: 0; }
  55%  { transform: scale(1.25) rotate(5deg); }
  80%  { transform: scale(0.95); }
  100% { transform: scale(1) rotate(0); opacity: 1; }
}
.spv-item.done .spv-dot {
  animation: spvCheckPop 0.45s cubic-bezier(.4,0,.2,1) both;
}

/* 3. 완료 연결선 — 채워지는 효과 */
@keyframes spvLineFill {
  from { transform: scaleX(0); transform-origin: left; }
  to   { transform: scaleX(1); transform-origin: left; }
}
.spv-item.done:not(:last-child)::after {
  animation: spvLineFill 0.5s ease forwards;
}

/* 4. 납품완료 단계 특별 — 바운스 + 별 파티클 */
@keyframes spvBounce {
  0%, 100% { transform: translateY(0) scale(1); }
  40%       { transform: translateY(-9px) scale(1.08); }
  60%       { transform: translateY(-4px) scale(1.04); }
}
.spv-item.active.spv-final .spv-dot {
  animation: spvBounce 1.2s ease-in-out infinite, spvPulse 1.8s ease-in-out infinite;
  background: linear-gradient(135deg, #10b981, #059669) !important;
}
/* 별 파티클 */
.spv-item.active.spv-final .spv-dot::before,
.spv-item.active.spv-final .spv-dot::after {
  content: '✦';
  position: absolute;
  font-size: 10px;
  color: #fbbf24;
  animation: spvStar 1.4s ease-in-out infinite;
}
.spv-item.active.spv-final .spv-dot::before { top: -10px; right: -8px; animation-delay: 0s; }
.spv-item.active.spv-final .spv-dot::after  { bottom: -10px; left: -8px; animation-delay: .7s; }
@keyframes spvStar {
  0%, 100% { opacity: 0; transform: scale(.5) rotate(0deg); }
  50%       { opacity: 1; transform: scale(1.2) rotate(180deg); }
}

/* 5. 현재 단계 라벨 "진행중" 뱃지 */
.spv-item.active .spv-time {
  background: #6c63ff;
  color: white !important;
  border-radius: 4px;
  padding: 1px 5px;
  font-size: 9px;
  font-weight: 700;
  margin-top: 3px;
}

/* 6. 호버 효과 */
.spv-item .spv-dot:hover { transform: scale(1.12); }
.spv-item.active .spv-dot:hover { transform: scale(1.12); }

/* 7. 페이지 진입 순차 등장 */
@keyframes spvFadeInUp {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: translateY(0); }
}
.spv-item { animation: spvFadeInUp 0.4s ease both; }
.spv-item:nth-child(1) { animation-delay: 0s;   }
.spv-item:nth-child(2) { animation-delay: .08s; }
.spv-item:nth-child(3) { animation-delay: .16s; }
.spv-item:nth-child(4) { animation-delay: .24s; }
.spv-item:nth-child(5) { animation-delay: .32s; }

/* 완료·대기 도트는 펄스 없음 (active 클래스만 펄스) */
.spv-item.done   .spv-dot { animation: spvCheckPop 0.45s cubic-bezier(.4,0,.2,1) both; }
.spv-item.waiting .spv-dot { animation: spvFadeInUp 0.4s ease both; }

/* ===== 주문 카드 미니 프로그레스 바 ===== */
.order-mini-progress { display:flex; flex-direction:column; gap:4px; margin-top:10px; padding-top:10px; border-top:1px solid #f1f5f9; }
.omp-track { display:flex; align-items:center; gap:0; position:relative; }
.omp-dot {
  width:10px; height:10px; border-radius:50%; flex-shrink:0;
  position:relative; z-index:1; transition:transform .2s;
}
.omp-dot.done    { background:#6c63ff; box-shadow:0 0 0 2px rgba(108,99,255,.2); }
.omp-dot.active  { background:#6c63ff; box-shadow:0 0 0 3px rgba(108,99,255,.25); animation:ompPulse 1.6s ease-in-out infinite; }
.omp-dot.waiting { background:#e2e8f0; border:1.5px solid #cbd5e1; }
.omp-line { flex:1; height:3px; }
.omp-line.done   { background:#6c63ff; }
.omp-line.active { background:linear-gradient(90deg,#6c63ff 40%,#e2e8f0 100%); }
.omp-line.waiting{ background:#e2e8f0; border-top:3px dashed #e2e8f0; height:0; }
.omp-labels { display:flex; justify-content:space-between; }
.omp-label {
  font-size:9px; color:#cbd5e1; flex:1; text-align:center;
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
  transition:color .2s, font-weight .2s;
}
.omp-label.done   { color:#10b981; }
.omp-label.active { color:#6c63ff; font-weight:800; }

@keyframes ompPulse {
  0%,100% { box-shadow:0 0 0 0 rgba(108,99,255,.5); }
  60%     { box-shadow:0 0 0 6px rgba(108,99,255,0); }
}

/* 카드 hover 개선 */
.order-card { border-left:3px solid transparent; transition:box-shadow .2s, transform .2s, border-color .2s; }
.order-card:hover { border-left-color:#6c63ff; transform:translateY(-2px); box-shadow:0 6px 24px rgba(108,99,255,.13); }

/* ===== 주문상세 단계바 v3 (강화) ===== */

/* 연결선 굵기 4px */
#page-client .spv-item:not(:last-child)::after {
  height: 4px;
  top: 19px; /* 도트 중심 */
}
#page-client .spv-item.done:not(:last-child)::after {
  background: linear-gradient(90deg, #6c63ff, #a78bfa);
}
#page-client .spv-item.active:not(:last-child)::after {
  background: linear-gradient(90deg, #6c63ff 50%, #e5e7eb);
}
#page-client .spv-item.waiting:not(:last-child)::after {
  background: none;
  border-top: 4px dashed #e5e7eb;
  height: 0;
}

/* 완료 도트: 20px + 보라 + ✓ 팝인 */
#page-client .spv-item.done .spv-dot {
  width: 20px; height: 20px;
  background: #6c63ff !important;
  color: white; font-size: 11px;
  box-shadow: 0 0 0 3px rgba(108,99,255,.2);
  animation: spvCheckPop .4s cubic-bezier(.4,0,.2,1) both;
}

/* 현재 도트: 24px + 상태 색상 + 흰 테두리 + glow */
#page-client .spv-item.active .spv-dot {
  width: 24px; height: 24px;
  border: 3px solid white;
  font-size: 13px;
  box-shadow: 0 0 0 3px rgba(108,99,255,.35), 0 4px 14px rgba(108,99,255,.3);
  animation: stepGlow 2s ease-in-out infinite;
  /* transform:scale(1.3) 제거 — 크기 명시 */
  transform: none !important;
}

/* 대기 도트: 16px + 흰 배경 + 회색 테두리 */
#page-client .spv-item.waiting .spv-dot {
  width: 16px; height: 16px;
  background: white !important;
  border: 2px solid #e5e7eb !important;
  color: #d1d5db;
  font-size: 10px;
  animation: none;
}

/* 라벨 */
#page-client .spv-item.done   .spv-label { color: #6c63ff; font-weight: 600; font-size: 11px; }
#page-client .spv-item.active .spv-label { color: inherit; font-weight: 800; font-size: 12px; }
#page-client .spv-item.waiting .spv-label { color: #9ca3af; font-size: 11px; }

/* 현재 단계 상태별 색상 */
#page-client .spv-item.active[data-key="payment_pending"] .spv-dot { background: #9ca3af !important; box-shadow: 0 0 0 3px rgba(156,163,175,.3),0 4px 14px rgba(156,163,175,.2); }
#page-client .spv-item.active[data-key="pending"]         .spv-dot { background: #f59e0b !important; box-shadow: 0 0 0 3px rgba(245,158,11,.3),0 4px 14px rgba(245,158,11,.2); animation: stepGlowAmber 2s ease-in-out infinite; }
#page-client .spv-item.active[data-key="editing"]         .spv-dot { background: #3b82f6 !important; box-shadow: 0 0 0 3px rgba(59,130,246,.3),0 4px 14px rgba(59,130,246,.2); animation: stepGlowBlue  2s ease-in-out infinite; }
#page-client .spv-item.active[data-key="review"]          .spv-dot { background: #a855f7 !important; box-shadow: 0 0 0 3px rgba(168,85,247,.3),0 4px 14px rgba(168,85,247,.2);  animation: stepGlowPurp  2s ease-in-out infinite; }
#page-client .spv-item.active[data-key="done"]            .spv-dot { background: #10b981 !important; box-shadow: 0 0 0 3px rgba(16,185,129,.3),0 4px 14px rgba(16,185,129,.2);  animation: stepGlowGreen 2s ease-in-out infinite; }

#page-client .spv-item.active[data-key="payment_pending"] .spv-label { color: #6b7280; }
#page-client .spv-item.active[data-key="pending"]         .spv-label { color: #d97706; }
#page-client .spv-item.active[data-key="editing"]         .spv-label { color: #2563eb; }
#page-client .spv-item.active[data-key="review"]          .spv-label { color: #9333ea; }
#page-client .spv-item.active[data-key="done"]            .spv-label { color: #059669; }

/* glow 애니메이션 (상태별) */
@keyframes stepGlow      { 0%,100%{box-shadow:0 0 0 3px rgba(108,99,255,.2),0 4px 14px rgba(108,99,255,.2)}  50%{box-shadow:0 0 0 8px rgba(108,99,255,0),0 4px 14px rgba(108,99,255,.35)} }
@keyframes stepGlowAmber { 0%,100%{box-shadow:0 0 0 3px rgba(245,158,11,.25),0 4px 14px rgba(245,158,11,.2)} 50%{box-shadow:0 0 0 8px rgba(245,158,11,0),0 4px 14px rgba(245,158,11,.35)} }
@keyframes stepGlowBlue  { 0%,100%{box-shadow:0 0 0 3px rgba(59,130,246,.25),0 4px 14px rgba(59,130,246,.2)} 50%{box-shadow:0 0 0 8px rgba(59,130,246,0),0 4px 14px rgba(59,130,246,.35)} }
@keyframes stepGlowPurp  { 0%,100%{box-shadow:0 0 0 3px rgba(168,85,247,.25),0 4px 14px rgba(168,85,247,.2)} 50%{box-shadow:0 0 0 8px rgba(168,85,247,0),0 4px 14px rgba(168,85,247,.35)} }
@keyframes stepGlowGreen { 0%,100%{box-shadow:0 0 0 3px rgba(16,185,129,.25),0 4px 14px rgba(16,185,129,.2)} 50%{box-shadow:0 0 0 8px rgba(16,185,129,0),0 4px 14px rgba(16,185,129,.35)} }

/* 진행중 뱃지 (spv-time) */
#page-client .spv-item.active .spv-time {
  background: #6c63ff; color: white !important;
  border-radius: 4px; padding: 1px 6px;
  font-size: 9px; font-weight: 800;
  margin-top: 4px; display: inline-block;
}

/* ===== 대시보드 주문카드 게이지 바 v2 ===== */
.omp-v2 {
  margin-top: 10px; padding-top: 10px;
  border-top: 1px solid #f1f5f9;
  display: flex; flex-direction: column; gap: 6px;
}
.omp-v2-bar {
  width: 100%; height: 6px;
  background: #f1f5f9; border-radius: 3px; overflow: hidden;
}
.omp-v2-fill {
  height: 100%; border-radius: 3px;
  transition: width .5s ease;
}
.omp-v2-status {
  display: flex; align-items: center; gap: 5px;
  font-size: 13px; font-weight: 700;
}
.omp-v2-dot {
  width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0;
}
.omp-v2-frac {
  font-size: 11px; color: #94a3b8; font-weight: 500; margin-left: 2px;
}

/* ===== 카드형 스텝 표시 v3 ===== */

/* 컨테이너 */
.step-progress-v2 {
  display: flex;
  align-items: center;
  gap: 0;
  margin-bottom: 24px;
  overflow-x: auto;
  padding: 4px 2px 8px;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
.step-progress-v2::-webkit-scrollbar { display: none; }

/* 스텝 카드 공통 */
.spc-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  flex: 1;
  min-width: 58px;
  height: 62px;
  border-radius: 12px;
  position: relative;
  cursor: default;
  animation: spcFadeUp .35s ease both;
  transition: transform .2s, box-shadow .2s;
}
.spc-card:hover { transform: translateY(-2px); }

/* 아이콘 */
.spc-icon {
  font-size: 18px;
  line-height: 1;
  display: block;
}

/* 라벨 */
.spc-label {
  font-size: 11px;
  white-space: nowrap;
  font-weight: 600;
}

/* 완료 */
.spc-done {
  opacity: .9;
}
.spc-done .spc-icon {
  font-size: 14px;
  color: white;
  background: rgba(255,255,255,.25);
  width: 26px; height: 26px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  animation: spcCheckIn .4s cubic-bezier(.4,0,.2,1) both;
}
.spc-done .spc-label { color: rgba(255,255,255,.9); }

/* 현재 */
.spc-active {
  transform: scale(1.06);
  z-index: 2;
}
.spc-active:hover { transform: scale(1.09) translateY(-2px); }
.spc-active .spc-icon { font-size: 20px; }
.spc-active .spc-label { color: white; font-weight: 800; font-size: 12px; }

/* 대기 */
.spc-wait { opacity: .48; }
.spc-wait .spc-icon { font-size: 16px; filter: grayscale(1); }
.spc-wait .spc-label { color: #9ca3af; }

/* 현재 단계 glow pulse (색상은 inline 배경에서 읽어 CSS custom property로) */
@keyframes spcPulse {
  0%,100% { box-shadow: 0 4px 16px rgba(0,0,0,.25); }
  50%      { box-shadow: 0 6px 28px rgba(0,0,0,.42); }
}
.spc-active { animation: spcFadeUp .35s ease both, spcPulse 2s ease-in-out infinite; }

/* 상태별 glow 색상 */
.spc-active[data-key="payment_pending"] { animation: spcFadeUp .35s ease both, spcPulseGrey  2s ease-in-out infinite; }
.spc-active[data-key="pending"]         { animation: spcFadeUp .35s ease both, spcPulseAmber 2s ease-in-out infinite; }
.spc-active[data-key="editing"]         { animation: spcFadeUp .35s ease both, spcPulseBlue  2s ease-in-out infinite; }
.spc-active[data-key="review"]          { animation: spcFadeUp .35s ease both, spcPulsePurp  2s ease-in-out infinite; }
.spc-active[data-key="done"]            { animation: spcFadeUp .35s ease both, spcPulseGreen 2s ease-in-out infinite; }

@keyframes spcPulseGrey  { 0%,100%{box-shadow:0 4px 16px rgba(107,114,128,.35)} 50%{box-shadow:0 6px 28px rgba(107,114,128,.6)} }
@keyframes spcPulseAmber { 0%,100%{box-shadow:0 4px 16px rgba(245,158,11,.35)}  50%{box-shadow:0 6px 28px rgba(245,158,11,.6)} }
@keyframes spcPulseBlue  { 0%,100%{box-shadow:0 4px 16px rgba(59,130,246,.35)}  50%{box-shadow:0 6px 28px rgba(59,130,246,.6)} }
@keyframes spcPulsePurp  { 0%,100%{box-shadow:0 4px 16px rgba(168,85,247,.35)}  50%{box-shadow:0 6px 28px rgba(168,85,247,.6)} }
@keyframes spcPulseGreen { 0%,100%{box-shadow:0 4px 16px rgba(16,185,129,.35)}  50%{box-shadow:0 6px 28px rgba(16,185,129,.6)} }

/* 진행중 점멸 도트 */
.spc-pulse-dot {
  width: 6px; height: 6px;
  background: rgba(255,255,255,.9);
  border-radius: 50%;
  position: absolute;
  bottom: 7px;
  animation: spcDotBlink 1s ease-in-out infinite;
}
@keyframes spcDotBlink { 0%,100%{opacity:.3} 50%{opacity:1} }

/* 화살표 */
.spc-arrow {
  font-size: 12px;
  color: #d1d5db;
  flex-shrink: 0;
  padding: 0 2px;
  margin-top: -8px; /* 카드 중심 정렬 */
  line-height: 1;
  align-self: center;
}
.spc-arrow-done   { color: #8b5cf6; }
.spc-arrow-active { color: #a78bfa; }

/* 체크 팝인 */
@keyframes spcCheckIn {
  0%   { transform: scale(0) rotate(-45deg); opacity: 0; }
  70%  { transform: scale(1.2) rotate(5deg); }
  100% { transform: scale(1) rotate(0); opacity: 1; }
}

/* 순차 등장 */
@keyframes spcFadeUp {
  from { opacity: 0; transform: translateY(8px) scale(.95); }
  to   { opacity: 1; transform: translateY(0)  scale(1); }
}
.spc-active { /* translateY override for active */ }
@keyframes spcFadeUpActive {
  from { opacity: 0; transform: translateY(8px) scale(1.0); }
  to   { opacity: 1; transform: translateY(0)  scale(1.06); }
}
.spc-active { animation-name: spcFadeUpActive, spcPulseBlue; }
.spc-active[data-key="payment_pending"] { animation-name: spcFadeUpActive, spcPulseGrey; }
.spc-active[data-key="pending"]         { animation-name: spcFadeUpActive, spcPulseAmber; }
.spc-active[data-key="editing"]         { animation-name: spcFadeUpActive, spcPulseBlue; }
.spc-active[data-key="review"]          { animation-name: spcFadeUpActive, spcPulsePurp; }
.spc-active[data-key="done"]            { animation-name: spcFadeUpActive, spcPulseGreen; }
.spc-active { animation-duration: .35s, 2s; animation-timing-function: ease, ease-in-out; animation-fill-mode: both, none; animation-iteration-count: 1, infinite; }

/* 모바일 */
@media(max-width: 480px) {
  .spc-card { min-width: 50px; height: 56px; border-radius: 10px; }
  .spc-icon { font-size: 15px; }
  .spc-label { font-size: 10px; }
  .spc-active { transform: scale(1.04); }
}

/* 기존 spv- 클래스 override (page-client 스코프) */
#page-client #clientStepProgressV2 .spv-item,
#page-client #clientStepProgressV2 .spv-dot,
#page-client #clientStepProgressV2 .spv-label,
#page-client #clientStepProgressV2 .spv-time { display: none !important; }

/* ===== 대시보드 단계 배지 트렌드 v2 ===== */
.dsb-wrap {
  display: flex;
  gap: 5px;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 6px;
}
.dsb {
  display: inline-flex;
  align-items: center;
  border-radius: 20px;
  padding: 3px 10px;
  font-size: 11px;
  font-weight: 600;
  white-space: nowrap;
  cursor: default;
  animation: dsbPop .3s ease both;
  transition: transform .15s ease, box-shadow .15s ease;
}
.dsb:hover { transform: translateY(-1px); }

/* 완료 */
.dsb-done {
  color: white;
  opacity: .88;
}
.dsb-done:hover { opacity: 1; }

/* 현재 (강조) */
.dsb-active {
  color: white;
  font-size: 12px;
  font-weight: 700;
  padding: 4px 12px;
  transform: scale(1.05);
}
.dsb-active:hover { transform: scale(1.08) translateY(-1px); }

/* 대기 */
.dsb-wait {
  background: white;
  color: #9ca3af;
  border: 1px solid #e5e7eb;
  opacity: .6;
}
.dsb-wait:hover { opacity: .85; }

/* 등장 애니메이션 */
@keyframes dsbPop {
  0%   { opacity: 0; transform: scale(.8); }
  60%  { transform: scale(1.06); }
  100% { opacity: 1; transform: scale(1); }
}
.dsb-active { animation: dsbPopActive .3s ease both; }
@keyframes dsbPopActive {
  0%   { opacity: 0; transform: scale(.85); }
  60%  { transform: scale(1.1); }
  100% { opacity: 1; transform: scale(1.05); }
}

/* ============================================
   레퍼런스 스타일 단계 바 (ref-step)
   대시보드 · 내 주문 · 주문 상세 공통
   ============================================ */
.rs-wrap { width:100%; }

/* 아이콘 행 */
.rs-icons {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0;
  margin-bottom: 10px;
}
.rs-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  flex: 1;
  position: relative;
}
/* 화살표 */
.rs-arrow {
  color: #d1d5db;
  font-size: 14px;
  align-self: center;
  flex-shrink: 0;
  padding: 0 2px;
  margin-top: -10px; /* 아이콘 중간 맞춤 */
  line-height: 1;
}
.rs-arrow.done  { color: #8b5cf6; }
.rs-arrow.active{ color: #c4b5fd; }

/* 원형 아이콘 */
.rs-icon {
  width: 48px; height: 48px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 20px;
  flex-shrink: 0;
  transition: transform .2s, box-shadow .2s;
  animation: rsFadeUp .35s ease both;
  position: relative;
}
.rs-step:nth-child(1)  .rs-icon { animation-delay: .00s; }
.rs-step:nth-child(3)  .rs-icon { animation-delay: .08s; }
.rs-step:nth-child(5)  .rs-icon { animation-delay: .16s; }
.rs-step:nth-child(7)  .rs-icon { animation-delay: .24s; }
.rs-step:nth-child(9)  .rs-icon { animation-delay: .32s; }

/* 완료 */
.rs-icon.rs-done  { background: #374151; color: white; font-size: 28px; width: 56px; height: 56px; filter: none; }
/* 현재 */
.rs-icon.rs-active {
  background: #1f2937;
  color: white;
  font-size: 30px;
  width: 60px; height: 60px;
  box-shadow: 0 4px 14px rgba(31,41,55,.4);
  animation: rsFadeUp .35s ease both, rsGlowGray2 2s ease-in-out infinite;
}
/* 상태별 현재 색상 */
/* 상태별 다색 제거 — 단일 브랜드 보라 (#6c63ff) 로 통일 */
.rs-icon.rs-active[data-key="payment_pending"],
.rs-icon.rs-active[data-key="pending"],
.rs-icon.rs-active[data-key="editing"],
.rs-icon.rs-active[data-key="review"],
.rs-icon.rs-active[data-key="done"] {
  background: #1f2937;
  box-shadow: 0 4px 14px rgba(31,41,55,.4);
  animation: rsFadeUp .35s ease both, rsGlowGray2 2s ease-in-out infinite;
}
/* 대기 */
.rs-icon.rs-wait  { background: #f3f4f6; color: #9ca3af; opacity: .65; font-size: 24px; width: 52px; height: 52px; }

.rs-icon:hover { transform: scale(1.08); }
.rs-icon.rs-active:hover { transform: scale(1.12); }

/* 라벨 */
.rs-label {
  font-size: 12px; font-weight: 500; color: #6b7280;
  text-align: center; white-space: nowrap;
  line-height: 1.3;
}
.rs-label.rs-done   { color: #374151; font-weight: 700; }
.rs-label.rs-active { color: #1f2937; font-weight: 800; }
.rs-label.rs-wait   { color: #9ca3af; opacity: .65; }

/* 상세 페이지 설명 문구 */
.rs-desc {
  font-size: 11px; color: #6c63ff; margin-top: 2px;
  text-align: center; white-space: nowrap;
  font-weight: 500; line-height: 1.3;
}

/* 프로그레스 바 */
.rs-bar-wrap { position: relative; margin-top: 2px; }
.rs-bar {
  width: 100%; height: 4px;
  background: #e5e7eb; border-radius: 2px; overflow: hidden;
}
.rs-bar-fill {
  height: 100%; border-radius: 2px;
  background: linear-gradient(90deg, #6c63ff, #8b5cf6);
  transition: width .8s ease;
}
.rs-dday {
  position: absolute; right: 0; top: -20px;
  font-size: 11px; font-weight: 700;
  padding: 2px 8px; border-radius: 6px;
}
.rs-dday.safe  { background: #d1fae5; color: #065f46; }
.rs-dday.warn  { background: #fef3c7; color: #92400e; }
.rs-dday.over  { background: #fee2e2; color: #991b1b; }

/* 애니메이션 */
@keyframes rsFadeUp {
  from { opacity:0; transform:translateY(8px) scale(.92); }
  to   { opacity:1; transform:translateY(0) scale(1); }
}
@keyframes rsGlow     { 0%,100%{box-shadow:0 4px 14px rgba(108,99,255,.35)} 50%{box-shadow:0 4px 22px rgba(108,99,255,.6)} }
@keyframes rsGlowGray { 0%,100%{box-shadow:0 4px 14px rgba(107,114,128,.3)} 50%{box-shadow:0 4px 22px rgba(107,114,128,.55)} }
@keyframes rsGlowAmb  { 0%,100%{box-shadow:0 4px 14px rgba(245,158,11,.35)} 50%{box-shadow:0 4px 22px rgba(245,158,11,.6)} }
@keyframes rsGlowBlue { 0%,100%{box-shadow:0 4px 14px rgba(59,130,246,.35)}  50%{box-shadow:0 4px 22px rgba(59,130,246,.6)} }
@keyframes rsGlowPurp { 0%,100%{box-shadow:0 4px 14px rgba(168,85,247,.35)}  50%{box-shadow:0 4px 22px rgba(168,85,247,.6)} }
@keyframes rsGlowGrn  { 0%,100%{box-shadow:0 4px 14px rgba(16,185,129,.35)}  50%{box-shadow:0 4px 22px rgba(16,185,129,.6)} }
@keyframes rsCheckIn  { 0%{transform:scale(0) rotate(-30deg);opacity:0} 70%{transform:scale(1.2)} 100%{transform:scale(1);opacity:1} }
.rs-icon.rs-done { animation: rsFadeUp .35s ease both; }

/* 모바일 */
@media(max-width:480px) {
  .rs-icon { width:36px; height:36px; font-size:16px; }
  .rs-icon.rs-done { font-size:14px; }
  .rs-label { font-size:10px; }
  .rs-desc  { font-size:10px; }
  .rs-arrow { font-size:11px; }
}

/* rs-label active 단일 보라 */
.rs-label.rs-active { color: #1f2937 !important; }

/* ===== 대시보드 최근 의뢰 카드 ===== */
.dash-order-card {
  background: white;
  border-radius: 14px;
  border: 1px solid #f1f5f9;
  padding: 16px 18px;
  margin-bottom: 10px;
  cursor: pointer;
  transition: box-shadow .18s, border-color .18s;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.dash-order-card:hover { box-shadow: 0 4px 20px rgba(108,99,255,.12); border-color: #c4b5fd; }
.dash-order-card:last-child { margin-bottom: 0; }

/* ① 주문번호 + 이름 */
.doc-row1 { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
.doc-oid  { font-size: 12px; color: #9ca3af; font-weight: 500; white-space: nowrap; }
.doc-name { font-size: 14px; font-weight: 700; color: #111; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* ② 스텝 바 (rs-wrap) */
.doc-steps .rs-wrap { margin: 0; }
.doc-steps .rs-icon       { width: 40px; height: 40px; font-size: 20px; }
.doc-steps .rs-icon.rs-done   { width: 44px; height: 44px; font-size: 22px; }
.doc-steps .rs-icon.rs-active { width: 48px; height: 48px; font-size: 24px; }
.doc-steps .rs-label { font-size: 10px; }
.doc-steps .rs-arrow { font-size: 11px; margin-top: -6px; }
.doc-steps .rs-bar   { height: 3px; }

/* ③ 배지 행 */
.doc-row3 { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }

/* ④ 납품예정 */
.doc-dl { font-size: 12px; color: #9ca3af; }

/* ⑤ 버튼 */
.doc-btn-wrap { display: flex; justify-content: flex-end; }
.doc-btn {
  background: #6c63ff; color: white; border: none;
  border-radius: 20px; padding: 6px 20px;
  font-size: 13px; font-weight: 600; cursor: pointer;
  min-width: 72px; max-width: 120px; width: fit-content;
  transition: opacity .15s, transform .15s;
}
.doc-btn:hover { opacity: .88; transform: translateY(-1px); }

/* dashOrderTable이 card-list가 아닌 경우를 대비해 flex 설정 */
#dashOrderTable { display: flex !important; flex-direction: column; gap: 0; }

@media(max-width: 480px) {
  .dash-order-card { padding: 14px 14px; gap: 8px; }
  .doc-steps .rs-icon { width: 28px; height: 28px; font-size: 13px; }
  .doc-steps .rs-label { font-size: 9px; }
  .doc-name { font-size: 13px; }
}

@keyframes rsGlowGray2 { 0%,100%{box-shadow:0 4px 14px rgba(31,41,55,.3)} 50%{box-shadow:0 4px 22px rgba(31,41,55,.55)} }

/* ===== 타임라인형 스텝 카드 v4 ===== */
.ts-wrap { width:100%; }

/* 카드 행 */
.ts-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0;
  margin-bottom: 10px;
}

/* 연결선 */
.ts-line {
  flex: 1;
  height: 2px;
  min-width: 6px;
  align-self: center;
  margin-bottom: 18px; /* 라벨 높이 보정 */
}
.ts-line.done    { background: #374151; }
.ts-line.active  { background: #374151; }
.ts-line.wait    { background: none; border-top: 2px dashed #d1d5db; }

/* 스텝 카드 공통 */
.ts-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5px;
  border-radius: 12px;
  cursor: default;
  animation: tsSlideIn .35s ease both;
  flex-shrink: 0;
}
.ts-card:nth-child(1) { animation-delay: .00s; }
.ts-card:nth-child(3) { animation-delay: .08s; }
.ts-card:nth-child(5) { animation-delay: .16s; }
.ts-card:nth-child(7) { animation-delay: .24s; }
.ts-card:nth-child(9) { animation-delay: .32s; }

.ts-emoji { line-height: 1; display: block; }
.ts-label { white-space: nowrap; line-height: 1.2; }

/* 완료 */
.ts-card.ts-done {
  background: #1f2937;
  padding: 10px 14px;
  width: 72px; height: 64px;
  box-shadow: 0 2px 8px rgba(0,0,0,.15);
}
.ts-card.ts-done .ts-emoji { font-size: 24px; }
.ts-card.ts-done .ts-label { font-size: 11px; color: #fff; font-weight: 500; }

/* 현재 */
.ts-card.ts-active {
  background: linear-gradient(135deg, #1f2937, #374151);
  padding: 12px 16px;
  width: 80px; height: 72px;
  border: 2px solid #4b5563;
  box-shadow: 0 6px 20px rgba(31,41,55,.35);
  transform: translateY(-4px);
  animation: tsSlideIn .35s ease both, tsFloat 3s ease-in-out infinite;
  z-index: 1;
}
.ts-card.ts-active .ts-emoji { font-size: 28px; }
.ts-card.ts-active .ts-label { font-size: 12px; color: #fff; font-weight: 700; }

/* 대기 */
.ts-card.ts-wait {
  background: #f9fafb;
  padding: 10px 14px;
  width: 72px; height: 64px;
  border: 1.5px solid #e5e7eb;
}
.ts-card.ts-wait .ts-emoji { font-size: 22px; opacity: .4; }
.ts-card.ts-wait .ts-label { font-size: 11px; color: #9ca3af; font-weight: 400; }

/* 진행 바 */
.ts-bar-wrap { position: relative; }
.ts-bar {
  width: 100%; height: 3px;
  background: #f3f4f6; border-radius: 2px; overflow: hidden;
}
.ts-bar-fill {
  height: 100%; border-radius: 2px;
  background: #1f2937;
  transition: width .8s ease;
}
.ts-dday {
  position: absolute; right: 0; top: -20px;
  font-size: 11px; font-weight: 700;
  padding: 2px 8px; border-radius: 6px;
}
.ts-dday.safe { background:#d1fae5; color:#065f46; }
.ts-dday.warn { background:#fef3c7; color:#92400e; }
.ts-dday.over { background:#fee2e2; color:#991b1b; }

/* 상세 설명 (주문 상세 전용) */
.ts-desc { font-size:11px; color:#6c63ff; margin-top:3px; text-align:center; white-space:nowrap; }

/* 애니메이션 */
@keyframes tsSlideIn {
  from { opacity:0; transform: translateY(8px); }
  to   { opacity:1; transform: translateY(0); }
}
@keyframes tsFloat {
  0%,100% { transform: translateY(-4px); }
  50%     { transform: translateY(-7px); }
}
/* active는 float가 tsSlideIn과 겹치므로 delay 처리 */
.ts-card.ts-active { animation: tsSlideIn .35s ease both, tsFloat 3s .4s ease-in-out infinite; }

/* 모바일 */
@media(max-width:480px) {
  .ts-card.ts-done   { width:52px; height:52px; padding:8px 6px; border-radius:10px; }
  .ts-card.ts-active { width:58px; height:58px; padding:10px 8px; border-radius:10px; }
  .ts-card.ts-wait   { width:52px; height:52px; padding:8px 6px; border-radius:10px; }
  .ts-card.ts-done   .ts-emoji { font-size:18px; }
  .ts-card.ts-active .ts-emoji { font-size:22px; }
  .ts-card.ts-wait   .ts-emoji { font-size:16px; }
  .ts-card.ts-done   .ts-label,
  .ts-card.ts-active .ts-label,
  .ts-card.ts-wait   .ts-label { font-size:10px; }
}

/* ===== stats-section 롤링 아이콘 다크 배경 override ===== */
#stats-section .rs-item {
  flex-direction: row;
  align-items: center;
  gap: 10px;
  background: rgba(255,255,255,0.07);
  border: 1.5px solid rgba(255,255,255,0.1);
  border-radius: 14px;
  padding: 12px 18px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  transition: background .2s, border-color .2s, transform .2s, box-shadow .2s;
}
#stats-section .rs-item:hover {
  background: rgba(255,255,255,0.13);
  border-color: rgba(255,255,255,0.25);
  box-shadow: 0 4px 16px rgba(108,99,255,.18);
  transform: translateY(-2px);
}
#stats-section .rs-icon {
  width: auto; height: auto;
  border-radius: 0;
  background: none;
  border: none;
  box-shadow: none;
  font-size: 28px;
  flex-shrink: 0;
}
#stats-section .rs-item:hover .rs-icon {
  box-shadow: none;
  border-color: transparent;
}
#stats-section .rs-label {
  font-size: 14px;
  font-weight: 500;
  color: rgba(255,255,255,0.75);
  white-space: nowrap;
}
#stats-section .rs-item:hover .rs-label {
  color: #ffffff;
}
/* 데스크톱 override 무효화 */
@media(min-width:769px) {
  #stats-section .rs-icon {
    width: auto; height: auto;
    font-size: 28px;
    border-radius: 0;
    background: none;
    border: none;
  }
  #stats-section .rs-label { font-size: 14px; }
}

/* stats 모바일 */
@media(max-width:640px) {
  #stats-section > div[style*="padding:48px 60px"] {
    padding: 28px 16px !important;
    flex-wrap: wrap;
    gap: 8px;
  }
  #stats-section .stats-divider { display: none; }
}

/* 하단 CTA 요금제 버튼 hover */
.final-cta-btns .btn-outline:hover {
  background: rgba(255,255,255,0.15) !important;
  border-color: #ffffff !important;
}

/* 하단 CTA 버튼 — 전역 btn-outline 완전 override */
.final-cta .btn-outline,
.final-cta .btn-xl.btn-outline {
  background: transparent !important;
  color: #ffffff !important;
  border: 2px solid rgba(255,255,255,0.8) !important;
  border-radius: 8px !important;
  -webkit-text-fill-color: #ffffff !important;
}
.final-cta .btn-outline:hover,
.final-cta .btn-xl.btn-outline:hover {
  background: rgba(255,255,255,0.15) !important;
  border-color: #ffffff !important;
  color: #ffffff !important;
}
/* VFX 견적 버튼도 동일 */
.vfx-cta-row .btn,
.vfx-section .btn[onclick="openB2B()"] {
  background: transparent !important;
  color: #ffffff !important;
  border: 2px solid rgba(255,255,255,0.8) !important;
  border-radius: 8px !important;
}

/* ===== 고객 UI 리디자인 v5 ===== */

/* 환영 배너 모바일 */
@media(max-width:640px) {
  .cwh2 { flex-direction: column; padding: 20px 18px !important; }
  .cwh2 > div:last-child { gap: 16px !important; width: 100%; justify-content: space-around; display: flex; }
}

/* 숫자 타임라인 스텝 */
.nts-wrap { width: 100%; margin-bottom: 0; }
.nts-row {
  display: flex;
  align-items: center;
  margin-bottom: 8px;
}
.nts-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  flex-shrink: 0;
}
.nts-dot {
  width: 24px; height: 24px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 11px; font-weight: 700;
  line-height: 1;
  transition: all .2s;
}
.nts-lbl {
  font-size: 10px;
  white-space: nowrap;
  line-height: 1;
}
/* 완료 */
.nts-done .nts-dot  { background: #1f2937; color: #fff; font-size: 10px; }
.nts-done .nts-lbl  { color: #374151; font-weight: 700; }
/* 현재 */
.nts-active .nts-dot {
  background: #6c63ff; color: #fff;
  width: 28px; height: 28px; font-size: 12px;
  box-shadow: 0 0 0 4px rgba(108,99,255,.2);
  animation: ntsPulse 1.8s ease-in-out infinite;
}
.nts-active .nts-lbl { color: #6c63ff; font-weight: 800; font-size: 11px; }
/* 대기 */
.nts-wait .nts-dot  { background: #f3f4f6; color: #9ca3af; border: 1.5px dashed #e5e7eb; }
.nts-wait .nts-lbl  { color: #9ca3af; }
/* 연결선 */
.nts-line { flex: 1; height: 2px; margin-bottom: 14px; }
.nts-line-done   { background: #1f2937; }
.nts-line-active { background: linear-gradient(90deg, #1f2937, #e5e7eb); }
.nts-line-wait   { background: none; border-top: 2px dashed #e5e7eb; }
/* 현재 설명 */
.nts-desc { font-size: 10px; color: #6c63ff; white-space: nowrap; margin-top: 2px; }
/* 진행 바 */
.nts-bar-wrap { position: relative; }
.nts-bar { width: 100%; height: 3px; background: #f3f4f6; border-radius: 2px; overflow: hidden; }
.nts-fill { height: 100%; background: #1f2937; border-radius: 2px; transition: width .8s ease; }
.nts-dday {
  position: absolute; right: 0; top: -18px;
  font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 5px;
}
.nts-dday.safe { background: #d1fae5; color: #065f46; }
.nts-dday.warn { background: #fef3c7; color: #92400e; }
.nts-dday.over { background: #fee2e2; color: #991b1b; }

@keyframes ntsPulse {
  0%,100% { box-shadow: 0 0 0 3px rgba(108,99,255,.25); }
  50%     { box-shadow: 0 0 0 7px rgba(108,99,255,0); }
}

/* 상태 배지 통일 */
.badge-pending {
  background: #fef3c7 !important;
  color: #d97706 !important;
  border-radius: 20px;
  padding: 4px 12px;
  font-size: 12px;
  font-weight: 600;
}
.badge-editing {
  background: #dbeafe !important;
  color: #2563eb !important;
  border-radius: 20px;
  padding: 4px 12px;
  font-size: 12px;
  font-weight: 600;
}
.badge-review, .badge-done {
  background: #d1fae5 !important;
  color: #059669 !important;
  border-radius: 20px;
  padding: 4px 12px;
  font-size: 12px;
  font-weight: 600;
}

/* 주문 카드 강화 */
.order-card {
  background: #ffffff;
  border-radius: 16px;
  border: 1px solid #f0f0f0;
  box-shadow: 0 2px 12px rgba(0,0,0,.06);
  padding: 20px 24px;
  transition: box-shadow .2s, transform .2s;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.order-card:hover {
  box-shadow: 0 8px 32px rgba(0,0,0,.12);
  transform: translateY(-2px);
}

/* 대시보드 카드 */
.dash-order-card {
  background: #ffffff;
  border-radius: 16px;
  border: 1px solid #f0f0f0;
  box-shadow: 0 2px 12px rgba(0,0,0,.06);
  padding: 20px 24px;
  margin-bottom: 10px;
  cursor: pointer;
  transition: box-shadow .2s, transform .2s;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.dash-order-card:hover {
  box-shadow: 0 8px 32px rgba(0,0,0,.12);
  transform: translateY(-2px);
  border-color: #e5e7eb;
}

/* 모바일 스텝 */
@media(max-width:480px) {
  .nts-dot { width: 20px; height: 20px; font-size: 10px; }
  .nts-active .nts-dot { width: 24px; height: 24px; font-size: 11px; }
  .nts-lbl { font-size: 9px; }
}

/* ============================================
   고객 UI 리디자인 v6 — 미니멀 + 슬림
   ============================================ */

/* ── 1. 환영 배너 ── */
.cwh2 {
  background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%) !important;
  border-radius: 20px;
  padding: 28px 36px;
  box-shadow: 0 4px 24px rgba(99,91,255,0.2);
  display: flex; align-items: center;
  justify-content: space-between;
  flex-wrap: wrap; gap: 16px;
  margin-bottom: 20px;
}
.cwh2 h2 { font-size: 22px; font-weight: 700; color: #fff; margin: 0 0 4px; }
.cwh2 p  { font-size: 14px; color: rgba(255,255,255,0.6); margin: 0; }
.cwh2 .cwh2-stats { display: flex; gap: 24px; }
.cwh2 .cwh2-stat  { text-align: center; }
.cwh2 .cwh2-num   { font-size: 22px; font-weight: 800; }
.cwh2 .cwh2-lbl   { font-size: 11px; color: rgba(255,255,255,0.45); margin-top: 2px; }
@media(max-width: 640px) {
  .cwh2 { padding: 18px 18px !important; }
  .cwh2-stats { gap: 16px !important; }
}

/* ── 2. 통계 카드 ── */
.stat-cards-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-bottom: 20px;
}
@media(max-width: 640px) {
  .stat-cards-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
}
.stat-card-new {
  background: #ffffff;
  border-radius: 16px;
  border: 1px solid #f0f0f0;
  box-shadow: 0 1px 8px rgba(0,0,0,.05);
  padding: 20px 24px;
  transition: box-shadow .18s;
}
.stat-card-new:hover { box-shadow: 0 4px 16px rgba(0,0,0,.09); }
.stat-card-new .sc-icon { font-size: 28px; margin-bottom: 8px; display: block; background: none !important; }
.stat-card-new .sc-label { font-size: 12px; color: #9ca3af; font-weight: 500; }
.stat-card-new .sc-val { font-size: 26px; font-weight: 800; margin-top: 4px; line-height: 1; }
/* 색상 유지 */
.stat-card-new.sc-purple .sc-val { color: #6c63ff; }
.stat-card-new.sc-pink   .sc-val { color: #6c63ff; }
.stat-card-new.sc-green  .sc-val { color: #059669; }
.stat-card-new.sc-amber  .sc-val { color: #111111; }
/* 배경 통일 */
.stat-card-new.sc-purple,
.stat-card-new.sc-pink,
.stat-card-new.sc-green,
.stat-card-new.sc-amber { background: #ffffff; border-color: #f0f0f0; }

/* ── 3. 슬림 숫자 타임라인 스텝 바 ── */
.nts-wrap { width: 100%; }
.nts-row {
  display: flex;
  align-items: flex-end;
  margin-bottom: 8px;
}
.nts-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5px;
  flex-shrink: 0;
}
.nts-dot {
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-weight: 700; line-height: 1;
  transition: all .2s;
}
/* 완료 */
.nts-done .nts-dot  { width:36px; height:36px; background:#1f2937; color:#fff; font-size:13px; }
.nts-done .nts-lbl  { font-size:11px; color:#374151; font-weight:600; }
/* 현재 */
.nts-active .nts-dot {
  width:40px; height:40px; background:#6c63ff; color:#fff; font-size:14px;
  box-shadow: 0 0 0 4px rgba(108,99,255,.2);
  animation: ntsGlow 2s ease-in-out infinite;
}
.nts-active .nts-lbl { font-size:12px; color:#6c63ff; font-weight:800; }
/* 대기 */
.nts-wait .nts-dot  { width:36px; height:36px; background:#f9fafb; border:2px solid #e5e7eb; color:#d1d5db; font-size:12px; }
.nts-wait .nts-lbl  { font-size:11px; color:#d1d5db; }
/* 연결선 */
.nts-line { flex:1; margin-bottom:18px; }
.nts-line-done   { height:2px; background:#1f2937; }
.nts-line-active { height:2px; background:linear-gradient(90deg,#1f2937,#e5e7eb); }
.nts-line-wait   { height:0; border-top:2px dashed #e5e7eb; }
/* 설명 (주문상세 전용) */
.nts-desc { font-size:10px; color:#6c63ff; white-space:nowrap; }
/* 진행 바 */
.nts-bar-wrap { position:relative; }
.nts-bar { width:100%; height:3px; background:#f3f4f6; border-radius:2px; overflow:hidden; }
.nts-fill { height:100%; background:#1f2937; border-radius:2px; transition:width .8s ease; }
.nts-dday { position:absolute; right:0; top:-18px; font-size:10px; font-weight:700; padding:2px 7px; border-radius:5px; }
.nts-dday.safe { background:#dcfce7; color:#16a34a; }
.nts-dday.warn { background:#fef3c7; color:#d97706; }
.nts-dday.over { background:#fee2e2; color:#dc2626; }
@keyframes ntsGlow {
  0%,100% { box-shadow:0 0 0 4px rgba(108,99,255,.2); }
  50%     { box-shadow:0 0 0 8px rgba(108,99,255,.1); }
}
/* 모바일 */
@media(max-width:480px) {
  .nts-done .nts-dot   { width:28px; height:28px; font-size:11px; }
  .nts-active .nts-dot { width:32px; height:32px; font-size:12px; }
  .nts-wait .nts-dot   { width:28px; height:28px; font-size:11px; }
  .nts-done .nts-lbl, .nts-active .nts-lbl, .nts-wait .nts-lbl { font-size:9px; }
}

/* ── 4. 주문 카드 ── */
.order-card, .dash-order-card {
  background: #ffffff;
  border-radius: 16px;
  border: 1px solid #f0f0f0;
  box-shadow: 0 2px 8px rgba(0,0,0,.04);
  padding: 20px 24px;
  cursor: pointer;
  transition: box-shadow .2s, transform .2s;
  display: flex; flex-direction: column; gap: 12px;
  border-left: 3px solid #e5e7eb; /* 기본 */
}
.order-card:hover, .dash-order-card:hover {
  box-shadow: 0 8px 24px rgba(0,0,0,.08);
  transform: translateY(-2px);
}
.dash-order-card { margin-bottom: 12px; }
/* 상태별 좌측 보더 */
.order-card[data-status="done"],    .dash-order-card[data-status="done"]    { border-left-color: #16a34a; }
.order-card[data-status="editing"], .dash-order-card[data-status="editing"] { border-left-color: #2563eb; }
.order-card[data-status="review"],  .dash-order-card[data-status="review"]  { border-left-color: #db2777; }
.order-card[data-status="pending"], .dash-order-card[data-status="pending"],
.order-card[data-status="waiting"], .dash-order-card[data-status="waiting"] { border-left-color: #d97706; }

/* 카드 상단 헤더 (이모티콘 제거, 텍스트 중심) */
.order-card-top { display:flex; align-items:flex-start; justify-content:space-between; gap:8px; }
.order-card-meta { flex:1; min-width:0; }
.order-card-title { font-size:15px; font-weight:700; color:#111; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin-bottom:3px; }
.order-card-sub   { font-size:12px; color:#9ca3af; }
.order-card-emoji { display:none !important; } /* 이모티콘 아이콘 숨김 */

/* 상태 배지 통일 */
.badge { border-radius:20px; padding:3px 10px; font-size:11px; font-weight:600; display:inline-flex; align-items:center; gap:3px; white-space:nowrap; }
.badge-pending { background:#f3f4f6 !important; color:#6b7280 !important; }
.badge-editing { background:#dbeafe !important; color:#2563eb !important; }
.badge-review  { background:#fce7f3 !important; color:#db2777 !important; }
.badge-done    { background:#dcfce7 !important; color:#16a34a !important; }

/* 카드 하단 */
.order-card-footer { display:flex; align-items:center; justify-content:space-between; padding-top:0; border-top:none; }
.order-card-deadline { font-size:12px; color:#9ca3af; }
/* 상세보기 버튼 */
.doc-btn, .order-card-footer .btn-outline {
  background: #f9fafb !important;
  color: #374151 !important;
  border: 1px solid #e5e7eb !important;
  border-radius: 8px;
  padding: 6px 16px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: background .15s, color .15s;
}
.doc-btn:hover, .order-card-footer .btn-outline:hover {
  background: #6c63ff !important;
  color: #ffffff !important;
  border-color: #6c63ff !important;
}
.doc-btn { border-radius: 8px !important; background: #f9fafb !important; }

/* 모바일 카드 */
@media(max-width:640px) {
  .order-card, .dash-order-card { padding:16px 14px; }
  .doc-btn { width:100%; text-align:center; padding:10px; }
}

/* ============================================================
   AICUT 고객 UI — 최종 단일 스타일시트 (v7)
   대시보드 · 내주문 · 주문상세 공통
   ============================================================ */

/* ── 환영 배너 ── */
.cwh2 {
  background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);
  border-radius: 20px;
  padding: 28px 36px;
  box-shadow: 0 4px 24px rgba(99,91,255,.2);
  display: flex; align-items: center;
  justify-content: space-between; flex-wrap: wrap; gap: 16px;
  margin-bottom: 20px;
}
.cwh2 h2 { font-size: 22px; font-weight: 700; color: #fff; margin: 0 0 4px; }
.cwh2 p  { font-size: 14px; color: rgba(255,255,255,.6); margin: 0; }
.cwh2-stats { display: flex; gap: 24px; }
.cwh2-stat  { text-align: center; }
.cwh2-num   { font-size: 22px; font-weight: 800; }
.cwh2-lbl   { font-size: 11px; color: rgba(255,255,255,.45); margin-top: 2px; }
@media(max-width:640px) {
  .cwh2 { padding: 18px !important; }
  .cwh2-stats { gap: 14px; }
}

/* ── 통계 카드 ── */
.stat-cards-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:20px; }
@media(max-width:640px) { .stat-cards-grid { grid-template-columns:repeat(2,1fr); gap:10px; } }
.stat-card-new {
  background: #fff; border-radius: 16px;
  border: 1px solid #f0f0f0;
  box-shadow: 0 1px 8px rgba(0,0,0,.05);
  padding: 20px 24px;
  transition: box-shadow .18s;
}
.stat-card-new:hover { box-shadow: 0 4px 16px rgba(0,0,0,.09); }
.stat-card-new .sc-icon  { font-size: 28px; margin-bottom: 8px; display: block; }
.stat-card-new .sc-label { font-size: 12px; color: #9ca3af; font-weight: 500; }
.stat-card-new .sc-val   { font-size: 26px; font-weight: 800; margin-top: 4px; line-height: 1; color: #111; }
.stat-card-new.sc-purple .sc-val { color: #6c63ff; }
.stat-card-new.sc-pink   .sc-val { color: #6c63ff; }
.stat-card-new.sc-green  .sc-val { color: #059669; }
.stat-card-new.sc-amber  .sc-val { color: #111; }
.stat-card-new.sc-purple,
.stat-card-new.sc-pink,
.stat-card-new.sc-green,
.stat-card-new.sc-amber  { background: #fff; border-color: #f0f0f0; }

/* ── 주문 카드 공통 ── */
.order-card, .dash-order-card {
  background: #fff;
  border-radius: 16px;
  border: 1.5px solid #f0f0f0;
  border-left: 4px solid #e5e7eb;
  box-shadow: 0 2px 12px rgba(0,0,0,.05);
  padding: 20px 24px;
  cursor: pointer;
  transition: box-shadow .2s, transform .2s;
  display: flex; flex-direction: column; gap: 12px;
  overflow: hidden;
}
.order-card:hover, .dash-order-card:hover {
  box-shadow: 0 6px 24px rgba(0,0,0,.1);
  transform: translateY(-2px);
}
.dash-order-card { margin-bottom: 12px; }
/* 상태별 좌측 보더 */
.order-card[data-status="done"],     .dash-order-card[data-status="done"]     { border-left-color: #10b981; }
.order-card[data-status="editing"],  .dash-order-card[data-status="editing"]  { border-left-color: #3b82f6; }
.order-card[data-status="review"],   .dash-order-card[data-status="review"]   { border-left-color: #f59e0b; }
.order-card[data-status="pending"],  .dash-order-card[data-status="pending"],
.order-card[data-status="waiting"],  .dash-order-card[data-status="waiting"]  { border-left-color: #f97316; }
.order-card[data-status="payment_pending"], .dash-order-card[data-status="payment_pending"] { border-left-color: #9ca3af; }

/* 카드 헤더 */
.order-card-top   { display:flex; align-items:flex-start; justify-content:space-between; gap:8px; }
.order-card-emoji { display:none !important; }
.order-card-meta  { flex:1; min-width:0; }
.order-card-title { font-size:15px; font-weight:700; color:#111; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin-bottom:3px; }
.order-card-sub   { font-size:12px; color:#9ca3af; }

/* 카드 하단 */
.order-card-footer { display:flex; align-items:center; justify-content:space-between; border-top:none; padding-top:0; }
.order-card-deadline { font-size:12px; color:#9ca3af; }

/* 상태 배지 */
.badge { display:inline-flex; align-items:center; gap:3px; border-radius:20px; padding:4px 12px; font-size:12px; font-weight:600; white-space:nowrap; }
.badge-pending          { background:#f3f4f6 !important; color:#6b7280 !important; }
.badge-editing          { background:#dbeafe !important; color:#2563eb !important; }
.badge-review           { background:#fef3c7 !important; color:#d97706 !important; }
.badge-done             { background:#d1fae5 !important; color:#059669 !important; }

/* 상세보기 버튼 */
.doc-btn, .order-card-footer .btn {
  background: #f9fafb !important; color: #374151 !important;
  border: 1px solid #e5e7eb !important; border-radius: 8px !important;
  padding: 6px 16px; font-size: 13px; font-weight: 600;
  cursor: pointer; transition: background .15s, color .15s;
  white-space: nowrap;
}
.doc-btn:hover, .order-card-footer .btn:hover {
  background: #6c63ff !important; color: #fff !important; border-color: #6c63ff !important;
}

/* 대시보드 카드 내 doc-* */
.doc-row1  { display:flex; align-items:baseline; gap:8px; flex-wrap:wrap; }
.doc-oid   { font-size:12px; color:#9ca3af; }
.doc-name  { font-size:15px; font-weight:700; color:#111; }
.doc-row3  { display:flex; align-items:center; gap:6px; flex-wrap:wrap; }
.doc-dl    { font-size:12px; color:#9ca3af; }
.doc-btn-wrap { display:flex; justify-content:flex-end; }
.doc-steps .nts-bar { height:2px; }

/* 빈 상태 */
.empty-state-new { text-align:center; padding:56px 24px; background:#fff; border-radius:20px; box-shadow:0 2px 12px rgba(0,0,0,.05); }
.empty-state-new .es-emoji { font-size:64px; margin-bottom:16px; display:block; animation:esBounce 2.4s ease-in-out infinite; }
@keyframes esBounce { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-10px)} }
.empty-state-new h3 { font-size:18px; font-weight:800; color:#1e293b; margin:0 0 8px; }
.empty-state-new p  { font-size:14px; color:#94a3b8; margin:0 0 24px; line-height:1.7; }

/* ── 숫자 타임라인 스텝 바 (nts) ── */
.nts-wrap { width:100%; }
.nts-row  { display:flex; align-items:flex-end; margin-bottom:8px; }
.nts-step { display:flex; flex-direction:column; align-items:center; gap:5px; flex-shrink:0; }
.nts-dot  { border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:700; line-height:1; transition:all .2s; }
/* 완료 */
.nts-done   .nts-dot { width:36px; height:36px; background:#1f2937; color:#fff; font-size:13px; }
.nts-done   .nts-lbl { font-size:11px; color:#374151; font-weight:600; white-space:nowrap; }
/* 현재 */
.nts-active .nts-dot {
  width:40px; height:40px; background:#6c63ff; color:#fff; font-size:14px;
  box-shadow:0 0 0 4px rgba(108,99,255,.2);
  animation:ntsGlow 2s ease-in-out infinite;
}
.nts-active .nts-lbl { font-size:12px; color:#6c63ff; font-weight:800; white-space:nowrap; }
/* 대기 */
.nts-wait   .nts-dot { width:36px; height:36px; background:#f9fafb; border:2px solid #e5e7eb; color:#d1d5db; font-size:12px; }
.nts-wait   .nts-lbl { font-size:11px; color:#d1d5db; white-space:nowrap; }
/* 연결선 */
.nts-line        { flex:1; margin-bottom:18px; }
.nts-line-done   { height:2px; background:#1f2937; }
.nts-line-active { height:2px; background:linear-gradient(90deg,#1f2937,#e5e7eb); }
.nts-line-wait   { height:0; border-top:2px dashed #e5e7eb; }
/* 설명 */
.nts-desc { font-size:10px; color:#6c63ff; white-space:nowrap; }
/* 진행 바 */
.nts-bar-wrap { position:relative; }
.nts-bar      { width:100%; height:3px; background:#f3f4f6; border-radius:2px; overflow:hidden; }
.nts-fill     { height:100%; background:#1f2937; border-radius:2px; transition:width .8s ease; }
.nts-dday     { position:absolute; right:0; top:-18px; font-size:10px; font-weight:700; padding:2px 7px; border-radius:5px; }
.nts-dday.safe { background:#d1fae5; color:#16a34a; }
.nts-dday.warn { background:#fef3c7; color:#d97706; }
.nts-dday.over { background:#fee2e2; color:#dc2626; }
@keyframes ntsGlow {
  0%,100% { box-shadow:0 0 0 4px rgba(108,99,255,.2); }
  50%     { box-shadow:0 0 0 8px rgba(108,99,255,.1); }
}

/* 모바일 */
@media(max-width:480px) {
  .nts-done   .nts-dot { width:28px; height:28px; font-size:11px; }
  .nts-active .nts-dot { width:32px; height:32px; font-size:12px; }
  .nts-wait   .nts-dot { width:28px; height:28px; font-size:11px; }
  .nts-done .nts-lbl, .nts-active .nts-lbl, .nts-wait .nts-lbl { font-size:9px; }
  .order-card, .dash-order-card { padding:16px 14px; }
  .doc-btn { padding:9px 12px; }
}

/* 플로팅 새 의뢰 버튼 */
#clientFab { position:fixed; bottom:28px; right:24px; z-index:900; display:none; }
#clientFab button {
  background:linear-gradient(135deg,#6c63ff,#8b5cf6); color:#fff; border:none;
  border-radius:50px; padding:14px 22px; font-size:14px; font-weight:700;
  cursor:pointer; box-shadow:0 4px 20px rgba(108,99,255,.4);
  display:flex; align-items:center; gap:8px; white-space:nowrap;
  transition:transform .2s, box-shadow .2s;
}
#clientFab button:hover { transform:translateY(-2px); box-shadow:0 8px 28px rgba(108,99,255,.55); }

/* ============================================================
   AICUT 레퍼런스 스타일 스텝 바 (rst) — v8
   ============================================================ */

/* 스텝 바 컨테이너 */
.rst-wrap { width: 100%; }
.rst-row  {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 14px;
}

/* 각 스텝 */
.rst-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

/* 아이콘 원형 */
.rst-icon {
  width: 56px; height: 56px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  transition: all .2s;
  flex-shrink: 0;
}
.rst-done   .rst-icon { background: #6c63ff; color: white; }
.rst-active .rst-icon {
  background: #6c63ff; color: white;
  box-shadow: 0 4px 16px rgba(108,99,255,.4);
  animation: rstPulse 2s ease-in-out infinite;
}
.rst-wait   .rst-icon { background: #f0f0f5; color: #c0bfd8; }

/* 라벨 */
.rst-lbl {
  font-size: 12px; text-align: center; white-space: nowrap; line-height: 1;
}
.rst-done   .rst-lbl { color: #6c63ff; font-weight: 600; }
.rst-active .rst-lbl { color: #6c63ff; font-weight: 700; }
.rst-wait   .rst-lbl { color: #c0bfd8; font-weight: 400; }

/* 설명 (주문상세 전용) */
.rst-desc { font-size: 10px; color: #6c63ff; white-space: nowrap; text-align: center; }

/* 화살표 연결자 */
.rst-arrow {
  color: #c0bfd8;
  font-size: 20px;
  margin-top: 18px; /* 아이콘 중간 맞춤 */
  padding: 0 4px;
  flex-shrink: 0;
  line-height: 1;
}
.rst-arrow.done { color: #6c63ff; }

/* 프로그레스 바 */
.rst-bar-wrap { position: relative; margin-top: 4px; }
.rst-bar {
  width: 100%; height: 4px;
  background: #f0f0f5; border-radius: 2px; overflow: hidden;
}
.rst-fill {
  height: 100%;
  background: linear-gradient(90deg, #6c63ff, #8b5cf6);
  border-radius: 2px;
  transition: width .6s ease;
}

/* D-DAY 배지 */
.rst-dday {
  position: absolute; right: 0; top: -20px;
  font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 6px;
}
.rst-dday.safe { background: #d1fae5; color: #16a34a; }
.rst-dday.warn { background: #fef3c7; color: #d97706; }
.rst-dday.over { background: #fee2e2; color: #dc2626; }

/* 펄스 */
@keyframes rstPulse {
  0%,100% { box-shadow: 0 4px 16px rgba(108,99,255,.35); }
  50%     { box-shadow: 0 4px 24px rgba(108,99,255,.6); }
}

/* 모바일 */
@media(max-width:480px) {
  .rst-icon { width: 40px; height: 40px; }
  .rst-icon svg { width: 18px; height: 18px; }
  .rst-lbl  { font-size: 10px; }
  .rst-arrow { font-size: 14px; margin-top: 14px; padding: 0 2px; }
}

/* ===== 카카오톡 채널 상담 버튼 ===== */
#kakaoChannelBtn {
  position: fixed;
  bottom: 90px;       /* 채널톡 버튼 위 */
  right: 20px;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  cursor: pointer;
  transition: transform .2s;
  text-decoration: none;
}
#kakaoChannelBtn:hover { transform: translateY(-3px); }
#kakaoChannelBtn .kakao-icon {
  width: 52px; height: 52px;
  background: #FEE500;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4px 16px rgba(0,0,0,.18);
  font-size: 26px;
  line-height: 1;
}
#kakaoChannelBtn .kakao-label {
  font-size: 10px;
  font-weight: 700;
  color: #191919;
  background: #FEE500;
  border-radius: 10px;
  padding: 2px 7px;
  white-space: nowrap;
  box-shadow: 0 2px 6px rgba(0,0,0,.12);
}
@media(max-width: 640px) {
  #kakaoChannelBtn { bottom: 80px; right: 14px; }
  #kakaoChannelBtn .kakao-icon { width: 46px; height: 46px; font-size: 22px; }
}

/* stats 모바일 — 가로 배열 유지 (inline style로 처리) */

/* ===== 카카오톡 채널 플로팅 버튼 ===== */
#kakaoChannelBtn {
  position: fixed;
  bottom: 88px;
  right: 20px;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  cursor: pointer;
  transition: transform .2s;
  text-decoration: none;
}
#kakaoChannelBtn:hover { transform: translateY(-3px); }
#kakaoChannelBtn .kakao-icon {
  width: 52px; height: 52px;
  background: #FEE500;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 4px 16px rgba(0,0,0,.2);
  font-size: 26px; line-height: 1;
}
#kakaoChannelBtn .kakao-label {
  font-size: 10px; font-weight: 700;
  color: #191919;
  background: #FEE500;
  border-radius: 10px;
  padding: 2px 7px;
  white-space: nowrap;
  box-shadow: 0 2px 6px rgba(0,0,0,.12);
}
@media(max-width: 640px) {
  #kakaoChannelBtn { bottom: 82px; right: 14px; }
  #kakaoChannelBtn .kakao-icon { width: 46px; height: 46px; font-size: 22px; }
}

/* ===== NDA 약관 섹션 (결제대기 액션박스 내) ===== */
.nda-box {
  background: white;
  border: 1.5px solid #fed7aa;
  border-radius: 10px;
  padding: 14px 16px;
  margin: 12px 0;
  font-size: 13px;
  box-sizing: border-box;
  width: 100%;
}
.nda-box .nda-title {
  font-size: 13px; font-weight: 700; color: #92400e;
  margin-bottom: 8px; display: flex; align-items: center; gap: 6px;
}
.nda-box .nda-summary {
  font-size: 12px; color: #78350f; line-height: 1.7;
  margin-bottom: 10px; word-break: keep-all;
}
.nda-box .nda-toggle {
  font-size: 12px; color: #d97706; cursor: pointer;
  text-decoration: underline; margin-bottom: 8px;
  display: inline-block;
  /* 터치 영역 확보 */
  padding: 4px 0; min-height: 36px; line-height: 28px;
}
.nda-box .nda-full {
  display: none;
  font-size: 11px; color: #78350f; line-height: 1.8;
  background: #fff7ed; border-radius: 6px;
  padding: 10px 12px; margin-bottom: 10px;
  max-height: 180px; overflow-y: auto;
  word-break: keep-all;
  -webkit-overflow-scrolling: touch;
}
.nda-box .nda-full.open { display: block; }
.nda-check-wrap {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 0 2px;
  /* 터치 영역 확보 */
  min-height: 44px;
}
.nda-check-wrap input[type="checkbox"] {
  width: 20px; height: 20px;
  cursor: pointer; accent-color: #f59e0b;
  flex-shrink: 0;
}
.nda-check-wrap label {
  font-size: 13px; font-weight: 600; color: #92400e;
  cursor: pointer; line-height: 1.4; word-break: keep-all;
}
/* 동의 전 버튼 비활성화 */
.ab-btn-amber:disabled {
  background: #d1d5db !important; color: #9ca3af !important;
  cursor: not-allowed; box-shadow: none; opacity: 1;
}
/* 모바일 추가 최적화 */
@media(max-width: 480px) {
  .nda-box { padding: 12px 14px; }
  .nda-box .nda-title { font-size: 12px; }
  .nda-box .nda-summary { font-size: 11px; }
  .nda-check-wrap label { font-size: 12px; }
  .nda-box .nda-full { max-height: 140px; font-size: 11px; }
}

/* ===== 서비스 안내 탭 FAQ 아코디언 ===== */
.svc-faq-item { border-bottom: 1px solid #f1f5f9; }
.svc-faq-q {
  display: flex; justify-content: space-between; align-items: center;
  padding: 14px 0; font-size: 14px; font-weight: 600; color: #111;
  cursor: pointer; user-select: none; gap: 8px;
}
.svc-faq-q:hover { color: #6c63ff; }
.svc-faq-arrow {
  font-size: 20px; color: #9ca3af; flex-shrink: 0;
  transition: transform .2s;
}
.svc-faq-item.open .svc-faq-arrow { transform: rotate(90deg); color: #6c63ff; }
.svc-faq-a {
  display: none; font-size: 13px; color: #6b7280;
  line-height: 1.75; padding-bottom: 14px; word-break: keep-all;
}
.svc-faq-item.open .svc-faq-a { display: block; }

/* ===== 숏폼 특화 섹션 ===== */
.shorts-ticker {
  overflow: hidden;
  width: 100%;
  max-width: 600px;
  margin: 16px auto 8px;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 30px;
  padding: 8px 0;
}
.shorts-ticker-inner {
  display: inline-flex;
  gap: 16px;
  align-items: center;
  white-space: nowrap;
  animation: tickerScroll 20s linear infinite;
  font-size: 13px;
  color: rgba(255,255,255,0.7);
  font-weight: 600;
  padding: 0 24px;
}
.st-num { color: #a78bfa; font-weight: 800; }
.st-div { color: rgba(255,255,255,0.3); }
@keyframes tickerScroll {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

/* 숏폼 카드 */
.shorts-card {
  width: 160px;
  height: 280px;
  border-radius: 20px;
  background: linear-gradient(160deg, #1a1040, #0f0f1a);
  border: 1px solid rgba(108,99,255,0.3);
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: transform .3s, box-shadow .3s;
  overflow: hidden;
}
.shorts-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(160deg, rgba(108,99,255,0.1), transparent);
  border-radius: 20px;
}
.shorts-card:hover { transform: translateY(-8px) scale(1.03); box-shadow: 0 20px 40px rgba(108,99,255,0.3); }
.shorts-card-active {
  border-color: #6c63ff;
  background: linear-gradient(160deg, #1e1b4b, #1a1040);
  box-shadow: 0 8px 32px rgba(108,99,255,0.25);
  transform: scale(1.05);
}
.shorts-card-active:hover { transform: translateY(-8px) scale(1.08); }
.shorts-card-inner { text-align: center; z-index: 1; }
.shorts-play {
  width: 48px; height: 48px;
  background: rgba(108,99,255,0.3);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 18px; color: #fff;
  margin: 0 auto 16px;
  border: 1px solid rgba(108,99,255,0.5);
}
.shorts-label { font-size: 14px; font-weight: 700; color: #fff; margin-bottom: 6px; }
.shorts-count { font-size: 11px; color: rgba(255,255,255,0.5); }
.shorts-badge {
  position: absolute; top: 12px; right: 12px;
  background: rgba(255,255,255,0.1);
  border-radius: 20px; padding: 3px 10px;
  font-size: 10px; font-weight: 700; color: #fff;
}
.shorts-badge-purple { background: rgba(108,99,255,0.4); }
.shorts-badge-green  { background: rgba(16,185,129,0.3); color: #34d399; }

/* 세로 비율 표시선 */
.shorts-card::after {
  content: '9:16';
  position: absolute;
  bottom: 12px;
  font-size: 9px;
  color: rgba(255,255,255,0.3);
  font-weight: 700;
  letter-spacing: 1px;
}

@media(max-width:480px) {
  .shorts-card { width: 120px; height: 210px; }
  .shorts-ticker { max-width: 100%; }
}

/* ===== 숏폼 YouTube 임베드 카드 ===== */
.shorts-embed-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  position: relative;
  transition: transform .3s;
}
.shorts-embed-wrap:hover { transform: translateY(-6px); }
.shorts-embed-active { transform: scale(1.05); }
.shorts-embed-active:hover { transform: scale(1.05) translateY(-6px); }
.shorts-embed-frame {
  width: 180px;
  height: 320px;
  border-radius: 16px;
  overflow: hidden;
  border: 2px solid rgba(108,99,255,0.4);
  box-shadow: 0 8px 32px rgba(0,0,0,0.4);
  background: #0f0f1a;
  position: relative;
}
.shorts-embed-active .shorts-embed-frame {
  border-color: #6c63ff;
  box-shadow: 0 12px 40px rgba(108,99,255,0.35);
}
.shorts-embed-badge {
  background: rgba(255,255,255,0.1);
  border-radius: 20px; padding: 4px 12px;
  font-size: 11px; font-weight: 700; color: #fff;
  backdrop-filter: blur(6px);
}
.shorts-embed-label {
  font-size: 12px; color: rgba(255,255,255,0.5);
  font-weight: 600;
}
/* 랜덤 변경 버튼 */
.shorts-refresh-btn {
  background: rgba(108,99,255,0.15);
  border: 1px solid rgba(108,99,255,0.3);
  color: #a78bfa;
  border-radius: 20px;
  padding: 8px 20px;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: all .2s;
  margin-bottom: 32px;
  font-family: 'Pretendard', sans-serif;
}
.shorts-refresh-btn:hover {
  background: rgba(108,99,255,0.3);
  color: #fff;
}
@media(max-width:480px) {
  .shorts-embed-frame { width: 130px; height: 230px; }
  .shorts-embed-active { transform: scale(1.02); }
}

/* ===== SHORTS GALLERY — 자동 롤링 ===== */
.sv-outer {
  position: relative;
  width: 100%;
  overflow: hidden;
  padding: 16px 0 24px;
}

/* 롤링 트랙 — 무한 루프 */
.sv-track {
  display: flex;
  gap: 28px;
  padding: 0 60px;
  width: max-content;
  animation: svRoll 35s linear infinite;
  will-change: transform;
}
.sv-track:hover { animation-play-state: paused; }

@keyframes svRoll {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.sv-card {
  flex-shrink: 0;
  width: 280px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  transition: transform .3s, filter .3s;
  cursor: pointer;
}
.sv-card:hover {
  transform: translateY(-10px) scale(1.03);
  filter: drop-shadow(0 16px 32px rgba(108,99,255,0.4));
  z-index: 2;
}
.sv-card-hot {
  transform: scale(1.06);
}
.sv-card-hot:hover {
  transform: translateY(-10px) scale(1.09);
}

.sv-frame {
  width: 280px;
  height: 498px;
  border-radius: 20px;
  overflow: hidden;
  border: 2px solid rgba(108,99,255,0.25);
  box-shadow: 0 16px 48px rgba(30,20,60,0.2), 0 4px 12px rgba(0,0,0,0.1);
  background: #111;
  position: relative;
}
.sv-card-hot .sv-frame {
  border-color: #6c63ff;
  box-shadow: 0 12px 48px rgba(108,99,255,0.5);
}

.sv-tag {
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 20px;
  padding: 5px 14px;
  font-size: 11px;
  font-weight: 700;
  color: #fff;
  white-space: nowrap;
  backdrop-filter: blur(6px);
}
.sv-tag-purple { background: rgba(108,99,255,0.25); border-color: rgba(108,99,255,0.4); color: #c4b5fd; }
.sv-tag-green  { background: rgba(16,185,129,0.15); border-color: rgba(16,185,129,0.3); color: #34d399; }
.sv-tag-amber  { background: rgba(245,158,11,0.15); border-color: rgba(245,158,11,0.3); color: #fbbf24; }

.sv-label {
  font-size: 11px;
  color: rgba(255,255,255,0.4);
  font-weight: 600;
}

/* 좌우 페이드 */
.sv-fade-left, .sv-fade-right {
  position: absolute;
  top: 0; bottom: 0;
  width: 140px;
  pointer-events: none;
  z-index: 3;
}
.sv-fade-left  { left:  0; background: linear-gradient(to right, #f2f0f7 20%, transparent 100%); }
.sv-fade-right { right: 0; background: linear-gradient(to left,  #f2f0f7 20%, transparent 100%); }

/* 통계 */
.sv-stats {
  display: inline-flex;
  align-items: center;
  gap: 28px;
  background: rgba(255,255,255,0.8);
  border: 1px solid rgba(108,99,255,0.15);
  border-radius: 24px;
  padding: 20px 36px;
  flex-wrap: wrap;
  justify-content: center;
  box-shadow: 0 4px 24px rgba(108,99,255,0.1);
}
.sv-stat { text-align: center; }
.sv-stat-num { font-size: 30px; font-weight: 900; line-height: 1; }
.sv-stat-lbl { font-size: 11px; color: rgba(30,20,60,0.5); margin-top: 5px; }
.sv-stat-div { width: 1px; height: 36px; background: rgba(108,99,255,0.15); }

@media(max-width: 640px) {
  .sv-card  { width: 180px; }
  .sv-frame { width: 180px; height: 320px; border-radius: 16px; }
  .sv-fade-left, .sv-fade-right { width: 20px; }
  .sv-stats {
    gap: 0;
    padding: 12px 8px;
    flex-wrap: nowrap;
    width: calc(100% - 32px);
    justify-content: space-between;
  }
  .sv-stat { flex: 1; }
  .sv-stat-num { font-size: 16px; }
  .sv-stat-lbl { font-size: 9px; white-space: nowrap; }
  .sv-stat-div { width: 1px; height: 28px; flex-shrink: 0; }
  .sv-track { gap: 12px; animation-duration: 24s; }
}

/* ===== FAQ 아코디언 ===== */
.faq-category { margin-bottom: 0; }
.faq-category-label {
  font-size: 12px;
  font-weight: 700;
  color: #6c63ff;
  letter-spacing: 1px;
  margin: 20px 0 6px;
  padding-bottom: 6px;
  border-bottom: 1px solid rgba(108,99,255,0.12);
}
.faq-item {
  border-bottom: 1px solid rgba(108,99,255,0.1);
  cursor: pointer;
  background: #fff;
}
.faq-item:last-child { border-bottom: none; }
.faq-item:hover .faq-q { color: #6c63ff; }
.faq-item.open .faq-q { color: #6c63ff; }
.faq-q {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 4px;
  font-size: 15px;
  font-weight: 700;
  color: #1a1040;
  line-height: 1.5;
  gap: 12px;
  transition: color .2s;
}
.faq-icon {
  flex-shrink: 0;
  font-size: 18px;
  color: #6c63ff;
  font-weight: 300;
  transition: transform .25s;
  line-height: 1;
}
.faq-item.open .faq-icon { transform: rotate(45deg); }
.faq-a {
  display: none;
  padding: 0 4px 14px;
  font-size: 14px;
  color: rgba(30,20,60,0.6);
  line-height: 1.75;
}
.faq-item.open .faq-a { display: block; }

@media(max-width: 640px) {
  .faq-q { font-size: 14px; padding: 13px 2px; }
  .faq-a { font-size: 13px; padding: 0 2px 12px; }
  .faq-category-label { font-size: 11px; margin: 16px 0 4px; }
}
</style>
