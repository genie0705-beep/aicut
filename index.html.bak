    how_step3:'剪辑',how_step4:'审核·修改',how_step5:'交付',
    reviews_h:'AICUT客户满意度',reviews_sub2:'真实用户评价 · 月定期编辑合作伙伴',
    footer_cta_title:'立即开始使用AICUT',
    footer_cta_sub:'无需招聘，通过月定期合同运营专属团队。',
    footer_cta_btn:'申请咨询 →',
    modal_login_title:'登录',modal_login_sub:'登录您的账户',
    tab_login:'登录',tab_register:'注册',
    field_email:'电子邮件',field_password:'密码',field_name:'姓名',
    field_pw_req:'密码（8位以上）',field_pw_confirm:'确认密码',
    btn_login:'登录',btn_register:'免费开始 →',
    forgot_q:'忘记密码了？',forgot_link:'通过邮件重置',
    no_account:'没有账户？',free_signup:'免费注册',
    b2b_title:'B2B 免费咨询',b2b_sub:'为企业提供定制化视频剪辑解决方案',
    b2b_company:'公司名称',b2b_manager:'负责人',b2b_phone:'联系电话',
    b2b_volume:'月均剪辑数量',b2b_desc_label:'视频类型及需求说明',
    b2b_country:'国家',b2b_submit:'申请咨询',
    doc_title:'AICUT — 企业·品牌专属月定期视频剪辑合作伙伴',
  }
};

var _currentLang = 'ko';
var _langMeta = {
  ko: { flag: '🇰🇷', code: 'KO', html: 'ko', url: '' },
  en: { flag: '🇺🇸', code: 'EN', html: 'en', url: 'en' },
  ja: { flag: '🇯🇵', code: 'JA', html: 'ja', url: 'ja' },
  zh: { flag: '🇨🇳', code: 'ZH', html: 'zh', url: 'zh' },
};

function setLanguage(lang) {
  if (!AICUT_I18N[lang]) return;
  _currentLang = lang;
  var t = AICUT_I18N[lang];
  var meta = _langMeta[lang];

  // 1. HTML lang 속성 변경
  document.documentElement.lang = meta.html;

  // 2. 문서 제목 변경
  if (t.doc_title) document.title = t.doc_title;

  // 3. data-i18n 텍스트 노드 교체
  document.querySelectorAll('[data-i18n]').forEach(function(el) {
    var key = el.getAttribute('data-i18n');
    if (t[key] !== undefined) el.textContent = t[key];
  });

  // 4. data-i18n-html innerHTML 교체 (HTML 포함 텍스트)
  document.querySelectorAll('[data-i18n-html]').forEach(function(el) {
    var key = el.getAttribute('data-i18n-html');
    if (t[key] !== undefined) el.innerHTML = t[key];
  });

  // 5. 버튼 라벨 업데이트
  var labelMap = { ko:'한국어', en:'English', ja:'日本語', zh:'中文' };
  var labelEl = document.getElementById('langLabel');
  if (labelEl) labelEl.textContent = labelMap[lang] || lang.toUpperCase();

  // 6. 언어 메뉴 active 표시
  document.querySelectorAll('#langMenu button').forEach(function(btn) {
    var isActive = btn.getAttribute('onclick') === "setLanguage('" + lang + "')";
    btn.classList.toggle('active', isActive);
  });

  // 7. URL 히스토리 업데이트 (aicut.co.kr/en 방식)
  try {
    var base = window.location.origin + window.location.pathname.replace(/\/(en|ja|zh)\/?$/, '');
    var newPath = meta.url ? base.replace(/\/$/, '') + '/' + meta.url : base;
    history.replaceState({lang: lang}, '', newPath);
  } catch(e) {}

  // 8. 추가 하드코딩 텍스트 다국어 처리
  var extras = {
    ko: {
      pain_why: '이런 상황이라면',
      pain_intro: '영상 담당 인력 없이도<br>매월 꾸준히 업로드할 수 있습니다',
      process_step_label: '정기 편집 5단계',
      reviews_sub: '실제 이용 고객 후기 · 월 정기 편집 파트너',
      stat_renew: '고객사가 재계약하는 이유',
    },
    en: {
      pain_why: 'If you relate to any of these',
      pain_intro: 'Even without a dedicated video team,<br>you can upload consistently every month',
      process_step_label: '5-Step Monthly Editing',
      reviews_sub: 'Real client reviews · Monthly editing partner',
      stat_renew: 'Why clients renew with AICUT',
    },
    ja: {
      pain_why: 'こんな状況ならAICUT',
      pain_intro: '専任の映像担当者がいなくても<br>毎月コンスタントに投稿できます',
      process_step_label: '定期編集 5ステップ',
      reviews_sub: '実際の利用者レビュー · 月定期編集パートナー',
      stat_renew: 'お客様が再契約する理由',
    },
    zh: {
      pain_why: '如果您有以下烦恼',
      pain_intro: '即使没有专属视频负责人<br>每月也能稳定发布内容',
      process_step_label: '定期编辑 5步骤',
      reviews_sub: '真实客户评价 · 月度定期编辑合作',
      stat_renew: '客户续约的理由',
    }
  };
  var ex = extras[lang] || extras.ko;
  // pain why
  document.querySelectorAll('.pain-why-label, [data-extra="pain_why"]').forEach(function(el){ el.innerHTML = ex.pain_why; });
  // reviews sub
  var revSub = document.querySelector('[data-i18n="reviews_sub2"]');
  if (revSub && ex.reviews_sub) revSub.textContent = ex.reviews_sub;

  // 8. localStorage 저장 (사용자가 직접 선택한 경우 manual 플래그 설정)
  try {
    localStorage.setItem('aicut_lang', lang);
    // _fromInit가 true면 자동 감지로 설정된 것 → manual = false
    if (!setLanguage._fromInit) {
      localStorage.setItem('aicut_lang_manual', 'true');
    }
  } catch(e) {}

  // 9. placeholder 다국어 적용
  var ph = {
    ko: { email:'email@example.com', pw:'비밀번호 입력', name:'홍길동', pw2:'비밀번호 재입력', company:'회사명', manager:'홍길동', phone:'010-0000-0000', desc:'요구사항을 입력해주세요' },
    en: { email:'email@example.com', pw:'Enter password', name:'John Smith', pw2:'Re-enter password', company:'Company Inc.', manager:'John Smith', phone:'+1-000-000-0000', desc:'Describe your requirements' },
    ja: { email:'email@example.com', pw:'パスワードを入力', name:'山田太郎', pw2:'パスワード再入力', company:'株式会社○○', manager:'山田太郎', phone:'000-0000-0000', desc:'ご要望を入力してください' },
    zh: { email:'email@example.com', pw:'请输入密码', name:'张三', pw2:'再次输入密码', company:'某某公司', manager:'张三', phone:'000-0000-0000', desc:'请输入您的需求' },
  };
  var p = ph[lang] || ph.ko;
  var setph = function(id, v) { var el = document.getElementById(id); if (el) el.placeholder = v; };
  setph('loginEmail', p.email); setph('loginPw', p.pw);
  setph('regName', p.name); setph('regEmail', p.email);
  setph('regPw', p.pw); setph('regPw2', p.pw2);
  setph('b2bCompany', p.company); setph('b2bManager', p.manager);
  setph('b2bPhone', p.phone); setph('b2bDesc', p.desc);

  // 10. 메뉴 닫기
  closeLangMenu();
}

function toggleLangMenu() {
  var menu = document.getElementById('langMenu');
  if (menu) menu.classList.toggle('open');
}
function closeLangMenu() {
  var menu = document.getElementById('langMenu');
  if (menu) menu.classList.remove('open');
}

// 외부 클릭 시 메뉴 닫기
document.addEventListener('click', function(e) {
  var switcher = document.getElementById('langSwitcher');
  if (switcher && !switcher.contains(e.target)) closeLangMenu();
});

// ═══════════════════════════════════════
// 초기 언어 감지
// 우선순위: URL파라미터 > 수동선택(manual) > 브라우저언어 > 기본(ko)
// ═══════════════════════════════════════
(function initLang() {
  var langMap = { ko:'ko', en:'en', ja:'ja', zh:'zh',
                  'zh-CN':'zh', 'zh-TW':'zh', 'zh-HK':'zh' };

  // 1. URL 경로에서 언어 감지 (/en /ja /zh)
  var path = window.location.pathname;
  var urlPathLang = (path.match(/\/(en|ja|zh)(?:\/|$)/) || [])[1] || null;

  // 2. URL 쿼리 파라미터 (?lang=en)
  var urlParamLang = null;
  try {
    urlParamLang = new URLSearchParams(window.location.search).get('lang');
    if (urlParamLang && !langMap[urlParamLang]) urlParamLang = null;
  } catch(e) {}

  var urlLang = urlPathLang || urlParamLang;

  // 3. localStorage 읽기
  var savedLang = null, isManual = false;
  try {
    var manualFlag = localStorage.getItem('aicut_lang_manual');
    // 마이그레이션: aicut_lang_manual 키가 없으면 기존 저장값 무시
    if (manualFlag === null) {
      localStorage.removeItem('aicut_lang');
      localStorage.setItem('aicut_lang_manual', 'false');
    } else if (manualFlag === 'true') {
      savedLang = localStorage.getItem('aicut_lang');
      isManual = true;
    }
  } catch(e) {}

  // 4. 브라우저 언어 감지
  var browserRaw = (navigator.language || navigator.userLanguage || 'ko').toLowerCase();
  var browserShort = browserRaw.slice(0, 2);
  var browserLang = langMap[browserRaw] || langMap[browserShort] || 'en';

  // 5. 최종 언어 결정
  var detected;
  if (urlLang) {
    // URL 명시 → 최우선 (manual로 간주)
    detected = urlLang;
    try { localStorage.setItem('aicut_lang_manual', 'true'); } catch(e) {}
  } else if (isManual && savedLang && langMap[savedLang]) {
    // 사용자가 직접 선택한 경우 → 저장값 유지
    detected = savedLang;
  } else {
    // 자동 감지 → 브라우저 언어
    detected = browserLang;
  }

  // 6. ko가 아니면 적용 (ko는 기본값이므로 변경 불필요)
  if (detected && detected !== 'ko') {
    setLanguage._fromInit = true;
    setTimeout(function() {
      setLanguage(detected);
      setLanguage._fromInit = false;
    }, 100);
  }
})();


(function(){
var GUIDE_STEPS = [
  {
    emoji:'📤',
    title:'영상 편집을 의뢰해보세요',
    desc:'요금제를 선택하고 원본 파일과\n요구사항을 입력하면 의뢰 완료!',
    targetId:'sb-guide-new',
    tail:'right',
  },
  {
    emoji:'📊',
    title:'진행 상황을 실시간으로 확인해요',
    desc:'결제대기 → 소스대기 → 편집중\n→ 검수중 → 납품완료\n단계별로 진행 상황을 알려드려요',
    targetId:'clientStepProgressV2',
    tail:'bottom',
  },
  {
    emoji:'✅',
    title:'각 단계마다 할 일을 알려드려요',
    desc:'소스 업로드, 검수 피드백 등\n해야 할 액션을 바로 안내해드려요',
    targetId:'clientActionBox',
    tail:'bottom',
  },
  {
    emoji:'💬',
    title:'궁금한 건 바로 물어보세요',
    desc:'채팅으로 문의하시면\n담당 매니저가 빠르게 답변드려요',
    targetId:'sb-guide-chat',
    tail:'right',
  },
];

var _guideStep = 0;

window.startClientGuide = function(force) {
  if (!force && localStorage.getItem('aicut_guide_done') === 'true') return;
  _guideStep = 0;
  document.getElementById('guideOverlay').style.display = 'block';
  document.getElementById('guidePopup').style.display = 'block';
  renderGuideStep();
};

window.guideNext = function() {
  _guideStep++;
  if (_guideStep >= GUIDE_STEPS.length) {
    finishGuide();
  } else {
    renderGuideStep();
  }
};

window.dismissGuide = function() {
  finishGuide();
};

function finishGuide() {
  try { localStorage.setItem('aicut_guide_done','true'); } catch(e){}
  document.getElementById('guideOverlay').style.display = 'none';
  document.getElementById('guidePopup').style.display = 'none';
  clearSpot();
}

function clearSpot() {
  setSpot(0,0,0,0);
}

function setSpot(x,y,w,h) {
  var r = document.getElementById('spotRect');
  var b = document.getElementById('guideSpotBorder');
  if (!r || !b) return;
  var pad = 6;
  r.setAttribute('x', x-pad); r.setAttribute('y', y-pad);
  r.setAttribute('width', w+pad*2); r.setAttribute('height', h+pad*2);
  b.style.left   = (x-pad)+'px'; b.style.top    = (y-pad)+'px';
  b.style.width  = (w+pad*2)+'px'; b.style.height = (h+pad*2)+'px';
}

function renderGuideStep() {
  var s = GUIDE_STEPS[_guideStep];
  if (!s) return;

  // 타겟 요소 위치
  var tgt = document.getElementById(s.targetId);
  var rect = tgt ? tgt.getBoundingClientRect() : null;

  // 텍스트
  document.getElementById('guideEmoji').textContent = s.emoji;
  document.getElementById('guideTitle').textContent = s.title;
  document.getElementById('guideDesc').textContent  = s.desc;
  document.getElementById('guideStep').textContent  = (_guideStep+1)+' / '+GUIDE_STEPS.length;
  var btn = document.getElementById('guideNextBtn');
  if (_guideStep === GUIDE_STEPS.length-1) {
    btn.innerHTML = '완료 ✓';
  } else {
    btn.innerHTML = '다음 <span style="font-size:16px">→</span>';
  }

  // spotlight
  if (rect && rect.width > 0) {
    setSpot(rect.left + window.scrollX, rect.top + window.scrollY, rect.width, rect.height);
  } else {
    clearSpot();
  }

  // 팝업 위치 계산
  positionPopup(rect, s.tail);
}

function positionPopup(rect, tail) {
  var popup  = document.getElementById('guidePopup');
  var tailT  = document.getElementById('guideTailTop');
  var tailB  = document.getElementById('guideTailBot');
  var isMob  = window.innerWidth <= 640;

  if (isMob) {
    // 모바일: 하단 고정 (CSS에서 처리)
    popup.style.top = ''; popup.style.left = '';
    tailT.style.display = 'none';
    tailB.style.display = 'none';
    return;
  }

  tailT.style.display = 'none';
  tailB.style.display = 'none';

  if (!rect || rect.width === 0) {
    // 타겟 없음: 중앙 하단
    popup.style.top  = '50%';
    popup.style.left = '50%';
    popup.style.transform = 'translate(-50%,-50%)';
    return;
  }

  popup.style.transform = '';
  var pad = 14;
  var popW = 320;

  if (tail === 'right') {
    // 팝업: 타겟 오른쪽
    var leftPos = rect.right + pad + window.scrollX;
    var topPos  = rect.top  + window.scrollY;
    popup.style.left = leftPos + 'px';
    popup.style.top  = topPos  + 'px';
    tailT.style.display = 'none'; tailB.style.display = 'none';
    // 꼬리 대신 간격
  } else {
    // 팝업: 타겟 아래
    var leftPos2 = Math.max(16, rect.left + window.scrollX);
    var topPos2  = rect.bottom + pad + window.scrollY;
    popup.style.left = leftPos2 + 'px';
    popup.style.top  = topPos2  + 'px';
    tailT.style.display = 'block';
    tailT.style.marginLeft = '24px';
    tailB.style.display = 'none';
  }

  // 화면 밖 방지
  var maxLeft = window.innerWidth - popW - 16 + window.scrollX;
  if (parseFloat(popup.style.left) > maxLeft) {
    popup.style.left = maxLeft + 'px';
  }
}

// 초기 실행 — 고객 로그인 후 500ms 뒤
window._startGuideIfNeeded = function() {
  setTimeout(function() {
    // 고객 페이지가 표시 중일 때만
    var pg = document.getElementById('page-client');
    if (pg && (pg.style.display === 'flex' || pg.style.display === 'block')) {
      startClientGuide(false);
    }
  }, 800);
};

// 리사이즈 시 재포지셔닝
window.addEventListener('resize', function() {
  if (document.getElementById('guidePopup').style.display !== 'none') {
    renderGuideStep();
  }
});
})();


// ── 공통 레퍼런스 스타일 단계 렌더러 ──
window._renderRefSteps = function(status, opts) {
  opts = opts || {};
  var showDesc = opts.showDesc || false;
  var deadline = opts.deadline || '';

  var STEPS = [
    { key:'payment_pending', label:'결제대기', desc:'입금 후 확인해주세요' },
    { key:'pending',         label:'소스대기', desc:'원본 파일을 올려주세요!' },
    { key:'editing',         label:'편집중',   desc:'에디터가 열심히 작업 중이에요!' },
    { key:'review',          label:'검수중',   desc:'완성본을 확인해주세요' },
    { key:'done',            label:'납품완료', desc:'납품이 완료됐어요! 🎉' },
  ];
  var SVGS = {
    payment_pending:'<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>',
    pending:'<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>',
    editing:'<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>',
    review:'<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>',
    done:'<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>',
  };

  var stepI = { payment_pending:0, pending:1, waiting:1, editing:2, review:3, done:4 };
  var cur   = stepI[status] !== undefined ? stepI[status] : 0;
  var PCT   = { payment_pending:20, pending:40, waiting:40, editing:60, review:80, done:100 };
  var pct   = PCT[status] || 20;

  // D-DAY
  var ddayHtml = '';
  if (deadline) {
    var t = new Date(); t.setHours(0,0,0,0);
    var d2 = new Date(deadline); d2.setHours(0,0,0,0);
    var diff = Math.round((d2 - t) / 86400000);
    var dc = diff > 2 ? 'safe' : (diff >= 0 ? 'warn' : 'over');
    var dt = diff > 0 ? 'D-'+diff : (diff === 0 ? '오늘' : '지연');
    ddayHtml = '<span class="rst-dday ' + dc + '">' + dt + '</span>';
  }

  // 아이콘 + 화살표 행
  var row = STEPS.map(function(s, i) {
    var isDone   = i < cur;
    var isActive = i === cur;
    var cls = isDone ? 'rst-done' : (isActive ? 'rst-active' : 'rst-wait');
    var desc = (showDesc && isActive)
      ? '<div class="rst-desc">' + s.desc + '</div>' : '';
    var arrow = i < STEPS.length - 1
      ? '<div class="rst-arrow ' + (i < cur ? 'done' : '') + '">›</div>' : '';
    return '<div class="rst-step ' + cls + '">' +
        '<div class="rst-icon" data-key="' + s.key + '">' + (SVGS[s.key]||'') + '</div>' +
        '<div class="rst-lbl">' + s.label + '</div>' +
        desc +
      '</div>' + arrow;
  }).join('');

  return '<div class="rst-wrap">' +
    '<div class="rst-row">' + row + '</div>' +
    '<div class="rst-bar-wrap">' +
      ddayHtml +
      '<div class="rst-bar"><div class="rst-fill" style="width:' + pct + '%"></div></div>' +
    '</div>' +
  '</div>';
};


// ===== 숏폼 갤러리 초기화 =====
document.addEventListener('DOMContentLoaded', function() {

  // Firebase DB 준비 완료 후 프로모션 영상 로드
  function _waitAndLoad(retry) {
    retry = retry || 0;
    if (retry > 20) return; // 최대 10초 대기
    if (window._db && typeof window.loadMainPromoVideos === 'function') {
      window.loadMainPromoVideos();
    } else {
      setTimeout(function() { _waitAndLoad(retry + 1); }, 500);
    }
  }
  _waitAndLoad();

  // 터치 시 롤링 일시정지
  var track = document.getElementById('shortsTrack');
  if (track) {
    track.addEventListener('touchstart', function() {
      track.style.animationPlayState = 'paused';
    }, {passive: true});
    track.addEventListener('touchend', function() {
      setTimeout(function() { track.style.animationPlayState = 'running'; }, 2000);
    });
  }
});


// ===== FAQ 아코디언 =====
window.toggleFaq = function(el) {
  var isOpen = el.classList.contains('open');
  // 같은 카테고리 내 다른 항목 닫기
  var siblings = el.parentNode.querySelectorAll('.faq-item');
  siblings.forEach(function(s) { s.classList.remove('open'); });
  // 클릭한 항목 토글
  if (!isOpen) el.classList.add('open');
};

  </script>
</body>
</html>