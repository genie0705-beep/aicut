            <div style="position:absolute;inset:0;background:linear-gradient(to right,rgba(253,244,255,0.6) 0%,transparent 45%)"></div>
            <div style="position:absolute;bottom:20px;left:20px;background:white;border-radius:12px;padding:12px 16px;box-shadow:0 8px 24px rgba(0,0,0,0.12);width:210px">
