document.addEventListener('DOMContentLoaded', function() {
  // 매출 차트는 어드민 탭 열릴 때 초기화
  const revenueTab = document.getElementById('tab-a-revenue');
  if (revenueTab) {
    const observer = new MutationObserver(() => {
      if (revenueTab.style.display !== 'none') {
        initRevenueCharts();
        observer.disconnect();
      }
    });
    observer.observe(revenueTab, { attributes: true, attributeFilter: ['style'] });
  }
});


// ===== 비밀번호 강도 표시기 =====
function checkPwStrength(pw) {
  var bar = document.getElementById('pwStrengthBar');
  var fill = document.getElementById('pwStrengthFill');
  var text = document.getElementById('pwStrengthText');
  if (!bar || !fill || !text) return;
  if (!pw) { bar.style.display = 'none'; return; }
  bar.style.display = 'block';
  var score = 0;
  if (pw.length >= 8) score++;
  if (pw.length >= 12) score++;
  if (/[A-Z]/.test(pw)) score++;
  if (/[0-9]/.test(pw)) score++;
  if (/[^A-Za-z0-9]/.test(pw)) score++;
  var levels = [
    { pct:'20%', color:'#ef4444', label:'매우 약함' },
    { pct:'40%', color:'#f97316', label:'약함' },
    { pct:'60%', color:'#eab308', label:'보통' },
    { pct:'80%', color:'#22c55e', label:'강함' },
    { pct:'100%', color:'#16a34a', label:'매우 강함 ✓' }
  ];
  var lv = levels[Math.min(score - 1, 4)] || levels[0];
  fill.style.width = lv.pct;
  fill.style.background = lv.color;
  text.textContent = lv.label;
  text.style.color = lv.color;
}

// ===== 유튜브 URL 썸네일 미리보기 =====
function previewYouTube(url) {
  var wrap = document.getElementById('ytPreviewWrap');
  var img  = document.getElementById('ytPreviewImg');
  if (!wrap || !img || !url) { if(wrap) wrap.style.display='none'; return; }
  var vid = '';
  var m1 = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([A-Za-z0-9_-]{11})/);
  var m2 = url.match(/youtube\.com\/shorts\/([A-Za-z0-9_-]{11})/);
  if (m1) vid = m1[1];
  else if (m2) vid = m2[1];
  if (!vid) { wrap.style.display = 'none'; return; }
  img.src = 'https://img.youtube.com/vi/' + vid + '/hqdefault.jpg';
  img.onerror = function() { wrap.style.display = 'none'; };
  img.onload  = function() { wrap.style.display = 'block'; };
}

// ===== 수정 요청 임시저장 =====
function saveTempRevision() {
  var points = [];
  document.querySelectorAll('.rev-point-input').forEach(function(el) {
    if (el.value.trim()) points.push(el.value.trim());
  });
  var session = getSession();
  var key = 'aicut_temp_revision_' + (session ? session.email : 'guest');
  localStorage.setItem(key, JSON.stringify({ points: points, time: Date.now() }));
  showToast('✅ 임시저장 완료 — 다음에 접속해도 내용이 유지됩니다');
}

// ===== 어드민 B2B 계약 등록 =====
function registerAdminB2B() {
  var company = (document.getElementById('adminB2bCompany') || {}).value || '';
  var manager = (document.getElementById('adminB2bManager') || {}).value || '';
  var volume  = (document.getElementById('adminB2bVolume')  || {}).value || '';
  var price   = (document.getElementById('adminB2bPrice')   || {}).value || '';
  var start   = (document.getElementById('adminB2bStart')   || {}).value || '';
  var end     = (document.getElementById('adminB2bEnd')     || {}).value || '';
  var note    = (document.getElementById('adminB2bNote')    || {}).value || '';
  var btn     = document.getElementById('adminB2bBtn');

  if (!company.trim()) { showToast('⚠️ 기업명을 입력해주세요'); return; }
  if (!manager.trim()) { showToast('⚠️ 담당자를 입력해주세요'); return; }

  if (btn) { btn.disabled = true; btn.textContent = '등록 중...'; }

  // localStorage에 저장
  var state = getAdminState();
  if (!state.b2bContracts) state.b2bContracts = [];
  var contract = {
    id: 'B2B-' + Date.now(),
    company: company, manager: manager,
    volume: volume, price: price,
    start: start, end: end, note: note,
    status: '계약중', createdAt: new Date().toISOString()
  };
  state.b2bContracts.push(contract);
  saveAdminState(state);

  // 이메일로도 알림 발송
  var subject = encodeURIComponent('[AICUT] B2B 계약 등록: ' + company);
  var body = encodeURIComponent(
    'B2B 계약이 등록되었습니다.\n\n' +
    '기업명: ' + company + '\n' +
    '담당자: ' + manager + '\n' +
    '월 건수: ' + volume + '건\n' +
    '단가: ' + parseInt(price||0).toLocaleString() + '원/건\n' +
    '계약기간: ' + (start||'-') + ' ~ ' + (end||'-') + '\n' +
    '비고: ' + note
  );
  var _em='master'+'@'+'aicut.co.kr'; window.open('mailto:'+_em+'?subject=' + subject + '&body=' + body);

  showToast('✅ B2B 계약이 등록되었습니다');
  if (btn) { btn.disabled = false; btn.textContent = '계약 등록'; }

  // 폼 초기화
  ['adminB2bCompany','adminB2bManager','adminB2bVolume','adminB2bPrice','adminB2bStart','adminB2bEnd','adminB2bNote'].forEach(function(id) {
    var el = document.getElementById(id); if (el) el.value = '';
  });
}

// ===== 세션 만료 안내 =====
(function checkSessionExpiry() {
  var s = null;
  try { s = JSON.parse(localStorage.getItem('aicut_session')); } catch(e) {}
  if (s && s.expireAt && Date.now() > s.expireAt) {
    localStorage.removeItem('aicut_session');
    showToast('⏰ 보안을 위해 자동 로그아웃 되었습니다. 다시 로그인해주세요');
  }
})();



(function() {
  /* ── 1. 스크롤 reveal ── */
  const revealObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        revealObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.12 });
  function initReveal() {
    document.querySelectorAll('.reveal').forEach(el => revealObs.observe(el));
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initReveal);
  } else { initReveal(); }

  /* ── 2. Nav 스크롤 전환 ── */
  var nav = document.getElementById('mainNav');
  function updateNav() {
    if (!nav) return;
    var page = document.getElementById('page-home');
    var isHome = page && (page.style.display !== 'none');
    if (!isHome) { nav.classList.remove('nav-top','nav-scrolled'); return; }
    if (window.scrollY < 80) {
      nav.classList.add('nav-top');
      nav.classList.remove('nav-scrolled');
    } else {
      nav.classList.remove('nav-top');
      nav.classList.add('nav-scrolled');
    }
  }
  window.addEventListener('scroll', updateNav, { passive: true });
  document.addEventListener('DOMContentLoaded', updateNav);
  window.addEventListener('DOMContentLoaded', function() { setTimeout(updateNav, 100); });

  /* ── 3. 플로팅 CTA ── */
  var fcta = document.getElementById('floatingCta');
  var fcHidden = sessionStorage.getItem('fcHidden');
  function updateFcta() {
    if (!fcta || fcHidden) return;
    var page = document.getElementById('page-home');
    var isHome = page && (page.style.display !== 'none');
    if (isHome && window.scrollY > 350) {
      fcta.classList.add('show');
    } else {
      fcta.classList.remove('show');
    }
  }
  window.addEventListener('scroll', updateFcta, { passive: true });

  /* ── 4. 소셜 프루프 토스트 ── */
  var proofs = [
    { init:'A', text:'<strong>A 마케팅사</strong> 상담 신청 완료', time:'방금 전' },
    { init:'B', text:'<strong>B 이커머스</strong> 정기 계약 완료', time:'4분 전' },
    { init:'C', text:'<strong>C 에듀기업</strong> 견적 문의 완료', time:'8분 전' },
    { init:'D', text:'<strong>D 미디어사</strong> STANDARD 계약 완료', time:'13분 전' },
    { init:'E', text:'<strong>E 스타트업</strong> 도입 상담 완료', time:'19분 전' },
    { init:'F', text:'<strong>F 병원</strong> 월 정기 계약 완료', time:'24분 전' },
  ];
  var spEl = document.getElementById('socialProof');
  var spIdx = 0;
  function showProof() {
    if (!spEl) return;
    var p = proofs[spIdx % proofs.length];
    document.getElementById('spAvatar').textContent = p.init;
    document.getElementById('spText').innerHTML = p.text;
    document.getElementById('spTime').textContent = p.time;
    spEl.classList.add('show');
    setTimeout(function(){ spEl.classList.remove('show'); }, 5000);
    spIdx++;
  }
  setTimeout(function(){
    showProof();
    setInterval(showProof, 55000);
  }, 20000);
})();


(function(){
  var w=window;
  if(w.ChannelIO){return;}
  var ch=function(){ch.c(arguments);};
  ch.q=[];
  ch.c=function(args){ch.q.push(args);};
  w.ChannelIO=ch;
  function l(){
    if(w.ChannelIOInitialized){return;}
    w.ChannelIOInitialized=true;
    var s=document.createElement('script');
    s.type='text/javascript';
    s.async=true;
    s.src='https://cdn.channel.io/plugin/ch-plugin-web.js';
    var x=document.getElementsByTagName('script')[0];
    x.parentNode.insertBefore(s,x);
  }
  if(document.readyState==='complete'){l();}
  else{w.addEventListener('DOMContentLoaded',l);
  w.addEventListener('load',l);}
})();

ChannelIO('boot', {
  pluginKey: '8c28ff86-be65-4b48-b7d5-d839d2e03495',
  hideChannelButtonOnBoot: true
});

// 로그인 사용자 식별
window._channelIOLogin = function(name, email) {
  if (typeof ChannelIO === 'undefined') return;
  ChannelIO('updateUser', {
    profile: { name: name, email: email }
  });
};

// 로그아웃 시 초기화
window._channelIOLogout = function() {
  if (typeof ChannelIO === 'undefined') return;
  ChannelIO('resetUser');
};

// 수동 열기
function openChannelTalk() {
  if (typeof ChannelIO !== 'undefined') {
    ChannelIO('showMessenger');
  } else {
    if(typeof showToast==='function') showToast('채널톡을 불러오는 중입니다. 잠시 후 다시 시도해주세요');
  }
}


