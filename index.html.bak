window.toggleAdminMobileMenu = function() {
  var menu = document.getElementById('adminMobileMenu');
  if (!menu) return;
  if (menu.style.display === 'none' || !menu.style.display) {
    menu.style.display = 'block';
    document.body.style.overflow = 'hidden';
    var btn = document.getElementById('adminMoreBtn');
    if (btn) btn.classList.add('active');
  } else {
    window.closeAdminMobileMenu();
  }
};

window.closeAdminMobileMenu = function() {
  var menu = document.getElementById('adminMobileMenu');
  if (menu) menu.style.display = 'none';
  document.body.style.overflow = '';
  var btn = document.getElementById('adminMoreBtn');
  if (btn) btn.classList.remove('active');
};

function toggleAdminForm() {
  const form = document.getElementById('adminRegForm');
  form.style.display = form.style.display === 'none' ? 'block' : 'none';
}

function registerAdmin() {
  const name = document.getElementById('newAdminName').value.trim();
  const email = document.getElementById('newAdminEmail').value.trim();
  const role = document.getElementById('newAdminRole').value;
  const dept = document.getElementById('newAdminDept').value;
  const pw = document.getElementById('newAdminPw').value;

  if (!name) { showToast('⚠️ 이름을 입력해주세요'); return; }
  if (!email || !email.includes('@')) { showToast('⚠️ 올바른 이메일을 입력해주세요'); return; }
  if (pw.length < 8) { showToast('⚠️ 비밀번호는 8자 이상이어야 합니다'); return; }

  const table = document.getElementById('adminTable');
  const badge = role === 'master'
    ? `<span class="badge" style="background:var(--accent-light);color:var(--accent);font-weight:700">👑 마스터</span>`
    : `<span class="badge" style="background:var(--gray-100);color:var(--gray-600);font-weight:700">🛠 운영 담당자</span>`;
  const tr = document.createElement('tr');
  tr.setAttribute('data-role', role);
  tr.innerHTML = `
    <td><div style="font-weight:700">${name}</div></td>
    <td style="font-size:13px;color:var(--gray-400)">${email}</td>
    <td>${badge}</td>
    <td style="font-size:13px;color:var(--gray-400)">${dept}</td>
    <td style="font-size:13px;color:var(--gray-400)">미접속</td>
    <td><span class="badge badge-review">활성</span></td>
    <td style="display:flex;gap:6px">
      <button class="btn btn-outline" style="padding:5px 10px;font-size:11px" onclick="showToast('권한이 수정되었습니다')">수정</button>
      <button class="btn btn-outline" style="padding:5px 10px;font-size:11px;color:var(--red);border-color:var(--red)" onclick="adminToggleAccount('ops@aicut.kr','deactivate')">비활성화</button>
    </td>`;
  table.appendChild(tr);

  // 폼 초기화
  ['newAdminName','newAdminEmail','newAdminPhone','newAdminPw'].forEach(id => document.getElementById(id).value = '');
  document.getElementById('newAdminRole').value = 'operator';
  document.getElementById('adminRegForm').style.display = 'none';
  showToast(`✅ ${name} 관리자가 등록되었습니다. 초대 이메일을 발송했습니다.`);
}

function filterAdmins(role) {
  document.querySelectorAll('#adminTable tr[data-role]').forEach(tr => {
    tr.style.display = (role === 'all' || tr.dataset.role === role) ? '' : 'none';
  });
}

// ===== HERO SLIDESHOW =====
let _heroIdx = 0;
const _heroTotal = 3;
let _heroTimer = null;

window.goSlide = function goSlide(n) {
  const slides = document.querySelectorAll('.hero-slide');
  const dots = document.querySelectorAll('.hero-dot');
  const total = dots.length; // 인디케이터 개수 기준
  if (slides[_heroIdx]) slides[_heroIdx].classList.remove('active');
  if (dots[_heroIdx]) dots[_heroIdx].classList.remove('active');
  _heroIdx = ((n % total) + total) % total;
  if (slides[_heroIdx]) slides[_heroIdx].classList.add('active');
  if (dots[_heroIdx]) dots[_heroIdx].classList.add('active');
  // 영상 전환 (PC)
  const video = document.getElementById('heroBgVideo');
  if (video && video.style.display !== 'none') {
    playHeroVideo(_heroIdx);
  }
}

function nextSlide() {
  goSlide((_heroIdx + 1) % _heroTotal);
}

function startHeroSlider() {
  const video = document.getElementById('heroBgVideo');
  // 영상이 재생 가능한 상태면 타이머 슬라이드 사용 안 함
  // 영상 ended 이벤트에서 자동 전환 처리
  if (video && video.src) return;
  // 영상 없을 때만 타이머 슬라이드 사용
  _heroTimer = setInterval(nextSlide, 5000);
  const hero = document.querySelector('.hero');
  if (hero) {
    hero.addEventListener('mouseenter', () => clearInterval(_heroTimer));
    hero.addEventListener('mouseleave', () => { _heroTimer = setInterval(nextSlide, 5000); });
  }
}

document.addEventListener('DOMContentLoaded', startHeroSlider);

