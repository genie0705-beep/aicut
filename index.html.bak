function fcUserMsg(text) {
  const msgs = document.getElementById('fcMessages');
  const now = new Date();
  const time = `${now.getHours()}:${String(now.getMinutes()).padStart(2,'0')}`;
  const div = document.createElement('div');
  div.className = 'fc-msg me';
  div.innerHTML = `<div class="fc-msg-av">👤</div><div><div class="fc-bubble">${text.replace(/\n/g,'<br>')}</div><div class="fc-time" style="text-align:right">${time}</div></div>`;
  msgs.appendChild(div);
  msgs.scrollTop = msgs.scrollHeight;
}

function fcBotMsg(text) {
  const msgs = document.getElementById('fcMessages');
  const now = new Date();
  const time = `${now.getHours()}:${String(now.getMinutes()).padStart(2,'0')}`;
  const div = document.createElement('div');
  div.className = 'fc-msg';
  div.innerHTML = `<div class="fc-msg-av">✂️</div><div><div class="fc-bubble">${text.replace(/\n/g,'<br>')}</div><div class="fc-time">${time}</div></div>`;
  msgs.appendChild(div);
  msgs.scrollTop = msgs.scrollHeight;
}

function fcTyping(cb) {
  const msgs = document.getElementById('fcMessages');
  const typing = document.createElement('div');
  typing.className = 'fc-msg';
  typing.id = 'fcTyping';
  typing.innerHTML = `<div class="fc-msg-av">✂️</div><div class="fc-typing"><span></span><span></span><span></span></div>`;
  msgs.appendChild(typing);
  msgs.scrollTop = msgs.scrollHeight;
  setTimeout(() => {
    typing.remove();
    cb();
  }, 1000 + Math.random() * 500);
}

