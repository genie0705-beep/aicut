// ===== 구글 드라이브 업로드 워크플로우 =====

// 업로드 탭 진입 시 Firestore에서 실제 주문 로드
window.loadUploadOrders = function loadUploadOrders() {
  if (!window._db) { setTimeout(loadUploadOrders, 500); return; }
  var sel = document.getElementById('uploadOrderSelect');
  if (!sel) return;

  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
    // 진행 중인 주문 (payment_pending 이상) 조회
    // 입금완료(pending/waiting) 이상인 주문만 표시 (payment_pending 제외)
    var q = fs.query(
      fs.collection(window._db, 'orders'),
      fs.where('status', 'in', ['payment_pending','pending','waiting','editing','review'])
    );
    fs.getDocs(q).then(function(snapshot) {
      // 클라이언트 정렬 (createdAt 내림차순)
      var docs = [];
      snapshot.forEach(function(d) { docs.push({ id: d.id, data: d.data() }); });
      docs.sort(function(a, b) {
        var ta = a.data.createdAt && a.data.createdAt.toMillis ? a.data.createdAt.toMillis() : 0;
        var tb = b.data.createdAt && b.data.createdAt.toMillis ? b.data.createdAt.toMillis() : 0;
        return tb - ta;
      });

      // 기존 옵션 제거
      sel.innerHTML = '<option value="">— 주문을 선택해주세요 —</option>';

      var statusLabel = {
        payment_pending: '결제대기', waiting: '소스대기', pending: '소스대기',
        editing: '편집중', review: '검수중', done: '납품완료'
      };

      if (docs.length === 0) {
        sel.innerHTML = '<option value="">진행 중인 주문이 없습니다</option>';
        return;
      }

      docs.forEach(function(item) {
        var o = item.data;
        var oid = o.orderId || item.id;
        var status = statusLabel[o.status] || o.status;
        var label = oid + ' — ' + (o.clientName || '-') + ' · ' + (o.planName || '-') + ' [' + status + ']';
        var opt = document.createElement('option');
        opt.value = item.id; // Firestore 문서 ID 사용
        opt.setAttribute('data-oid', oid);
        opt.textContent = label;
        sel.appendChild(opt);
      });

      console.log('[Upload] 주문 ' + docs.length + '건 로드');
    }).catch(function(e) {
      console.error('[Upload] 주문 조회 실패:', e.code, e.message);
      sel.innerHTML = '<option value="">조회 실패: ' + (e.code || '오류') + '</option>';
    });
  });
};

// Firestore에서 가져온 데이터를 _uploadOrderCache에 저장
window._uploadOrderCache = {};

function updateUploadOrder() {
  var sel = document.getElementById('uploadOrderSelect');
  if (!sel || !sel.value) return;

  var docId = sel.value;
  var selectedOpt = sel.options[sel.selectedIndex];
  var oid = selectedOpt.getAttribute('data-oid') || docId;

  // 캐시 확인
  if (window._uploadOrderCache[docId]) {
    _fillUploadPanel(oid, window._uploadOrderCache[docId]);
    return;
  }

  // Firestore에서 문서 조회
  if (!window._db) return;
  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
    fs.getDoc(fs.doc(window._db, 'orders', docId)).then(function(docSnap) {
      if (!docSnap.exists()) return;
      var o = docSnap.data();
      window._uploadOrderCache[docId] = o;
      _fillUploadPanel(oid, o);
    });
  });
}

function _fillUploadPanel(oid, o) {
  var set = function(id, val) { var el = document.getElementById(id); if (el) el.textContent = val || '—'; };
  var statusLabel = {
    payment_pending: '결제대기', waiting: '소스대기', pending: '소스대기',
    editing: '편집중', review: '검수중', done: '납품완료'
  };
  var clientShort = (o.clientName || '').replace(/\s/g, '');
  var nameShort = (o.title || o.planName || '').replace(/\s/g, '').substring(0, 8);

  set('folderPreview', oid + '_' + clientShort + '_' + nameShort);
  set('uploadOrderNum', '#' + oid);
  set('uploadOrderName', o.title || o.planName || '—');
  set('uploadClientName', o.clientName || '—');
  set('uploadPlan', o.planName || '—');
  set('uploadDeadline', o.deadlineDate || o.deadline || '—');
  set('uploadDesc', o.desc || '요구사항이 입력되지 않았습니다');
  // 레퍼런스 URL
  var uploadRefEl = document.getElementById('uploadRef');
  if (uploadRefEl) {
    if (o.ref && o.ref.startsWith('http')) {
      uploadRefEl.innerHTML = '<a href="' + o.ref + '" target="_blank" style="color:var(--accent);text-decoration:underline;word-break:break-all">' + o.ref + '</a>';
    } else {
      uploadRefEl.textContent = o.ref || '없음';
    }
  }

  // 상태 배지
  var statusEl = document.getElementById('uploadStatus');
  if (statusEl) {
    var badgeMap = {
      payment_pending: ['badge-pending', '💳 결제대기', 'background:#fef3c7;color:#92400e'],
      pending:  ['badge-pending', '📦 소스대기', 'background:#e0f2fe;color:#0369a1'],
      waiting:  ['badge-pending', '📦 소스대기', 'background:#e0f2fe;color:#0369a1'],
      editing:  ['badge-editing',  '편집중', ''],
      review:   ['badge-review',   '검수중', ''],
      done:     ['badge-done',     '납품완료', ''],
    };
    var si = badgeMap[o.status] || ['badge-pending', o.status || '—', ''];
    statusEl.innerHTML = '<span class="badge ' + si[0] + '" style="' + si[2] + '">' + si[1] + '</span>';
  }

  // 이메일 자동 입력
  var emailEl = document.getElementById('clientEmail');
  if (emailEl && !emailEl.value) emailEl.value = o.clientEmail || '';

  // 현재 선택 주문 ID 저장
  window._currentAdminOrderId = oid;

  // 링크 발송 완료 UI 초기화
  var linkSent = document.getElementById('uploadLinkSent');
  var deliveryDone = document.getElementById('deliveryDone');
  if (linkSent) linkSent.style.display = 'none';
  if (deliveryDone) deliveryDone.style.display = 'none';

  // 진행 현황 단계 렌더링 (실제 status 기반)
  var stepsEl = document.getElementById('uploadProgressSteps');
  if (stepsEl) {
    var status = o.status || '';
    var hasDriveLink = !!(o.driveLink || o.uploadFolderUrl);
    var steps = [
      { key: 'payment', label: '입금 확인',
        done: ['pending','waiting','editing','review','done'].includes(status) },
      { key: 'drive',   label: '원본 파일 수신 준비 (드라이브 링크 전달)',
        done: hasDriveLink },
      { key: 'editing', label: '편집 진행 중',
        done: ['editing','review','done'].includes(status),
        active: status === 'editing' },
      { key: 'review',  label: '검수 중',
        done: ['review','done'].includes(status),
        active: status === 'review' },
      { key: 'done',    label: '납품 완료',
        done: status === 'done' },
    ];
    stepsEl.innerHTML = steps.map(function(s) {
      var icon, iconBg, textStyle;
      if (s.done) {
        icon = '✓'; iconBg = '#10b981'; textStyle = 'color:#065f46;font-weight:600';
      } else if (s.active) {
        icon = '→'; iconBg = 'var(--orange)'; textStyle = 'color:var(--orange);font-weight:600';
      } else {
        icon = '○'; iconBg = 'var(--gray-200)'; textStyle = 'color:var(--gray-400)';
      }
      return '<div style="display:flex;align-items:center;gap:10px;font-size:13px' + ((!s.done && !s.active) ? ';opacity:.4' : '') + '">' +
        '<div style="width:20px;height:20px;border-radius:50%;background:' + iconBg + ';color:white;font-size:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0">' + icon + '</div>' +
        '<span style="' + textStyle + '">' + s.label + '</span></div>';
    }).join('');
  }
}

function sendUploadLink() {
  var link    = document.getElementById('driveUploadLink')?.value?.trim();
  var orderId = window._currentAdminOrderId;
  // 드롭다운에서 선택된 Firestore 문서 ID
  var sel     = document.getElementById('uploadOrderSelect');
  var docId   = sel ? sel.value : null;

  if (!link || !link.startsWith('http')) {
    showToast('구글 드라이브 링크를 먼저 입력해주세요'); return;
  }

  // 클립보드 복사
  if (navigator.clipboard) {
    navigator.clipboard.writeText(link).then(function() {
      showToast('✅ 고객 페이지에 링크가 등록되었습니다. 채널톡으로 안내해주세요!');
    }).catch(function() {
      // 폴백: execCommand
      var ta = document.createElement('textarea');
      ta.value = link; document.body.appendChild(ta);
      ta.select(); document.execCommand('copy');
      document.body.removeChild(ta);
      showToast('✅ 고객 페이지에 링크가 등록되었습니다. 채널톡으로 안내해주세요!');
    });
  } else {
    showToast('✅ 고객 페이지에 링크가 등록되었습니다. 채널톡으로 안내해주세요!');
  }

  // Firestore 저장 — 문서 ID(docId)로 직접 접근
  if (window._db) {
    import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
      var saveData = {
        uploadLink:       link,   // 고객 화면에서 참조하는 필드
        driveLink:        link,
        uploadFolderUrl:  link,
        driveLinkSentAt:  fs.serverTimestamp(),
        uploadLinkSentAt: fs.serverTimestamp(),
      };
      var doSave = function(ref) {
        fs.updateDoc(ref, saveData)
          .then(function() { console.log('[Firestore] 드라이브 링크 저장 완료'); })
          .catch(function(e) { console.warn('[Firestore] 링크 저장 실패:', e.code); });
      };
      if (docId) {
        doSave(fs.doc(window._db, 'orders', docId));
      } else if (orderId) {
        fs.getDocs(fs.query(
          fs.collection(window._db, 'orders'),
          fs.where('orderId', '==', orderId), fs.limit(1)
        )).then(function(snap) {
          if (!snap.empty) doSave(snap.docs[0].ref);
        });
      }
    });
  }

  var sent = document.getElementById('uploadLinkSent');
  if (sent) sent.style.display = 'block';
}

function deliverResult() {
  const link = document.getElementById('driveResultLink')?.value;
  if (!link || !link.startsWith('http')) {
    showToast('결과물 구글 드라이브 링크를 먼저 입력해주세요'); return;
  }
  const done = document.getElementById('deliveryDone');
  if (done) done.style.display = 'block';
  showToast('🎉 납품 완료 알림이 의뢰인에게 발송되었습니다!');
}

