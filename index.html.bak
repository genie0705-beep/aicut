// 쇼츠 카드 HTML 생성 함수
function _promoGetSvg(genre) {
  // 장르로 카드 찾기
  var map = {
    '리뷰·체험단':'review','리뷰 · 체험단':'review',
    '광고소재':'ad','광고 소재':'ad',
    '유튜브·릴스':'youtube','유튜브 · 릴스':'youtube',
    '인터뷰·강의':'edu','인터뷰 · 강의':'edu',
    '제품·이커머스':'ecom','제품 · 이커머스':'ecom'
  };
  var key = map[genre] || 'review';
  var card = _promoCards.find(function(c) { return c.key === key; }) || _promoCards[0];
  return _buildPromoCard(card);
}

function _promoGetCardByIndex(idx) {
  return _buildPromoCard(_promoCards[idx % _promoCards.length]);
}

function _buildPromoCard(card) {
  var wrap = document.createElement('div');
  wrap.style.cssText = 'position:relative;width:100%;height:100%;border-radius:18px;overflow:hidden;background:#111;font-family:Arial,sans-serif';
  wrap.innerHTML =
    // 배경 이미지
    '<img src="' + card.img + '" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block">' +
    // 그라디언트 오버레이
    '<div style="position:absolute;inset:0;background:linear-gradient(to bottom,rgba(0,0,0,0.25) 0%,transparent 30%,transparent 45%,rgba(0,0,0,0.75) 75%,rgba(0,0,0,0.92) 100%)"></div>' +
    // 상태바
    '<div style="position:absolute;top:0;left:0;right:0;height:28px;display:flex;align-items:center;padding:0 12px;justify-content:space-between">' +
      '<span style="font-size:11px;color:white;font-weight:700">9:41</span>' +
      '<span style="font-size:10px;color:white">▌▌▌ ⬡ 🔋</span>' +
    '</div>' +
    // 우측 액션 버튼
    '<div style="position:absolute;right:10px;bottom:120px;display:flex;flex-direction:column;gap:14px;align-items:center">' +
      '<div style="text-align:center">' +
        '<div style="width:40px;height:40px;background:rgba(255,255,255,0.15);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:20px;backdrop-filter:blur(4px)">❤️</div>' +
        '<div style="font-size:10px;color:white;margin-top:3px;font-weight:600">' + card.likes + '</div>' +
      '</div>' +
      '<div style="text-align:center">' +
        '<div style="width:40px;height:40px;background:rgba(255,255,255,0.15);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:18px;backdrop-filter:blur(4px)">💬</div>' +
        '<div style="font-size:10px;color:white;margin-top:3px;font-weight:600">' + card.comments + '</div>' +
      '</div>' +
      '<div style="text-align:center">' +
        '<div style="width:40px;height:40px;background:rgba(255,255,255,0.15);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:18px;backdrop-filter:blur(4px)">↗</div>' +
        '<div style="font-size:10px;color:white;margin-top:3px;font-weight:600">공유</div>' +
      '</div>' +
    '</div>' +
    // 하단 텍스트
    '<div style="position:absolute;bottom:0;left:0;right:50px;padding:14px">' +
      '<div style="font-size:12px;color:' + card.accent + ';font-weight:700;margin-bottom:6px">' + card.username + '</div>' +
      '<div style="font-size:15px;color:white;font-weight:800;line-height:1.3;margin-bottom:3px;text-shadow:0 1px 4px rgba(0,0,0,0.5)">' + card.title1 + '</div>' +
      '<div style="font-size:14px;color:white;font-weight:700;line-height:1.3;margin-bottom:8px;text-shadow:0 1px 4px rgba(0,0,0,0.5)">' + card.title2 + '</div>' +
      '<div style="font-size:10px;color:rgba(255,255,255,0.7);margin-bottom:8px">' + card.tags + '</div>' +
      '<div style="display:flex;align-items:center;gap:6px;background:rgba(255,255,255,0.1);border-radius:12px;padding:4px 10px;backdrop-filter:blur(4px)">' +
        '<span style="font-size:10px;color:white">' + card.music + '</span>' +
      '</div>' +
    '</div>';
  return wrap;
}

window.loadMainPromoVideos = function() {
  if (!window._db) { setTimeout(loadMainPromoVideos, 500); return; }

  var isMobileDevice = ('ontouchstart' in window) || /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);

  function _applyCard(parentEl, item, idx) {
    var genre = item.genre || '';
    parentEl.innerHTML = '';

    var wrap = document.createElement('div');
    wrap.style.cssText = 'width:100%;height:100%;border-radius:18px;overflow:hidden;background:#111';

    if (item.imageUrl) {
      // 어드민 업로드 이미지
      var img = document.createElement('img');
      img.style.cssText = 'width:100%;height:100%;object-fit:cover;display:block';
      img.src = item.imageUrl;
      img.onerror = function() {
        parentEl.innerHTML = '';
        var fallback = _promoGetCardByIndex(idx);
        parentEl.appendChild(fallback);
      };
      wrap.appendChild(img);
    } else {
      // 인덱스별 기본 카드 (각각 다른 이미지+텍스트)
      wrap = _promoGetCardByIndex(idx);
    }

    parentEl.appendChild(wrap);
  }

  function _applyAll(items) {
    for (var i = 0; i < 5; i++) {
      (function(idx) {
        var item  = items[idx] || {};
        var genre = item.genre || '';
        [idx + 1, idx + 6].forEach(function(num) {
          var frame = document.getElementById('shortsIframe' + num);
          if (frame) _applyCard(frame.parentNode, item, idx);
        });
        var tagEls   = document.querySelectorAll('.sv-tag');
        var labelEls = document.querySelectorAll('.sv-label');
        if (tagEls[idx])       tagEls[idx].textContent       = genre;
        if (tagEls[idx+5])     tagEls[idx+5].textContent     = genre;
        if (labelEls[idx])     labelEls[idx].textContent     = genre;
        if (labelEls[idx+5])   labelEls[idx+5].textContent   = genre;
      })(i);
    }
  }

  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
    var q = fs.query(fs.collection(window._db, 'promotions'), fs.orderBy('order', 'asc'));
    fs.getDocs(q).then(function(snap) {
      var items = [];
      if (!snap.empty) snap.forEach(function(doc) { items.push(doc.data()); });
      while (items.length < 5) items.push({});
      _applyAll(items);
    }).catch(function(e) {
      console.warn('[promo]', e.message);
      _applyAll([{},{},{},{},{}]);
    });
  }).catch(function() { _applyAll([{},{},{},{},{}]); });
};

// 에디터 배정 드롭다운 채우기
window.populateEditorSelect = function populateEditorSelect(currentEditor) {
  var sel = document.getElementById('adminEditorSelect');
  if (!sel || !window._db) return;
  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
    fs.getDocs(fs.collection(window._db, 'editors')).then(function(snap) {
      sel.innerHTML = '<option value="">미배정</option>';
      snap.forEach(function(doc) {
        var e = doc.data();
        var opt = document.createElement('option');
        opt.value = e.name;
        opt.textContent = e.name + (e.skill ? ' (' + e.skill + ')' : '') + (e.status === '포화' ? ' — 포화' : '');
        if (e.name === currentEditor) opt.selected = true;
        sel.appendChild(opt);
      });
    });
  });
};

// ===== 에디터 관리 =====
// 어드민 수동 사용자 등록
window.registerManualUser = function registerManualUser() {
  var uid   = (document.getElementById('manualUid')   || {value:''}).value.trim();
  var name  = (document.getElementById('manualName')  || {value:''}).value.trim();
  var email = (document.getElementById('manualEmail') || {value:''}).value.trim();
  if (!uid || !email) { showToast('UID와 이메일은 필수입니다'); return; }
  if (!window._db) return;
  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
    fs.setDoc(fs.doc(window._db, 'users', uid), {
      uid:       uid,
      name:      name || email.split('@')[0],
      email:     email,
      role:      'client',
      provider:  'email',
      status:    'active',
      createdAt: fs.serverTimestamp(),
      lastLogin: fs.serverTimestamp(),
    }, { merge: true }).then(function() {
      showToast('✅ 등록됐습니다. 목록을 새로고침합니다.');
      document.getElementById('manualUid').value = '';
      document.getElementById('manualName').value = '';
      document.getElementById('manualEmail').value = '';
      document.getElementById('manualUserForm').style.display = 'none';
      loadAdminUsers();
    }).catch(function(e) {
      showToast('❌ 등록 실패: ' + e.message);
    });
  });
};

window.loadEditors = function loadEditors() {
  if (!window._db) { setTimeout(loadEditors, 600); return; }
  var tbody   = document.getElementById('editorTable');
  var emptyEl = document.getElementById('editorEmptyRow');
  if (!tbody) return;

  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
    var q = fs.query(fs.collection(window._db, 'editors'), fs.orderBy('createdAt', 'asc'));
    fs.getDocs(q).then(function(snap) {
      tbody.querySelectorAll('tr[data-editor]').forEach(function(r) { r.remove(); });

      if (snap.empty) {
        if (emptyEl) { emptyEl.style.display = ''; emptyEl.cells[0].textContent = '등록된 에디터가 없습니다'; }
        var sub = document.getElementById('editorSubTitle');
        if (sub) sub.textContent = '등록된 에디터가 없습니다';
        ['editorCountTotal','editorCountActive','editorCountFull'].forEach(function(id){
          var el=document.getElementById(id); if(el) el.textContent='0';
        });
        return;
      }
      if (emptyEl) emptyEl.style.display = 'none';

      var total = 0, active = 0, full = 0;
      var statusBadge = { '활성':'badge-editing', '포화':'badge-pending', '휴식':'badge-pending' };
      var statusStyle = { '포화':'background:#fef3c7;color:#92400e', '휴식':'background:#f3f4f6;color:#6b7280' };

      snap.forEach(function(doc) {
        var e = doc.data(); var eid = doc.id;
        total++;
        if (e.status === '활성') active++;
        if (e.status === '포화') full++;

        var tr = document.createElement('tr');
        tr.setAttribute('data-editor', eid);
        var badgeCls   = statusBadge[e.status] || 'badge-editing';
        var badgeStyle = statusStyle[e.status] ? 'style="' + statusStyle[e.status] + '"' : '';
        tr.innerHTML =
          '<td style="font-weight:700">'   + (e.name  || '-') + '</td>' +
          '<td style="font-size:13px">'    + (e.skill || '-') + '</td>' +
          '<td style="text-align:center">' + (e.maxJobs || '-') + '건</td>' +
          '<td><span class="badge ' + badgeCls + '" ' + badgeStyle + '>' + (e.status || '활성') + '</span></td>' +
          '<td style="font-size:12px;color:var(--gray-500)">' + (e.memo || '-') + '</td>' +
          '<td style="display:flex;gap:4px">' +
            '<button class="btn btn-outline" style="padding:4px 10px;font-size:11px" onclick="openEditorEdit(\'' + eid + '\')">✏️ 수정</button>' +
            '<button class="btn btn-outline" style="padding:4px 10px;font-size:11px;color:#dc2626;border-color:#fca5a5" onclick="deleteEditor(\'' + eid + '\',\'' + (e.name||'').replace(/'/g,'') + '\')">🗑</button>' +
          '</td>';
        tbody.appendChild(tr);
      });

      // 요약 카드 업데이트
      var setV = function(id, v) { var el = document.getElementById(id); if (el) el.textContent = v; };
      setV('editorCountTotal',  total + '명');
      setV('editorCountActive', active + '명');
      setV('editorCountFull',   full + '명');
      var sub = document.getElementById('editorSubTitle');
      if (sub) sub.textContent = '전담 에디터 ' + total + '명 운영 중';
    }).catch(function(e) {
      console.warn('[에디터] 조회 실패:', e.message);
    });
  });
};

// 에디터 등록/수정 저장
window.saveEditor = function saveEditor(docId) {
  if (!window._db) return;
  var isEdit = !!docId;
  var prefix = isEdit ? 'edit' : '';
  var name    = (document.getElementById(prefix + 'EditorName')    || {value:''}).value.trim();
  var skill   = (document.getElementById(prefix + 'EditorSkill')   || {value:''}).value;
  var status  = (document.getElementById(prefix + 'EditorStatus')  || {value:'활성'}).value;
  var maxJobs = parseInt((document.getElementById(prefix + 'EditorMaxJobs') || {value:'4'}).value) || 4;
  var memo    = (document.getElementById(prefix + 'EditorMemo')    || {value:''}).value.trim();

  if (!name) { showToast('이름을 입력해주세요'); return; }

  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
    var data = { name: name, skill: skill, status: status, maxJobs: maxJobs, memo: memo, updatedAt: fs.serverTimestamp() };
    var p;
    if (isEdit) {
      p = fs.updateDoc(fs.doc(window._db, 'editors', docId), data);
    } else {
      data.createdAt = fs.serverTimestamp();
      p = fs.addDoc(fs.collection(window._db, 'editors'), data);
    }
    p.then(function() {
      showToast(isEdit ? '✓ 에디터 정보가 수정됐습니다' : '✓ 에디터가 등록됐습니다');
      document.getElementById('editorEditModal').style.display = 'none';
      document.getElementById('editorAddForm').style.display = 'none';
      // 입력 초기화
      ['editorName','editorSkill','editorMaxJobs','editorMemo'].forEach(function(id) {
        var el = document.getElementById(id); if (el) el.value = id === 'editorMaxJobs' ? '4' : '';
      });
      loadEditors();
    }).catch(function(e) {
      showToast('❌ 저장 실패: ' + e.message);
    });
  });
};

// 에디터 수정 모달 열기
window.openEditorEdit = function openEditorEdit(docId) {
  if (!window._db) return;
  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
    fs.getDoc(fs.doc(window._db, 'editors', docId)).then(function(snap) {
      if (!snap.exists()) { showToast('에디터 정보를 찾을 수 없습니다'); return; }
      var e = snap.data();
      document.getElementById('editEditorId').value     = docId;
      document.getElementById('editEditorName').value   = e.name    || '';
      document.getElementById('editEditorMemo').value   = e.memo    || '';
      document.getElementById('editEditorMaxJobs').value= e.maxJobs || 4;
      // select 값 설정
      var skillSel  = document.getElementById('editEditorSkill');
      var statusSel = document.getElementById('editEditorStatus');
      if (skillSel)  { for (var i=0; i<skillSel.options.length;  i++) if (skillSel.options[i].value  === e.skill)  skillSel.selectedIndex  = i; }
      if (statusSel) { for (var j=0; j<statusSel.options.length; j++) if (statusSel.options[j].value === e.status) statusSel.selectedIndex = j; }
      document.getElementById('editorEditModal').style.display = 'flex';
    });
  });
};

// 에디터 삭제
window.deleteEditor = function deleteEditor(docId, name) {
  if (!confirm((name || '에디터') + '를 삭제하시겠습니까?\n현재 배정된 주문이 있다면 미배정으로 변경해주세요.')) return;
  if (!window._db) return;
  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
    fs.deleteDoc(fs.doc(window._db, 'editors', docId)).then(function() {
      var row = document.querySelector('tr[data-editor="' + docId + '"]');
      if (row) row.remove();
      showToast('🗑 에디터가 삭제됐습니다');
      loadEditors();
    }).catch(function(e) {
      showToast('❌ 삭제 실패: ' + e.message);
    });
  });
};

// B2B 계약 현황 로드
window.loadB2BContracts = function loadB2BContracts() {
  if (!window._db) { setTimeout(loadB2BContracts, 600); return; }
  var tbody   = document.getElementById('b2bContractsTable');
  var emptyEl = document.getElementById('b2bContractsEmpty');
  if (!tbody) return;

  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
    var q = fs.query(fs.collection(window._db, 'b2b_contracts'), fs.orderBy('contractAt', 'desc'));
    fs.getDocs(q).then(function(snap) {
      tbody.querySelectorAll('tr[data-contract]').forEach(function(r) { r.remove(); });
      if (snap.empty) {
        if (emptyEl) { emptyEl.style.display = ''; emptyEl.cells[0].textContent = '등록된 계약이 없습니다'; }
        return;
      }
      if (emptyEl) emptyEl.style.display = 'none';
      var statusMap = { '계약중':'badge-review', '만료':'badge-pending', '미진행':'badge-pending' };
      snap.forEach(function(doc) {
        var c = doc.data(); var cid = doc.id;
        var dateStr = c.contractAt && c.contractAt.toDate
          ? c.contractAt.toDate().toLocaleDateString('ko-KR') : '-';
        // 최근 비고 미리보기 (최대 20자)
        var latestRemark = '';
        if (c.remarks && c.remarks.length > 0) {
          var last = c.remarks[c.remarks.length - 1];
          latestRemark = (last.text || '').substring(0, 20) + ((last.text||'').length > 20 ? '…' : '');
        }
        var remarkCount = (c.remarks && c.remarks.length) ? c.remarks.length : 0;
        var tr = document.createElement('tr');
        tr.setAttribute('data-contract', cid);
        tr.innerHTML =
          '<td style="font-weight:700">'  + (c.company || '-') + '</td>' +
          '<td>' + (c.manager || '-') + '</td>' +
          '<td style="font-size:12px"><a href="mailto:' + (c.email||'') + '" style="color:var(--accent)">' + (c.email||'-') + '</a></td>' +
          '<td style="font-weight:700">'  + (c.volume  || '-') + '</td>' +
          '<td style="font-size:12px;color:var(--gray-400)">' + dateStr + '</td>' +
          '<td><span class="badge ' + (statusMap[c.status]||'badge-review') + '" id="bc-status-' + cid + '">' + (c.status||'계약중') + '</span></td>' +
          '<td style="max-width:160px">' +
            '<div style="display:flex;align-items:center;gap:6px">' +
              '<span style="font-size:11px;color:var(--gray-400);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" id="remark-preview-' + cid + '">' +
                (latestRemark || '<span style="color:#ccc">비고 없음</span>') +
              '</span>' +
              (remarkCount > 0 ? '<span style="font-size:10px;background:var(--accent);color:#fff;border-radius:10px;padding:1px 6px">' + remarkCount + '</span>' : '') +
              '<button class="btn btn-outline" style="padding:3px 8px;font-size:11px;white-space:nowrap;flex-shrink:0" onclick="openRemarkModal(\'' + cid + '\',\'' + (c.company||'').replace(/'/g,'') + '\')">📝 비고</button>' +
            '</div>' +
          '</td>' +
          '<td style="display:flex;gap:4px">' +
            '<button class="btn btn-outline" style="padding:4px 8px;font-size:11px" onclick="changeContractStatus(\'' + cid + '\',\'만료\')">만료</button>' +
            '<button class="btn btn-outline" style="padding:4px 8px;font-size:11px;color:#dc2626;border-color:#fca5a5" onclick="deleteB2BContract(\'' + cid + '\',\'' + (c.company||'').replace(/'/g,'') + '\')">🗑</button>' +
          '</td>';
        tbody.appendChild(tr);
      });
    }).catch(function(e) {
      console.warn('[B2B계약] 조회 실패:', e.message);
    });
  });
};

// ===== B2B 비고 히스토리 모달 =====
window.openRemarkModal = function(contractId, company) {
  document.getElementById('remarkModalTitle').textContent = company + ' — 비고 히스토리';
  document.getElementById('remarkModal').setAttribute('data-cid', contractId);
  document.getElementById('remarkNewText').value = '';
  document.getElementById('remarkModal').style.display = 'flex';
  loadRemarkHistory(contractId);
};

window.closeRemarkModal = function() {
  document.getElementById('remarkModal').style.display = 'none';
};

function loadRemarkHistory(contractId) {
  var list = document.getElementById('remarkHistoryList');
  list.innerHTML = '<div style="text-align:center;padding:20px;color:var(--gray-400)">로딩 중...</div>';
  if (!window._db) return;
  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
    fs.getDoc(fs.doc(window._db, 'b2b_contracts', contractId)).then(function(snap) {
      if (!snap.exists()) { list.innerHTML = '<div style="text-align:center;padding:20px;color:var(--gray-400)">데이터 없음</div>'; return; }
      var remarks = snap.data().remarks || [];
      if (remarks.length === 0) {
        list.innerHTML = '<div style="text-align:center;padding:20px;color:var(--gray-400);font-size:13px">등록된 비고가 없습니다</div>';
        return;
      }
      list.innerHTML = '';
      // 최신순 정렬
      var sorted = remarks.slice().sort(function(a, b) { return (b.ts || 0) - (a.ts || 0); });
      sorted.forEach(function(r, idx) {
        var realIdx = remarks.length - 1 - idx;
        var dateStr = r.ts ? new Date(r.ts).toLocaleString('ko-KR') : '-';
        var item = document.createElement('div');
        item.style.cssText = 'border:1px solid var(--border);border-radius:10px;padding:12px 14px;margin-bottom:8px;background:#fafafa';
        item.innerHTML =
          '<div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px">' +
            '<div style="font-size:12px;color:var(--gray-400);white-space:nowrap">' + dateStr + '</div>' +
            '<button onclick="deleteRemark(\'' + contractId + '\',' + realIdx + ')" style="border:none;background:none;color:#dc2626;cursor:pointer;font-size:13px;padding:0;flex-shrink:0">✕</button>' +
          '</div>' +
          '<div style="font-size:14px;color:var(--primary);margin-top:6px;line-height:1.6;white-space:pre-wrap" id="remark-text-' + contractId + '-' + realIdx + '">' + (r.text||'') + '</div>' +
          '<div style="margin-top:8px;display:flex;gap:6px">' +
            '<button class="btn btn-outline" style="padding:3px 10px;font-size:11px" onclick="editRemark(\'' + contractId + '\',' + realIdx + ')">✏️ 수정</button>' +
          '</div>';
        list.appendChild(item);
      });
    });
  });
}

window.saveRemark = function() {
  var modal = document.getElementById('remarkModal');
  var cid   = modal.getAttribute('data-cid');
  var text  = (document.getElementById('remarkNewText').value || '').trim();
  if (!text) { showToast('비고 내용을 입력해주세요'); return; }
  if (!window._db) return;

  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
    var ref = fs.doc(window._db, 'b2b_contracts', cid);
    fs.getDoc(ref).then(function(snap) {
      var remarks = snap.exists() ? (snap.data().remarks || []) : [];
      remarks.push({ text: text, ts: Date.now() });
      return fs.updateDoc(ref, { remarks: remarks, updatedAt: fs.serverTimestamp() });
    }).then(function() {
      document.getElementById('remarkNewText').value = '';
      showToast('✅ 비고가 저장됐습니다');
      loadRemarkHistory(cid);
      // 테이블 미리보기 업데이트
      var preview = document.getElementById('remark-preview-' + cid);
      if (preview) preview.textContent = text.substring(0, 20) + (text.length > 20 ? '…' : '');
    }).catch(function(e) { showToast('❌ 저장 실패: ' + e.message); });
  });
};

window.editRemark = function(cid, idx) {
  if (!window._db) return;
  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
    fs.getDoc(fs.doc(window._db, 'b2b_contracts', cid)).then(function(snap) {
      var remarks = snap.data().remarks || [];
      var cur = remarks[idx] ? remarks[idx].text : '';
      var newText = prompt('비고 내용 수정:', cur);
      if (newText === null) return;
      newText = newText.trim();
      if (!newText) { showToast('내용을 입력해주세요'); return; }
      remarks[idx].text = newText;
      remarks[idx].editedTs = Date.now();
      return fs.updateDoc(fs.doc(window._db, 'b2b_contracts', cid), {
        remarks: remarks, updatedAt: fs.serverTimestamp()
      });
    }).then(function() {
      showToast('✅ 수정됐습니다');
      loadRemarkHistory(cid);
    }).catch(function(e) { if (e) showToast('❌ 수정 실패: ' + e.message); });
  });
};

window.deleteRemark = function(cid, idx) {
  if (!confirm('이 비고를 삭제하시겠습니까?')) return;
  if (!window._db) return;
  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
    fs.getDoc(fs.doc(window._db, 'b2b_contracts', cid)).then(function(snap) {
      var remarks = snap.data().remarks || [];
      remarks.splice(idx, 1);
      return fs.updateDoc(fs.doc(window._db, 'b2b_contracts', cid), {
        remarks: remarks, updatedAt: fs.serverTimestamp()
      });
    }).then(function() {
      showToast('🗑 삭제됐습니다');
      loadRemarkHistory(cid);
    }).catch(function(e) { if (e) showToast('❌ 삭제 실패: ' + e.message); });
  });
};

// 계약 상태 변경
window.changeContractStatus = function changeContractStatus(docId, newStatus) {
  if (!window._db) return;
  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
    fs.updateDoc(fs.doc(window._db, 'b2b_contracts', docId), {
      status: newStatus, updatedAt: fs.serverTimestamp()
    }).then(function() {
      var badge = document.getElementById('bc-status-' + docId);
      if (badge) { badge.className = 'badge badge-pending'; badge.textContent = newStatus; }
      showToast('✓ 계약 상태가 "' + newStatus + '"으로 변경됐습니다');
    });
  });
};

// 계약 삭제
window.deleteB2BContract = function deleteB2BContract(docId, company) {
  if (!confirm((company||'해당 계약') + '을 삭제하시겠습니까?')) return;
  if (!window._db) return;
  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
    fs.deleteDoc(fs.doc(window._db, 'b2b_contracts', docId)).then(function() {
      var row = document.querySelector('tr[data-contract="' + docId + '"]');
      if (row) row.remove();
      showToast('🗑 계약이 삭제됐습니다');
    });
  });
};

function switchAuthTab(name, btn) {
  document.querySelectorAll('.tab-switch button').forEach(b => b.classList.remove('active'));
  if (btn) btn.classList.add('active');
  document.querySelectorAll('#authModal .tab-panel').forEach(p => {
    p.classList.remove('active');
    p.style.display = 'none';
  });
  const panel = document.getElementById('ap-'+name);
  if (panel) {
    panel.classList.add('active');
    panel.style.display = 'block';
  }
  // 탭 전환 시 에러/재발송 박스 초기화
  var loginErr = document.getElementById('loginError');
  var resendBox = document.getElementById('loginResendBox');
  var regErr = document.getElementById('regError');
  if (loginErr) loginErr.style.display = 'none';
  if (resendBox) resendBox.style.display = 'none';
  if (regErr) regErr.style.display = 'none';
  // 타이틀 분기
  const title = document.getElementById('modalTitle');
  const sub = document.getElementById('modalSub');
  if (title) title.textContent = name === 'register' ? '회원가입' : '로그인';
  if (sub) sub.textContent = name === 'register' ? '무료로 시작하세요' : '계정에 로그인하세요';
}
document.querySelectorAll('.overlay').forEach(o => o.addEventListener('click', e => { if(e.target===o) o.classList.remove('open'); }));

// ===== 소셜 로그인 =====
function doSocialLogin(provider) {
  const names = { kakao: '카카오', naver: '네이버', google: 'Google' };
  const name = names[provider] || provider;
  // 배포 후 실제 OAuth URL로 교체
  // 카카오: https://kauth.kakao.com/oauth/authorize?...
  // 네이버: https://nid.naver.com/oauth2.0/authorize?...
  // 구글: https://accounts.google.com/o/oauth2/auth?...
  showToast(`${name} 로그인은 준비 중입니다. 이메일로 가입해주세요 😊`);
  // 소셜 로그인 준비 중
  setTimeout(() => {
    closeModal();
    setSession('client', provider === 'kakao' ? '카카오 사용자' : provider === 'naver' ? '네이버 사용자' : 'Google 사용자');
    showPage('client');
    updateNavState('client');
    showToast(`${name}으로 로그인되었습니다 👋`);
  }, 800);
}

// ===== 어드민 계정 정보 (비밀번호 해시 처리) =====
function _h(s){var h=0;for(var i=0;i<s.length;i++){h=((h<<5)-h)+s.charCodeAt(i);h|=0;}return h.toString(16);}
async function _sha(pw){
  var buf=new TextEncoder().encode(pw);
  var ab=await crypto.subtle.digest('SHA-256',buf);
  return Array.from(new Uint8Array(ab)).map(b=>b.toString(16).padStart(2,'0')).join('');
}
/* ===== 어드민 로그인 — Firebase Auth + Custom Claims 검증 ===== */
/*
 * 보안 개선 사항:
 * - ADMIN_HASHES(평문 해시) 완전 제거
 * - Firebase 이메일 로그인 후 ID Token의 Custom Claims 서버 검증
 * - claims.admin === true 인 계정만 어드민 페이지 허용
 * - localStorage role 조작으로는 어드민 접근 불가 (토큰 재검증)
 *
 * Firebase Console → Functions 또는 Admin SDK에서 아래와 같이 권한 부여 필요:
 *   admin.auth().setCustomUserClaims(uid, { admin: true, role: 'master' })
 */

window.doAdminLogin = async function doAdminLogin() {
  const email = document.getElementById('adminLoginId')?.value?.trim();
  const pw    = document.getElementById('adminLoginPw')?.value;
  const btn   = document.querySelector('#adminLoginModal .btn');

  if (!email) { showToast('⚠️ 관리자 이메일을 입력해주세요'); return; }
  if (!pw)    { showToast('⚠️ 비밀번호를 입력해주세요'); return; }

  if (btn) { btn.disabled = true; btn.textContent = '인증 중...'; }

  try {
    const auth = window._fbAuth;
    if (!auth) throw new Error('Firebase Auth 초기화 실패');

    // 1) Firebase 이메일 로그인
    const { signInWithEmailAndPassword } = await import('https://www.gstatic.com/firebasejs/11.6.0/firebase-auth.js');
    const cred = await signInWithEmailAndPassword(auth, email, pw);
    const user = cred.user;

    // 2) ID Token 강제 갱신 후 Custom Claims 확인
    const idTokenResult = await user.getIdTokenResult(true);
    const claims = idTokenResult.claims;

    // 이메일 화이트리스트 확인
    if (!claims.admin || !window.ADMIN_EMAILS || window.ADMIN_EMAILS.indexOf(email) === -1) {
      // 어드민 권한 없음 → 즉시 로그아웃 후 차단
      await auth.signOut();
      showToast('❌ 관리자 권한이 없는 계정입니다');
      document.getElementById('adminLoginPw').value = '';
      return;
    }

    // 3) 권한 확인 완료 — 세션 저장 (role은 claims에서만 취득)
    const role     = claims.role || 'ops';   // 'master' | 'ops'
    const dispName = user.displayName || email.split('@')[0];

    document.getElementById('adminLoginModal').classList.remove('open');

    // localStorage에는 role 저장 안 함 — 매 접근마다 토큰 재검증
    setSession('admin', dispName, email);
    window._adminIdToken   = await user.getIdToken();   // 메모리에만 보관
    window._adminClaimRole = role;

    showPage('admin');
    updateNavState('admin');

    const badge = document.querySelector('.admin-badge');
    if (badge) badge.textContent = role === 'master' ? '마스터' : '운영담당';
    showToast(`${dispName}님, 환영합니다 👋`);

  } catch (err) {
    const code = err.code || '';
    if (code === 'auth/user-not-found' || code === 'auth/wrong-password' || code === 'auth/invalid-credential') {
      showToast('❌ 이메일 또는 비밀번호가 올바르지 않습니다');
    } else if (code === 'auth/too-many-requests') {
      showToast('⚠️ 로그인 시도가 너무 많습니다. 잠시 후 다시 시도해주세요');
    } else {
      showToast('❌ 로그인 중 오류가 발생했습니다: ' + (err.message || code));
    }
    document.getElementById('adminLoginPw').value = '';
  } finally {
    if (btn) { btn.disabled = false; btn.textContent = '관리자 로그인'; }
  }
};


window.selectOption = function selectOption(btn) {
  document.querySelectorAll('.cta-option-btn').forEach(b => b.classList.remove('selected'));
  btn.classList.add('selected');
  setTimeout(() => openModal('register'), 400);
}

// ===== Firebase Auth 인증 =====
let _fbUser = null;

function initNetlifyIdentity() {
  // Firebase onAuthStateChanged 에서 처리됨
}

// 이메일 로그인
window.doEmailLogin = function() {
  var email = (document.getElementById('loginEmail') || {}).value;
  var pw    = (document.getElementById('loginPw') || {}).value;
  var errEl = document.getElementById('loginError');
  var btn   = document.getElementById('loginBtn');
  if (email) email = email.trim();

  if (!email || !pw) { showAuthError(errEl, '이메일과 비밀번호를 입력해주세요'); return; }
  if (!email.includes('@')) { showAuthError(errEl, '올바른 이메일 형식으로 입력해주세요'); return; }
  if (!window._fbSignIn) { showAuthError(errEl, '잠시 후 다시 시도해주세요'); return; }

  if (btn) { btn.disabled = true; btn.textContent = '로그인 중...'; }
  if (errEl) errEl.style.display = 'none';

  window._fbSignIn(email, pw)
    .then(function(cred) {
      var user = cred.user;
      if (!user.emailVerified) {
        window._lastLoginEmail = email;
        window._lastLoginPw = pw;
        window._fbSignOut();
        if (btn) { btn.disabled = false; btn.textContent = '로그인'; }
        if (errEl) { errEl.textContent = '이메일 인증이 필요합니다.'; errEl.style.display = 'block'; }
        var resendBox = document.getElementById('loginResendBox');
        if (resendBox) resendBox.style.display = 'block';
        return;
      }
      var name = user.displayName || email.split('@')[0];

      // Claims 확인 후 admin/client 분기
      user.getIdTokenResult(true).then(function(idTokenResult) {
        var claims = idTokenResult.claims;

        if (claims && claims.admin === true && window.ADMIN_EMAILS.indexOf(email) !== -1) {
          // ── 어드민 계정 ──
          window._adminIdToken   = idTokenResult.token;
          window._adminClaimRole = claims.role || 'ops';
          setSession('admin', name, email);
          closeModal();
          showPage('admin');
          updateNavState('admin');
          var badge = document.querySelector('.admin-badge');
          if (badge) badge.textContent = claims.role === 'master' ? '마스터' : '운영담당';
          showToast('어드민으로 로그인되었습니다 👋');
        } else {
          // ── 일반 고객 계정 — admin 상태 완전 초기화 ──
          window._adminIdToken   = null;
          window._adminClaimRole = null;
          // 로그인 시 lastLogin + loginCount 업데이트
          if (window._db && user) {
            import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
              fs.setDoc(fs.doc(window._db, 'users', user.uid), {
                uid:        user.uid,
                name:       name,
                email:      email,
                role:       'client',
                lastLogin:  fs.serverTimestamp(),
                loginCount: fs.increment(1),
                status:     'active',
              }, { merge: true }).catch(function(){});
            });
          }
          setSession('client', name, email);
          updateNavState('client');
          showPage('client');
          initClientPage({ name: name, email: email });
          if (typeof window._channelIOLogin === 'function') {
            window._channelIOLogin(name, email);
          }
          var resendBox = document.getElementById('loginResendBox');
          if (resendBox) resendBox.style.display = 'none';
          closeModal();
          showToast('안녕하세요, ' + name + ' 님! 👋');
        }
        if (btn) { btn.disabled = false; btn.textContent = '로그인'; }
      }).catch(function() {
        // Claims 조회 실패 시 일반 고객으로 처리
        setSession('client', name, email);
        updateNavState('client');
        showPage('client');
        initClientPage({ name: name, email: email });
        closeModal();
        showToast('안녕하세요, ' + name + ' 님! 👋');
        if (btn) { btn.disabled = false; btn.textContent = '로그인'; }
      });
    })
    .catch(function(err) {
      if (btn) { btn.disabled = false; btn.textContent = '로그인'; }
      var code = err.code || '';
      var msg  = '이메일 또는 비밀번호가 올바르지 않습니다';
      if (code === 'auth/user-not-found')    msg = '가입되지 않은 이메일입니다';
      if (code === 'auth/wrong-password')    msg = '비밀번호가 올바르지 않습니다';
      if (code === 'auth/invalid-credential') msg = '이메일 또는 비밀번호가 올바르지 않습니다';
      if (code === 'auth/too-many-requests') msg = '잠시 후 다시 시도해주세요';
      showAuthError(errEl, msg);
    });
};

// 이메일 회원가입
window.doEmailRegister = function() {
  var name  = (document.getElementById('regName') || {}).value;
  var email = (document.getElementById('regEmail') || {}).value;
  var pw    = (document.getElementById('regPw') || {}).value;
  var pw2   = (document.getElementById('regPw2') || {}).value;
  var errEl = document.getElementById('regError');
  var sucEl = document.getElementById('regSuccess');
  var btn   = document.getElementById('regBtn');
  if (name)  name  = name.trim();
  if (email) email = email.trim();

  if (!name)  { showAuthError(errEl, '이름을 입력해주세요'); return; }
  if (!email || !email.includes('@')) { showAuthError(errEl, '올바른 이메일을 입력해주세요'); return; }
  if (!pw || pw.length < 8) { showAuthError(errEl, '비밀번호는 8자 이상이어야 합니다'); return; }
  if (pw !== pw2) { showAuthError(errEl, '비밀번호가 일치하지 않습니다'); return; }
  if (!window._fbSignUp) { showAuthError(errEl, '잠시 후 다시 시도해주세요'); return; }

  if (btn) { btn.disabled = true; btn.textContent = '가입 중...'; }
  if (errEl) errEl.style.display = 'none';
  if (sucEl) sucEl.style.display = 'none';

  var _name = name;
  window._fbSignUp(email, pw)
    .then(function(cred) {
      var user = cred.user;
      // 이름 저장
      return window._fbUpdateProfile(user, { displayName: _name })
        .then(function() {
          // Firestore users 컬렉션에 회원 정보 저장
          if (window._db) {
            import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
              fs.setDoc(fs.doc(window._db, 'users', user.uid), {
                uid:         user.uid,
                name:        _name,
                email:       email,
                role:        'client',
                provider:    'email',
                createdAt:   fs.serverTimestamp(),
                lastLogin:   fs.serverTimestamp(),
                loginCount:  1,
                status:      'active',
              }).catch(function(e) { console.warn('[users] 저장 실패:', e.code); });
            });
          }
          return window._fbSendVerification(user);
        })
        .then(function() {
          window._lastRegEmail = email;
          window._lastRegUser = null;
          // GA4 회원가입 이벤트
          window._trackEvent('sign_up', { method: 'email' });
          if (typeof window._trackLead === 'function') window._trackLead('sign_up');
          window._fbSignOut();
          if (btn) { btn.disabled = false; btn.textContent = '무료로 시작하기 →'; }
          if (sucEl) {
            var emailEl = document.getElementById('regSuccessEmail');
            if (emailEl) emailEl.textContent = email + ' 로 발송되었습니다';
            sucEl.style.display = 'block';
          }
          showToast('📧 확인 이메일이 발송되었습니다!');
        });
    })
    .catch(function(err) {
      if (btn) { btn.disabled = false; btn.textContent = '무료로 시작하기 →'; }
      var code = err.code || '';
      var msg  = '가입 중 오류가 발생했습니다';
      if (code === 'auth/email-already-in-use') msg = '이미 가입된 이메일입니다. 로그인 탭을 이용해주세요';
      if (code === 'auth/weak-password')        msg = '비밀번호는 8자 이상이어야 합니다';
      if (code === 'auth/invalid-email')        msg = '올바른 이메일 형식을 입력해주세요';
      showAuthError(errEl, msg);
    });
};

// 인증 이메일 재발송 (로그인 탭)
window.doResendVerification = function() {
  var email = window._lastLoginEmail;
  var pw    = window._lastLoginPw;
  var btn   = document.getElementById('resendVerifyBtn');
  if (!email || !pw) { showToast('이메일과 비밀번호를 먼저 입력 후 로그인을 시도해주세요'); return; }
  if (btn) { btn.disabled = true; btn.textContent = '발송 중...'; }
  window._fbSignIn(email, pw)
    .then(function(cred) {
      return window._fbSendVerification(cred.user).then(function() {
        return window._fbSignOut();
      });
    })
    .then(function() {
      if (btn) { btn.disabled = false; btn.textContent = '📨 재발송 완료! (스팸함 확인)'; }
      showToast('📧 인증 이메일을 재발송했습니다! 스팸함도 확인해주세요');
      setTimeout(function() {
        if (btn) { btn.disabled = false; btn.textContent = '인증 이메일 재발송'; }
      }, 30000);
    })
    .catch(function() {
      if (btn) { btn.disabled = false; btn.textContent = '인증 이메일 재발송'; }
      showToast('재발송 실패. 잠시 후 다시 시도해주세요');
    });
};

// 인증 이메일 재발송 (회원가입 탭)
window.doResendRegVerification = function() {
  var email = window._lastRegEmail;
  var btn   = document.getElementById('regResendBtn');
  var msg   = document.getElementById('regResendMsg');
  if (!email) { showToast('다시 회원가입을 진행해주세요'); return; }
  // 임시 재발송: 이미 가입된 계정이므로 로그인 후 재발송
  if (btn) { btn.disabled = true; btn.textContent = '발송 중...'; }
  showToast('📧 인증 이메일 재발송 중...');
  // Firebase는 동일 이메일로 재가입 시도 불가하므로, 안내만 제공
  setTimeout(function() {
    if (btn) { btn.disabled = false; btn.textContent = '📨 재발송 완료!'; }
    if (msg) { msg.textContent = '✅ ' + email + '로 재발송했습니다. 스팸함도 확인해주세요'; msg.style.display = 'block'; }
    showToast('📧 인증 이메일을 재발송했습니다!');
    // 실제 재발송: 로그인 탭으로 이동 후 재발송 유도
    setTimeout(function() {
      window._lastLoginEmail = email;
      switchAuthTab('login', document.querySelector('.tab-switch button:first-child'));
      var loginEmailEl = document.getElementById('loginEmail');
      if (loginEmailEl) loginEmailEl.value = email;
      var resendBox = document.getElementById('loginResendBox');
      if (resendBox) resendBox.style.display = 'block';
    }, 2000);
  }, 1000);
};

// 비밀번호 재설정
window.doForgotPassword = function() {
  var email = (document.getElementById('loginEmail') || {}).value;
  var errEl = document.getElementById('loginError');
  if (email) email = email.trim();
  if (!email || !email.includes('@')) {
    showAuthError(errEl, '위 이메일 입력란에 이메일을 먼저 입력해주세요');
    return;
  }
  if (!window._fbResetPassword) return;
  window._fbResetPassword(email)
    .then(function() { showToast('📧 ' + email + '로 비밀번호 재설정 이메일을 보냈습니다'); })
    .catch(function(err) {
      var msg = '이메일 발송에 실패했습니다';
      if (err.code === 'auth/user-not-found') msg = '가입되지 않은 이메일입니다';
      showToast('❌ ' + msg);
    });
};

// 로그아웃
function doLogout() {
  if (window._fbSignOut) {
    window._fbSignOut().then(function() {
      clearSession();
      // 채널톡 사용자 초기화
      if (typeof window._channelIOLogout === 'function') {
        window._channelIOLogout();
      }
      updateNavState('home');
      showPage('home');
      showToast('로그아웃되었습니다 👋');
    });
  } else {
    clearSession();
    updateNavState('home');
    showPage('home');
    showToast('로그아웃되었습니다 👋');
  }
}

// 프로필 저장
window.saveProfile = function() {
  var session = getSession();
  if (!session) return;
  var name    = (document.getElementById('profileName')?.value || '').trim() || session.name;
  var done = function() {
    setSession('client', name, session.email);
    var titleEl = document.getElementById('clientWelcomeTitle');
    if (titleEl) titleEl.textContent = '안녕하세요, ' + name + ' 님 👋';
    showToast('✓ 프로필이 저장되었습니다');
  };
  var user = window._fbCurrentUser;
  if (user && window._fbUpdateProfile) {
    window._fbUpdateProfile(user, { displayName: name }).then(done).catch(done);
  } else {
    done();
  }
};

// 에러 표시 헬퍼
// 비밀번호 재설정 모달 표시
var _resetOobCode = '';
function showResetPasswordModal(oobCode) {
  _resetOobCode = oobCode;
  document.getElementById('resetPwModal').classList.add('open');
  var inp = document.getElementById('newPw1');
  if (inp) inp.focus();
}

// 비밀번호 재설정 처리
window.doResetPassword = function() {
  var pw1   = (document.getElementById('newPw1') || {}).value || '';
  var pw2   = (document.getElementById('newPw2') || {}).value || '';
  var errEl = document.getElementById('resetPwError');
  var btn   = document.getElementById('resetPwBtn');

  if (!pw1 || pw1.length < 8) { showAuthError(errEl, '비밀번호는 8자 이상이어야 합니다'); return; }
  if (pw1 !== pw2) { showAuthError(errEl, '비밀번호가 일치하지 않습니다'); return; }
  if (!_resetOobCode) { showAuthError(errEl, '유효하지 않은 링크입니다. 다시 요청해주세요'); return; }

  if (btn) { btn.disabled = true; btn.textContent = '변경 중...'; }
  if (errEl) errEl.style.display = 'none';

  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-auth.js')
    .then(function(m) {
      return m.confirmPasswordReset(window._fbAuth, _resetOobCode, pw1);
    })
    .then(function() {
      document.getElementById('resetPwModal').classList.remove('open');
      showToast('✅ 비밀번호가 변경됐습니다. 새 비밀번호로 로그인해주세요');
      setTimeout(function() { openModal('login'); }, 1500);
      if (btn) { btn.disabled = false; btn.textContent = '비밀번호 변경하기'; }
    })
    .catch(function(err) {
      if (btn) { btn.disabled = false; btn.textContent = '비밀번호 변경하기'; }
      var code = err.code || '';
      var msg  = '비밀번호 변경에 실패했습니다';
      if (code === 'auth/expired-action-code') msg = '링크가 만료됐습니다. 비밀번호 재설정을 다시 요청해주세요';
      if (code === 'auth/invalid-action-code') msg = '유효하지 않은 링크입니다. 다시 요청해주세요';
      if (code === 'auth/weak-password')        msg = '비밀번호는 8자 이상이어야 합니다';
      showAuthError(errEl, msg);
    });
};

// 법적 문서 모달
window.openLegalModal = function(type) {
  var modal = document.getElementById('legalModal');
  var content = document.getElementById('legalModalContent');
  if (!modal || !content) return;

  var today = '2026년 3월 30일';

  if (type === 'privacy') {
    content.innerHTML = `
      <h2 style="font-size:22px;font-weight:800;color:var(--primary);margin-bottom:4px">개인정보처리방침</h2>
      <p style="font-size:13px;color:var(--gray-400);margin-bottom:24px">시행일: ${today}</p>
      <div style="font-size:14px;color:var(--gray-600);line-height:1.9">
        <p>주식회사 온니바이어(이하 "회사")는 에이컷(AICUT) 서비스 운영과 관련하여 「개인정보 보호법」 및 관련 법령에 따라 이용자의 개인정보를 보호하고, 이와 관련한 고충을 신속하게 처리하기 위하여 다음과 같이 개인정보처리방침을 수립·공개합니다.</p>

        <h3 style="font-size:15px;font-weight:700;color:var(--primary);margin:20px 0 8px">1. 수집하는 개인정보 항목</h3>
        <p><b>필수 항목:</b> 이름, 이메일 주소, 비밀번호<br>
        <b>선택 항목:</b> 연락처, 회사명<br>
        <b>자동 수집:</b> IP 주소, 쿠키, 접속 로그, 서비스 이용 기록</p>

        <h3 style="font-size:15px;font-weight:700;color:var(--primary);margin:20px 0 8px">2. 개인정보 수집 및 이용 목적</h3>
        <p>• 서비스 제공 및 계약 이행 (영상 편집 의뢰, 납품)<br>
        • 회원 관리 및 본인 확인<br>
        • 고객 상담 및 불만 처리<br>
        • 서비스 개선 및 신규 서비스 개발<br>
        • 마케팅 및 광고 활용 (별도 동의 시)</p>

        <h3 style="font-size:15px;font-weight:700;color:var(--primary);margin:20px 0 8px">3. 개인정보 보유 및 이용 기간</h3>
        <p>• 회원 탈퇴 시까지 (탈퇴 후 즉시 파기)<br>
        • 관련 법령에 따른 보존 기간:<br>
        &nbsp;&nbsp;- 계약 또는 청약철회 기록: 5년 (전자상거래법)<br>
        &nbsp;&nbsp;- 대금 결제 및 재화 공급 기록: 5년<br>
        &nbsp;&nbsp;- 소비자 불만 및 분쟁처리 기록: 3년</p>

        <h3 style="font-size:15px;font-weight:700;color:var(--primary);margin:20px 0 8px">4. 개인정보의 제3자 제공</h3>
        <p>회사는 원칙적으로 이용자의 개인정보를 제3자에게 제공하지 않습니다. 다만 이용자의 동의가 있거나 법령에 의한 경우는 예외로 합니다.</p>

        <h3 style="font-size:15px;font-weight:700;color:var(--primary);margin:20px 0 8px">5. 개인정보 처리 위탁</h3>
        <p>• Firebase (Google LLC) — 인증 및 데이터 저장<br>
        • 채널톡 — 고객 상담 서비스<br>
        • 포트원 — 결제 처리 (결제 이용 시)</p>

        <h3 style="font-size:15px;font-weight:700;color:var(--primary);margin:20px 0 8px">6. 이용자의 권리</h3>
        <p>이용자는 언제든지 개인정보 열람, 정정, 삭제, 처리 정지를 요청할 수 있습니다. 요청은 master@aicut.co.kr로 연락해주세요.</p>

        <h3 style="font-size:15px;font-weight:700;color:var(--primary);margin:20px 0 8px">7. 개인정보 보호책임자</h3>
        <p>성명: 정효진<br>
        직책: 대표이사<br>
        이메일: master@aicut.co.kr</p>

        <h3 style="font-size:15px;font-weight:700;color:var(--primary);margin:20px 0 8px">8. 개인정보처리방침 변경</h3>
        <p>본 방침은 ${today}부터 적용됩니다. 변경 시 서비스 내 공지사항을 통해 사전 안내합니다.</p>

        <p style="margin-top:24px;padding:16px;background:var(--gray-50);border-radius:8px;font-size:13px">
        주식회사 온니바이어 | 대표이사 정효진<br>
        사업자등록번호: 353-86-03415<br>
        서울시 송파구 법원로 8길 8, SKV1 2차 1118호
        </p>
      </div>
    `;
  } else if (type === 'terms') {
    content.innerHTML = `
      <h2 style="font-size:22px;font-weight:800;color:var(--primary);margin-bottom:4px">이용약관</h2>
      <p style="font-size:13px;color:var(--gray-400);margin-bottom:24px">시행일: ${today}</p>
      <div style="font-size:14px;color:var(--gray-600);line-height:1.9">
        <h3 style="font-size:15px;font-weight:700;color:var(--primary);margin:0 0 8px">제1조 (목적)</h3>
        <p>이 약관은 주식회사 온니바이어(이하 "회사")가 운영하는 에이컷(AICUT) 서비스(이하 "서비스")의 이용 조건 및 절차, 회사와 이용자 간의 권리·의무 및 책임사항을 규정함을 목적으로 합니다.</p>

        <h3 style="font-size:15px;font-weight:700;color:var(--primary);margin:20px 0 8px">제2조 (정의)</h3>
        <p>• "서비스"란 회사가 제공하는 AI 기반 영상 편집 중개 플랫폼 및 관련 제반 서비스를 말합니다.<br>
        • "이용자"란 본 약관에 동의하고 서비스를 이용하는 회원을 말합니다.<br>
        • "에디터"란 회사와 계약하여 영상 편집 작업을 수행하는 전문 작업자를 말합니다.</p>

        <h3 style="font-size:15px;font-weight:700;color:var(--primary);margin:20px 0 8px">제3조 (약관의 효력 및 변경)</h3>
        <p>본 약관은 서비스 화면에 게시하거나 이용자에게 공지함으로써 효력이 발생합니다. 회사는 합리적인 사유가 있는 경우 약관을 변경할 수 있으며, 변경 시 7일 전 공지합니다.</p>

        <h3 style="font-size:15px;font-weight:700;color:var(--primary);margin:20px 0 8px">제4조 (서비스 이용)</h3>
        <p>• 서비스는 회원가입 후 이메일 인증을 완료한 이용자에게 제공됩니다.<br>
        • 영상 편집 의뢰는 요금제 선택 및 결제 완료 후 진행됩니다.<br>
        • 평균 납품 기간은 48시간이며, 플랜에 따라 상이할 수 있습니다.</p>

        <h3 style="font-size:15px;font-weight:700;color:var(--primary);margin:20px 0 8px">제5조 (요금 및 결제)</h3>
        <p>• STANDARD: ₩79,000 / PRO: ₩180,000 / PREMIUM: 상담 후 결정 (VAT 별도)<br>
        • 결제는 신용카드, 계좌이체, 가상계좌 등을 통해 이루어지며, 전자결제대행사(PG사)를 통해 안전하게 처리됩니다.<br>
        • 결제 완료 후 주문번호가 발급되며, 담당 에디터 배정 후 작업이 시작됩니다.</p>

        <h3 style="font-size:15px;font-weight:700;color:var(--primary);margin:20px 0 8px">제5조의2 (청약철회 및 환불 정책)</h3>
        <p>회사는 「전자상거래 등에서의 소비자보호에 관한 법률」에 따라 다음과 같이 환불 정책을 운영합니다.</p>
        <p><b>① 청약철회 (작업 시작 전)</b><br>
        • 결제 완료 후 에디터 작업 착수 전까지 청약을 철회할 수 있습니다.<br>
        • 결제일로부터 7일 이내 청약철회 요청 시 전액 환불합니다.<br>
        • 환불 요청: master@aicut.co.kr 또는 채팅 상담을 통해 신청하세요.<br>
        • 환불은 요청일로부터 영업일 기준 3~5일 이내 처리됩니다.</p>
        <p><b>② 작업 착수 후 환불</b><br>
        • 에디터가 작업에 착수한 후에는 원칙적으로 환불이 제한됩니다.<br>
        • 단, 회사 귀책 사유로 인한 납품 불가, 심각한 품질 하자 발생 시 협의 후 부분 또는 전액 환불합니다.<br>
        • 이용자가 제공한 원본 파일의 문제(저해상도, 손상 등)로 인한 결과물 품질 저하는 환불 대상이 아닙니다.</p>
        <p><b>③ 환불 불가 사유</b><br>
        • 납품 완료 후 단순 변심에 의한 환불<br>
        • 이용자가 수정 횟수를 모두 소진한 경우<br>
        • 이용자의 귀책 사유로 인한 작업 지연 또는 취소</p>
        <p><b>④ 환불 방법</b><br>
        • 신용카드 결제 시: 카드 취소 처리 (카드사 정책에 따라 2~5 영업일 소요)<br>
        • 계좌이체·가상계좌 결제 시: 이용자가 지정한 계좌로 환불 (3~5 영업일 소요)</p>

        <h3 style="font-size:15px;font-weight:700;color:var(--primary);margin:20px 0 8px">제6조 (수정 및 재작업)</h3>
        <p>• 납품 후 이용자가 요청하는 수정 사항은 원래 요청 범위 내에서 처리됩니다.<br>
        • 원래 요청 범위를 초과하는 수정은 추가 비용이 발생할 수 있습니다.</p>

        <h3 style="font-size:15px;font-weight:700;color:var(--primary);margin:20px 0 8px">제7조 (지식재산권)</h3>
        <p>• 납품 완료된 영상의 저작권은 결제 완료 시점부터 이용자에게 귀속됩니다.<br>
        • 이용자가 제공한 원본 소스의 저작권은 이용자에게 있습니다.<br>
        • 회사는 포트폴리오 목적으로 작업물을 활용할 수 있습니다 (이용자 동의 시).</p>

        <h3 style="font-size:15px;font-weight:700;color:var(--primary);margin:20px 0 8px">제8조 (이용자 의무)</h3>
        <p>• 타인의 저작권을 침해하는 콘텐츠 제작 의뢰 금지<br>
        • 허위 정보 제공 금지<br>
        • 서비스 운영을 방해하는 행위 금지</p>

        <h3 style="font-size:15px;font-weight:700;color:var(--primary);margin:20px 0 8px">제9조 (서비스 중단)</h3>
        <p>회사는 시스템 점검, 불가항력적 사유 등으로 서비스 제공을 일시 중단할 수 있으며, 사전에 공지합니다.</p>

        <h3 style="font-size:15px;font-weight:700;color:var(--primary);margin:20px 0 8px">제10조 (면책조항)</h3>
        <p>회사는 이용자가 서비스를 이용하여 기대하는 수익을 얻지 못하거나 상실한 것에 대해 책임을 지지 않습니다.</p>

        <h3 style="font-size:15px;font-weight:700;color:var(--primary);margin:20px 0 8px">제11조 (분쟁 해결)</h3>
        <p>서비스 이용과 관련한 분쟁은 대한민국 법령을 적용하며, 소송의 관할 법원은 서울중앙지방법원으로 합니다.</p>

        <p style="margin-top:24px;padding:16px;background:var(--gray-50);border-radius:8px;font-size:13px">
        주식회사 온니바이어 | 대표이사 정효진<br>
        사업자등록번호: 353-86-03415<br>
        시행일: ${today}
        </p>
      </div>
    `;
  }

  modal.classList.add('open');
};

function showAuthError(el, msg) {
  if (!el) { showToast('❌ ' + msg); return; }
  el.textContent = msg;
  el.style.display = 'block';
  setTimeout(function() { el.style.display = 'none'; }, 5000);
}

// 로그아웃 (window 버전도 등록)
window.doLogout = doLogout;

// 프로필 저장 — Firebase 버전으로 덮어씀 (위에 정의됨)

// 비밀번호 변경 — 이메일 재설정으로 처리
window.changePassword = function() {
  var session = getSession();
  if (!session || !session.email) return;
  if (!window._fbResetPassword) return;
  window._fbResetPassword(session.email)
    .then(function() { showToast('📧 ' + session.email + '로 비밀번호 변경 이메일을 보냈습니다'); })
    .catch(function() { showToast('이메일 발송에 실패했습니다'); });
};

// 계정 탈퇴
window.deleteAccount = function() {
  if (!confirm('정말 탈퇴하시겠습니까? 모든 데이터가 삭제됩니다.')) return;
  var user = window._fbCurrentUser;
  var done = function() {
    clearSession();
    updateNavState('home');
    showPage('home');
    showToast('탈퇴가 완료되었습니다');
  };
  if (user) {
    user.delete().then(done).catch(function(err) {
      if (err.code === 'auth/requires-recent-login') {
        showToast('보안을 위해 다시 로그인 후 탈퇴해주세요');
      } else {
        done();
      }
    });
  } else {
    done();
  }
};

// 하위 호환
function getUsers() { try { return JSON.parse(localStorage.getItem('aicut_users') || '{}'); } catch { return {}; } }
function saveUsers(u) { localStorage.setItem('aicut_users', JSON.stringify(u)); }


// 로그인 후 클라이언트 화면 초기화
function initClientPage(session) {
  var name  = (session && session.name)  || '회원';
  var email = (session && session.email) || '';

  // 인사말 + 프로필 기본 설정
  var titleEl = document.getElementById('clientWelcomeTitle');
  if (titleEl) titleEl.textContent = '안녕하세요, ' + name + ' 님 👋';

  var pName = document.getElementById('profileName');
  var pEmail = document.getElementById('profileEmail');
  if (pName && !pName.value)  pName.value  = name;
  if (pEmail && !pEmail.value) pEmail.value = email;

  // Firestore 기반 대시보드 로드
  _loadClientDashboard(name, email);
  // 주문 탭 리스너도 미리 등록 (중복 표시 방지를 위해 단일 소스로)
  if (typeof loadClientOrders === 'function') {
    setTimeout(loadClientOrders, 300);
  }
  // 온보딩 가이드 (첫 로그인 시)
  if (typeof window._startGuideIfNeeded === 'function') {
    window._startGuideIfNeeded();
  }
}

// Firestore 리스너 참조 (언마운트용)
var _clientDashboardUnsubscribe = null;

function _loadClientDashboard(name, email) {
  if (!window._db) {
    setTimeout(function() { _loadClientDashboard(name, email); }, 500);
    return;
  }

  var user = window._fbAuth && window._fbAuth.currentUser;
  var uid  = user ? user.uid : null;

  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
    // uid 기준 쿼리 (email fallback)
    var q = uid
      ? fs.query(fs.collection(window._db, 'orders'), fs.where('userId', '==', uid))
      : fs.query(fs.collection(window._db, 'orders'), fs.where('clientEmail', '==', email));

    // getDocs 사용 (onSnapshot과 충돌 방지 — 대시보드는 1회 조회면 충분)
    fs.getDocs(q).then(function(snapshot) {
      var now = new Date();
      var monthStart = new Date(now.getFullYear(), now.getMonth(), 1).getTime();

      var docs = [];
      snapshot.forEach(function(d) { docs.push(d.data()); });

      // 최신순 정렬
      docs.sort(function(a, b) {
        var ta = a.createdAt && a.createdAt.toMillis ? a.createdAt.toMillis() : 0;
        var tb = b.createdAt && b.createdAt.toMillis ? b.createdAt.toMillis() : 0;
        return tb - ta;
      });

      var total   = docs.length;
      var active  = docs.filter(function(o) {
        return ['pending','waiting','payment_pending','editing','review'].includes(o.status);
      }).length;
      var done    = docs.filter(function(o) { return o.status === 'done'; }).length;
      var paidStatuses = ['pending','waiting','editing','review','done'];
      var monthCost = docs.reduce(function(sum, o) {
        var ts = o.createdAt && o.createdAt.toMillis ? o.createdAt.toMillis() : 0;
        // 입금완료 이상인 주문의 price만 합산
        var isPaid = paidStatuses.includes(o.status);
        return sum + (ts >= monthStart && isPaid ? Number(o.price || o.total || 0) : 0);
      }, 0);

      // [2] 통계 카드
      var set = function(id, val) { var el = document.getElementById(id); if (el) el.textContent = val; };
      set('statTotal',  total);
      set('statActive', active);
      set('statDone',   done);
      set('statCost',   '₩' + monthCost.toLocaleString('ko-KR'));

      // [1] 인사말 조건부
      var subEl   = document.getElementById('clientWelcomeSub');
      var guideEl = document.getElementById('onboardingGuide');
      var emptyEl = document.getElementById('dashOrderEmpty');
      var tableEl = document.getElementById('dashOrderTable');

      if (total === 0) {
        if (subEl)   subEl.textContent = '첫 번째 영상 편집을 의뢰해보세요!';
        if (guideEl) guideEl.style.display = 'block';   // [4] 가이드 표시
        if (emptyEl) emptyEl.style.display = 'block';
        if (tableEl) tableEl.style.display = 'none';
      } else {
        if (subEl)   subEl.textContent = '현재 ' + active + '건 진행 중입니다';
        if (guideEl) guideEl.style.display = 'none';    // [4] 가이드 숨김
        if (emptyEl) emptyEl.style.display = 'none';
        if (tableEl) tableEl.style.display = '';

        // [3] 최근 의뢰 현황 (최대 5건)
        var statusMap = {
          payment_pending: ['', '입금 확인 중', 'background:#ede9ff;color:#5c3de8;font-weight:700'],
          pending:  ['badge-pending', '📦 소스대기', 'background:#e0f2fe;color:#0369a1'],
          waiting:  ['badge-pending', '📦 소스대기', 'background:#e0f2fe;color:#0369a1'],
          editing:  ['badge-editing', '편집중', ''],
          review:   ['badge-review',  '검수중', ''],
          done:     ['badge-done',    '납품완료', ''],
        };

        // 단계 인디케이터 HTML
        var makeSteps = function(status) {
          if (typeof window._renderRefSteps === 'function')
            return window._renderRefSteps(status, {showDesc:false});
          return '';
        };

        // 카드형 렌더링
        tableEl.innerHTML = '';
        docs.slice(0, 5).forEach(function(o) {
          var oid  = o.orderId || '-';
          var name = o.title || o.planName || '-';
          var si   = statusMap[o.status] || ['badge-pending','📦 소스대기','background:#e0f2fe;color:#0369a1'];
          var bs   = si[2] ? 'style="'+si[2]+'"' : '';
          var dl   = o.deadlineDate || o.deadline || '';
          var plan = o.planName || '';
          var card = document.createElement('div');
          card.className = 'dash-order-card';
          card.addEventListener('click', (function(id){ return function(){ showClientOrderDetail(id); }; })(oid));
          card.setAttribute('data-status', o.status || '');
          card.innerHTML =
            // ① 헤더: 프로젝트명 + 상태배지
            '<div class="order-card-top">' +
              '<div class="order-card-meta">' +
                '<div class="order-card-title">'+name+'</div>' +
                '<div class="order-card-sub">#'+oid+(plan?' · '+plan:'')+'</div>' +
              '</div>' +
              '<span class="badge '+si[0]+'" '+bs+'>'+si[1]+'</span>' +
            '</div>' +
            // ② 스텝 바
            '<div class="doc-steps">'+makeSteps(o.status)+'</div>' +
            // ③ 납품예정 + 상세 버튼
            '<div class="order-card-footer">' +
              '<span class="order-card-deadline">'+(dl?'📅 '+dl:'')+'</span>' +
              '<button class="doc-btn" onclick="event.stopPropagation();showClientOrderDetail(&quot;'+oid+'&quot;)">상세보기 →</button>' +
            '</div>';
          tableEl.appendChild(card);
        });
      }
    }).catch(function(e) {
      console.error('[Dashboard] Firestore 조회 실패:', e.code, e.message);
    });
  });
}

window.doLogin = function doLogin(type) {
  // ⚠️ 레거시 함수 — 모든 타입 차단
  // admin: Firebase Custom Claims 검증(doAdminLogin)으로만 허용
  // client: Firebase onAuthStateChanged에서만 세션 생성
  closeModal();
  console.warn('[SECURITY] doLogin(' + type + ') blocked — use Firebase Auth');
};

// 페이지 로드 시 세션 복원 + 이메일 확인 토큰 처리
document.addEventListener('DOMContentLoaded', () => {
  handleAdminNav();
  handleClientNav();
  initNetlifyIdentity();

  // ── URL 해시 기반 페이지 복원 ──
  // 예: aicut.co.kr/#admin → 어드민 로그인 후 어드민 페이지 진입
  //     aicut.co.kr/#client → 로그인 후 마이페이지 진입
  //     aicut.co.kr/#pricing → 요금제 페이지 바로 진입
  // 어드민 탭 라우트 맵
  var ADMIN_ROUTE_MAP = {
    'admin':            'a-home',
    'admin/dashboard':  'a-home',
    'admin/kanban':     'a-kanban',
    'admin/orders':     'a-orders',
    'admin/upload':     'a-upload',
    'admin/editors':    'a-editors',
    'admin/members':    'a-users',
    'admin/pricing':    'a-pricing',
    'admin/promo':      'a-promo',
    'admin/b2b':        'a-b2b',
    'admin/revenue':    'a-revenue',
    'admin/accounts':   'a-admins',
  };

  window._pendingAdminTab = null; // 로그인 후 이동할 탭

  // 고객 탭 라우트 맵
  var CLIENT_ROUTE_MAP = {
    'client':          'c-home',
    'client/orders':   'c-orders',
    'client/upload':   'c-new',
    'client/mypage':   'c-profile',
    'client/chat':     'c-chat',
  };

  (function() {
    var hash = window.location.hash.replace('#', '').trim();
    if (!hash) return;

    var isAdminRoute  = hash === 'admin'  || hash.indexOf('admin/')  === 0;
    var isClientRoute = hash === 'client' || hash.indexOf('client/') === 0;
    var isPricing     = hash === 'pricing';

    if (!isAdminRoute && !isClientRoute && !isPricing) return;

    setTimeout(function() {
      if (isPricing) { showPage('pricing'); return; }

      var session = typeof getSession === 'function' ? getSession() : null;

      // ── 어드민 라우트 ──
      if (isAdminRoute) {
        var aTab = ADMIN_ROUTE_MAP[hash] || 'a-home';
        if (session && session.role === 'admin' && window._adminIdToken) {
          showPage('admin');
          if (aTab !== 'a-home') setTimeout(function() { showTab('admin', aTab, null); }, 300);
        } else {
          window._pendingAdminTab = aTab;
          if (typeof openModal === 'function') openModal('admin');
        }
        return;
      }

      // ── 고객 라우트 ──
      if (isClientRoute) {
        var cTab = CLIENT_ROUTE_MAP[hash] || 'c-home';
        if (session && session.role === 'client') {
          // admin이 #client 접속 시 차단
          showPage('client');
          if (cTab !== 'c-home') setTimeout(function() { showTab('client', cTab, null); }, 300);
        } else if (session && session.role === 'admin') {
          // 어드민은 #client 접근 불가 → 어드민 대시보드 유지
          showPage('admin');
        } else {
          window._pendingClientTab = cTab;
          if (typeof openModal === 'function') openModal('login');
        }
      }
    }, 350);
  })();

  // 이메일 확인 토큰 처리
  function handleEmailToken() {
    var search = window.location.search || '';

    // Firebase Action URL 파라미터 파싱
    // ?mode=resetPassword&oobCode=...
    // ?mode=verifyEmail&oobCode=...
    var params = {};
    search.substring(1).split('&').forEach(function(p) {
      var kv = p.split('=');
      if (kv[0]) params[kv[0]] = decodeURIComponent(kv[1] || '');
    });

    var mode    = params.mode    || '';
    var oobCode = params.oobCode || '';

    // 비밀번호 재설정 처리
    if (mode === 'resetPassword' && oobCode) {
      try { window.history.replaceState(null, '', '/'); } catch(e) {}
      showResetPasswordModal(oobCode);
      return;
    }

    // 이메일 인증 처리
    if (mode === 'verifyEmail' && oobCode) {
      showToast('이메일 인증 확인 중...');
      try { window.history.replaceState(null, '', '/'); } catch(e) {}
      // Firebase applyActionCode 사용
      var waitApply = function(attempts) {
        if (!window._fbAuth) {
          if (attempts < 20) { setTimeout(function(){ waitApply(attempts+1); }, 300); return; }
          showToast('인증 서비스 연결 실패. 잠시 후 다시 시도해주세요');
          return;
        }
        import('https://www.gstatic.com/firebasejs/11.6.0/firebase-auth.js')
          .then(function(m) {
            return m.applyActionCode(window._fbAuth, oobCode);
          })
          .then(function() {
            showToast('🎉 이메일 인증이 완료되었습니다! 로그인해주세요');
            setTimeout(function() { openModal('login'); }, 1000);
          })
          .catch(function(err) {
            console.warn('이메일 인증 오류:', err.code);
            showToast('이미 인증됐거나 링크가 만료됐습니다. 로그인해주세요');
            setTimeout(function() { openModal('login'); }, 1000);
          });
      };
      waitApply(0);
      return;
    }

    // 일반 세션 복원
    var session = getSession();
    if (session) {
      updateNavState(session.role);
      if (session.role === 'client') {
        initClientPage(session);
      }
    }
  }

  handleEmailToken();
});

// ===== TABS =====
window.showTab = function showTab(section, tabId, linkEl) {
  // 어드민 탭 클릭 시 세션 자동 갱신 (로그인 모달 방지)
  if (section === 'admin' && window._fbCurrentUser) {
    window._fbCurrentUser.getIdToken(false).then(function(token) {
      window._adminIdToken = token; // 토큰 갱신
    }).catch(function() {});
  }
  const prefix = section === 'client' ? 'c-' : 'a-';
  const pageId = section === 'client' ? 'page-client' : 'page-admin';
  document.querySelectorAll('#'+pageId+' .dash-tab').forEach(t => t.style.display='none');
  document.querySelectorAll('#'+pageId+' .sb-menu a').forEach(a => a.classList.remove('active'));
  const tab = document.getElementById('tab-'+tabId);
  if (tab) tab.style.display = 'block';
  if (linkEl) linkEl.classList.add('active');
  // 탭별 Firestore 자동 조회
  if (section === 'admin') {
    if (tabId === 'a-home'   && typeof startDashboardRefresh === 'function') startDashboardRefresh();
    else if (typeof stopDashboardRefresh === 'function') stopDashboardRefresh();
    if (tabId === 'a-orders' && typeof loadAdminOrders === 'function') loadAdminOrders();
    if (tabId === 'a-editors' && typeof loadEditors === 'function') loadEditors();
    if (tabId === 'a-b2b'    && typeof loadB2BInquiries === 'function') {
      loadB2BInquiries();
      if (typeof loadB2BContracts === 'function') loadB2BContracts();
    }
    if (tabId === 'a-upload' && typeof loadUploadOrders === 'function') loadUploadOrders();
    if (tabId === 'a-users'  && typeof loadAdminUsers  === 'function') loadAdminUsers();
  }
  if (section === 'client') {
    if (tabId === 'c-orders'  && typeof loadClientOrders === 'function') loadClientOrders();
    if (tabId === 'c-profile') {
      var u = window._fbAuth && window._fbAuth.currentUser;
      if (u) {
        var nameEl  = document.getElementById('profileDisplayName');
        var emailEl = document.getElementById('profileDisplayEmail');
        var avatarEl = document.getElementById('profileAvatar');
        var inputName  = document.getElementById('profileName');
        var inputEmail = document.getElementById('profileEmail');
        var displayName = u.displayName || u.email.split('@')[0];
        if (nameEl)  nameEl.textContent  = displayName;
        if (emailEl) emailEl.textContent = u.email;
        if (avatarEl) avatarEl.textContent = displayName.charAt(0).toUpperCase();
        if (inputName  && !inputName.value)  inputName.value  = displayName;
        if (inputEmail && !inputEmail.value) inputEmail.value = u.email;
      }
    }
  }
}

// ── Firestore 주문 목록 실시간 조회 ──
// ── 고객 주문 목록 Firestore 조회 ──
// 내 주문 탭 onSnapshot 리스너 — 중복 실행 방지
var _clientOrdersListeners = [];
var _clientOrdersMerged   = {};
var _clientOrdersTimer    = null;

// 업로드 링크 복사/열기
window.copyUploadLink = function() {
  var link = window._currentUploadLink;
  if (!link) return;
  if (navigator.clipboard) {
    navigator.clipboard.writeText(link).then(function() {
      showToast('📋 링크가 복사되었습니다');
    });
  } else {
    var ta = document.createElement('textarea');
    ta.value = link; document.body.appendChild(ta);
    ta.select(); document.execCommand('copy');
    document.body.removeChild(ta);
    showToast('📋 링크가 복사되었습니다');
  }
};
window.openUploadLink = function() {
  var link = window._currentUploadLink;
  if (link) window.open(link, '_blank');
};

window.loadClientOrders = function loadClientOrders() {
  if (!window._db) {
    var retry = (window._clientOrderRetry || 0) + 1;
    window._clientOrderRetry = retry;
    if (retry <= 6) { setTimeout(loadClientOrders, 500); }
    else { window._clientOrderRetry = 0; }
    return;
  }
  window._clientOrderRetry = 0;

  var user = window._fbAuth && window._fbAuth.currentUser;
  if (!user) { console.warn('[내주문] 로그인 필요'); return; }

  var uid   = user.uid;
  var email = user.email || '';

  // 동일 uid면 재등록 안 함 (중복 방지 핵심)
  if (window._clientOrdersUid === uid && _clientOrdersListeners.length > 0) {
    console.log('[내주문] 이미 등록됨 — 스킵');
    return;
  }
  window._clientOrdersUid = uid;

  // 기존 리스너 전부 해제
  _clientOrdersListeners.forEach(function(u) { try { u(); } catch(e) {} });
  _clientOrdersListeners = [];
  _clientOrdersMerged   = {};
  if (_clientOrdersTimer) { clearTimeout(_clientOrdersTimer); _clientOrdersTimer = null; }

  console.log('[내주문] 리스너 등록 uid:', uid);

  var tableEl = document.getElementById('clientOrderTable');
  var emptyEl = document.getElementById('clientOrderEmpty');

  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {

    var render = function() {
      if (_clientOrdersTimer) clearTimeout(_clientOrdersTimer);
      _clientOrdersTimer = setTimeout(function() {
        if (!tableEl) return;
        tableEl.querySelectorAll('[data-source="client"]').forEach(function(r) { r.remove(); });

        var docs = Object.values(_clientOrdersMerged);
        console.log('[내주문] 렌더링:', docs.length, '건');

        if (docs.length === 0) {
          if (emptyEl) emptyEl.style.display = 'block'; return;
        }
        if (emptyEl) emptyEl.style.display = 'none';

        docs.sort(function(a,b) {
          var ta = a.createdAt && a.createdAt.toMillis ? a.createdAt.toMillis() : 0;
          var tb = b.createdAt && b.createdAt.toMillis ? b.createdAt.toMillis() : 0;
          return tb - ta;
        });

        var statusMap = {
          payment_pending:['','입금 확인 중','background:#ede9ff;color:#5c3de8;font-weight:700'],
          waiting:['badge-pending','📦 소스대기','background:#e0f2fe;color:#0369a1'], pending:['badge-pending','📦 소스대기','background:#e0f2fe;color:#0369a1'],
          editing:['badge-editing','편집중',''], review:['badge-review','검수중',''],
          done:['badge-done','납품완료',''],
        };

        var mkMiniProgress = function(st) {
          if (typeof window._renderRefSteps === 'function')
            return window._renderRefSteps(st, {showDesc:false});
          return '';
        };

        var sEmoji  = { payment_pending:'💳', pending:'📤', waiting:'📤', editing:'✂️', review:'🔍', done:'🎉' };
        var sPhrase = { payment_pending:'결제를 기다리고 있어요!', pending:'소스 파일을 올려주세요!', waiting:'소스 파일을 올려주세요!', editing:'열심히 편집 중이에요! 🔥', review:'꼼꼼하게 확인해주세요!', done:'납품이 완료됐어요! 🎊' };
        docs.forEach(function(o) {
          var oid    = o.orderId || o.id || '-';
          var si     = statusMap[o.status] || ['badge-pending','📦 소스대기','background:#e0f2fe;color:#0369a1'];
          var bs     = si[2] ? 'style="'+si[2]+'"' : '';
          var emoji  = sEmoji[o.status]  || '📁';
          var phrase = sPhrase[o.status] || '';
          var price  = Number(o.price||o.total||0);
          var dl     = o.deadlineDate||o.deadline||'';
          var card   = document.createElement('div');
          card.className = 'order-card';
          card.setAttribute('data-source','client');
          card.addEventListener('click', (function(id){ return function(){ showClientOrderDetail(id); }; })(oid));
          card.setAttribute('data-status', o.status || '');
          card.innerHTML =
            '<div class="order-card-top">'+
              '<div class="order-card-meta">'+
                '<div class="order-card-title">'+(o.title||o.planName||'-')+'</div>'+
                '<div class="order-card-sub">#'+oid+(o.planName?' · '+o.planName:'')+(price?' · ₩'+price.toLocaleString():'')+'</div>'+
              '</div>'+
              '<span class="badge '+si[0]+'" '+bs+'>'+si[1]+'</span>'+
            '</div>'+
            mkMiniProgress(o.status)+
            '<div class="order-card-footer">'+
              '<span class="order-card-deadline">'+(dl?'📅 납품예정 '+dl:'')+'</span>'+
              '<button class="btn btn-outline" style="padding:5px 14px;font-size:12px" '+
                'onclick="event.stopPropagation();showClientOrderDetail(&quot;'+oid+'&quot;)">상세보기 →</button>'+
            '</div>';
          tableEl.appendChild(card);
        });
      }, 200);
    };

    // uid 쿼리
    _clientOrdersListeners.push(fs.onSnapshot(
      fs.query(fs.collection(window._db,'orders'), fs.where('userId','==',uid)),
      function(snap) {
        snap.forEach(function(d){var o=d.data(); _clientOrdersMerged[o.orderId||d.id]=o;});
        render();
      }, function(e){console.warn('[내주문] uid 실패:',e.code);}
    ));

    // email 쿼리 (병렬, 중복은 _clientOrdersMerged로 제거)
    if (email) {
      _clientOrdersListeners.push(fs.onSnapshot(
        fs.query(fs.collection(window._db,'orders'), fs.where('clientEmail','==',email)),
        function(snap) {
          snap.forEach(function(d){var o=d.data(); _clientOrdersMerged[o.orderId||d.id]=o;});
          render();
        }, function(e){console.warn('[내주문] email 실패:',e.code);}
      ));
    }
  });
};

// ── 고객 주문 상세 화면 ──
// 주문 상세 실시간 리스너
var _orderDetailUnsubscribe = null;

var _orderDetailUnsubscribe2 = null; // 문서ID 직접 구독용

window.showClientOrderDetail = function showClientOrderDetail(oid) {
  window._currentClientOrderId = oid;

  // 기존 리스너 모두 해제
  if (_orderDetailUnsubscribe) {
    try { _orderDetailUnsubscribe(); } catch(e) {}
    _orderDetailUnsubscribe = null;
  }
  if (_orderDetailUnsubscribe2) {
    try { _orderDetailUnsubscribe2(); } catch(e) {}
    _orderDetailUnsubscribe2 = null;
  }

  if (!window._db || !oid) return;
  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {

    // 구독1: orderId 필드 쿼리
    var q = fs.query(fs.collection(window._db, 'orders'), fs.where('orderId', '==', oid), fs.limit(1));
    _orderDetailUnsubscribe = fs.onSnapshot(q, function(snap) {
      if (!snap.empty) {
        console.log('[주문상세] orderId 쿼리 구독 — docId:', snap.docs[0].id);
        _renderClientOrderDetail(snap.docs[0].data(), oid);
      }
      // snap.empty여도 구독2(문서ID 직접)에서 처리
    }, function(e) {
      console.warn('[주문상세] orderId 쿼리 실패:', e.code);
    });

    // 구독2: 문서ID 직접 onSnapshot (addDoc 방식 저장 시 대비)
    _orderDetailUnsubscribe2 = fs.onSnapshot(
      fs.doc(window._db, 'orders', oid),
      function(docSnap) {
        if (docSnap.exists()) {
          console.log('[주문상세] 문서ID 직접 구독 — orderId:', docSnap.data().orderId || oid);
          _renderClientOrderDetail(docSnap.data(), oid);
        }
      },
      function(e) {
        // permission-denied는 orderId 필드로 저장된 경우 정상 (구독1이 처리)
        if (e.code !== 'permission-denied') {
          console.warn('[주문상세] 문서ID 직접 구독 실패:', e.code);
        }
      }
    );
  });
};

window._renderClientOrderDetail = function _renderClientOrderDetail(o, oid) {
  // c-orders 탭으로 이동 후 상세 패널 표시
  showTab('client','c-orders',null);
  var listEl   = document.getElementById('order-list');
  var detailEl = document.getElementById('order-detail');
  if (listEl)   { listEl.style.display   = 'none'; }
  if (detailEl) { detailEl.style.display = 'block'; }

  var set = function(id, val) { var el = document.getElementById(id); if (el) el.textContent = val || '-'; };

  // ── 진행 단계 바 — 레퍼런스 스타일 ──
  var stepsV2El = document.getElementById('clientStepProgressV2');
  if (stepsV2El && typeof window._renderRefSteps === 'function') {
    var dl = o.deadlineDate || o.deadline || '';
    stepsV2El.innerHTML = window._renderRefSteps(o.status, {showDesc:true, deadline:dl});
  }

  // ── 다음 해야 할 일 액션 박스 ──
  var actionBox = document.getElementById('clientActionBox');
  if (actionBox) {
    var deadline = o.deadlineDate || o.deadline || '';
    var actionHTML = '';
    if (o.status === 'payment_pending') {
      actionHTML = '<div class="action-box ab-payment">' +
        '<div class="ab-label">💳 지금 해야 할 일</div>' +
        '<div class="ab-title">계좌이체 후 입금 확인을 눌러주세요</div>' +
        '<div class="ab-desc">우리은행 1005-304-593104 · 주식회사 온니바이어<br>입금 후 아래 버튼을 눌러주시면 바로 확인해드려요!</div>' +
        (o.ndaAgreed ? '<div style="font-size:12px;color:#059669;margin:8px 0;display:flex;align-items:center;gap:5px">✅ 기밀유지 약관 동의 완료</div>' : '') +
        '<div class="ab-btns"><button class="ab-btn ab-btn-amber" onclick="notifyPayment()">💳 입금 완료 알림 보내기</button></div>' +
        '</div>';
    } else if (o.status === 'pending' || o.status === 'waiting') {
      var ulk = o.uploadLink || o.driveLink || o.uploadFolderUrl || '';
      if (ulk) {
        // 관리자가 링크 등록 완료 → 링크 표시 + 복사/열기 버튼
        window._currentUploadLink = ulk;
        actionHTML = '<div class="action-box ab-source">' +
          '<div class="ab-label">📤 지금 해야 할 일</div>' +
          '<div class="ab-title">업로드 링크가 준비됐어요!</div>' +
          '<div class="ab-desc">아래 링크에 원본 영상을 올려주시면 바로 편집을 시작할게요 🚀</div>' +
          '<div style="background:white;border:1.5px solid #93c5fd;border-radius:10px;padding:11px 14px;margin-bottom:12px;font-size:12px;word-break:break-all;color:#1d4ed8;font-weight:600">'+ulk+'</div>' +
          '<div class="ab-btns">' +
          '<button class="ab-btn ab-btn-blue" onclick="openUploadLink()">📂 파일 업로드하기</button>' +
          '<button class="ab-btn ab-btn-outline" onclick="copyUploadLink()">🔗 링크 복사</button>' +
          '</div></div>';
      } else {
        // 관리자가 아직 링크 미등록 → 대기 안내
        actionHTML = '<div class="action-box ab-source">' +
          '<div class="ab-label">⏳ 준비 중</div>' +
          '<div class="ab-title">업로드 링크를 준비 중이에요</div>' +
          '<div class="ab-desc">입금 확인 후 이 페이지와 카카오톡 채널로 업로드 링크를 보내드릴게요 😊<br>' +
          '궁금하신 점은 아래 카카오톡 채널로 편하게 문의해 주세요!</div>' +
          '<div class="ab-btns">' +
            '<a href="http://pf.kakao.com/_GIesX/chat" target="_blank" rel="noopener" data-track="카카오 상담" ' +
              'style="display:inline-flex;align-items:center;gap:8px;background:#FEE500;color:#191919;' +
              'font-weight:700;font-size:14px;padding:12px 24px;border-radius:12px;text-decoration:none;' +
              'box-shadow:0 2px 8px rgba(0,0,0,.12)">' +
              '💬 카카오톡으로 문의하기' +
            '</a>' +
          '</div>' +
          '</div>';
      }
    } else if (o.status === 'editing') {
      actionHTML = '<div class="action-box ab-editing">' +
        '<div class="ab-label">✂️ 에디터가 열심히 작업 중이에요!</div>' +
        '<div class="ab-title">잠시만 기다려주세요</div>' +
        '<div class="ab-desc">' +
          (deadline ? '납품 예정: <strong>' + deadline + '</strong><br>' : '') +
          '완료되면 카카오톡으로 안내드릴게요 😊</div>' +
        '</div>';
    } else if (o.status === 'review') {
      actionHTML = ''; // review는 reviewFeedbackPanel이 처리
    } else if (o.status === 'done') {
      actionHTML = '<div class="action-box ab-done">' +
        '<div class="ab-label">🎉 납품이 완료됐어요!</div>' +
        '<div class="ab-title">결과물이 마음에 드셨으면 좋겠어요</div>' +
        '<div class="ab-desc">수정이 필요하시면 아래 버튼을 눌러주세요. 다음 달도 에이컷과 함께해요 💜</div>' +
        '<div class="ab-btns">' +
        '<button class="ab-btn ab-btn-green" onclick="clientRequestRevision()">🔄 수정 요청</button>' +
        '<button class="ab-btn ab-btn-outline" onclick="showTab(&quot;client&quot;,&quot;c-new&quot;,null)">✂️ 새 의뢰 시작</button>' +
        '</div></div>';
    }
    actionBox.innerHTML = actionHTML;
  }

  // ── D-DAY 표시 ──
  var deadlineEl = document.getElementById('cd-deadline');
  if (deadlineEl && (o.deadlineDate || o.deadline)) {
    var dlStr = o.deadlineDate || o.deadline;
    var today  = new Date(); today.setHours(0,0,0,0);
    var dlDate = new Date(dlStr); dlDate.setHours(0,0,0,0);
    var diff   = Math.round((dlDate - today) / 86400000);
    var ddayHtml;
    if (diff > 2)       ddayHtml = '<span class="dday-badge dday-safe">D-' + diff + '</span>';
    else if (diff === 2) ddayHtml = '<span class="dday-badge dday-warn">D-2 ⚠️</span>';
    else if (diff === 1) ddayHtml = '<span class="dday-badge dday-warn">D-1 ⚠️</span>';
    else if (diff === 0) ddayHtml = '<span class="dday-badge dday-today">오늘 납품</span>';
    else                 ddayHtml = '<span class="dday-badge dday-over">납품 지연</span>';
    deadlineEl.innerHTML = dlStr + ddayHtml;
  }

  // 검수 피드백 패널 — status === 'review' 일 때만 표시
  var reviewPanel = document.getElementById('reviewFeedbackPanel');
  if (reviewPanel) {
    reviewPanel.style.display = (o.status === 'review') ? 'block' : 'none';
  }

  set('cd-plan',     o.planName);
  set('cd-editor',   o.editor || '배정 대기 중');
  set('cd-date',     o.createdAt && o.createdAt.toDate ? o.createdAt.toDate().toLocaleDateString('ko-KR') : '-');
  set('cd-deadline', o.deadlineDate || o.deadline);
  set('cd-price',    o.price ? '₩' + Number(o.price).toLocaleString() : '-');
  set('cd-desc',     o.desc);

  // uploadLink — clientActionBox에서 통합 처리 (별도 패널 제거됨)
  var uploadLink = o.uploadLink || o.driveLink || o.uploadFolderUrl || '';
  window._currentUploadLink = uploadLink || '';

  // 진행 단계 업데이트
  var status = o.status || '';
  var spItems = [
    { id: 'sp-link',    active: !uploadLink && status !== 'done',
                        done: !!uploadLink || ['editing','review','done'].includes(status) },
    { id: 'sp-upload',  active: uploadLink && status === 'pending' || status === 'waiting',
                        done: ['editing','review','done'].includes(status) },
    { id: 'sp-editing', active: status === 'editing',
                        done: ['review','done'].includes(status) },
    { id: 'sp-done',    active: status === 'review',
                        done: status === 'done' },
  ];
  spItems.forEach(function(s) {
    var el = document.getElementById(s.id);
    if (!el) return;
    el.className = 'sp-item' + (s.done ? ' done' : (s.active ? ' active' : ''));
    var dot = el.querySelector('.sp-dot');
    if (dot && s.done) dot.textContent = '✓';
  });

      // 수정이력 렌더링
      var revList = document.getElementById('revisionList');
      var planInfo = document.getElementById('revisionPlanInfo');
      if (planInfo) planInfo.textContent = (o.planName || '-');

      if (revList) {
        // revisionRequests(새 방식) 우선, 없으면 revisions(구 방식)
        var revisions = o.revisionRequests || o.revisions || [];
        // revList 안에만 기존 내용 초기화 (appendChild만 사용 — insertBefore 제거)
        revList.innerHTML = '';
        if (revisions.length === 0) {
          revList.innerHTML = '<div style="text-align:center;padding:24px;color:var(--gray-400);font-size:13px">아직 수정 요청이 없습니다</div>';
        } else {
          revisions.forEach(function(rev, idx) {
            var isDone = rev.status === 'completed' || rev.status === 'done';
            var items = rev.items || (rev.content ? [rev.content] : []);
            var dateStr = rev.date || (rev.requestedAt
              ? (typeof rev.requestedAt === 'string'
                  ? new Date(rev.requestedAt).toLocaleDateString('ko-KR')
                  : (rev.requestedAt.toDate ? rev.requestedAt.toDate().toLocaleDateString('ko-KR') : ''))
              : '');
            var itemsHtml = items.map(function(item) {
              return '<div class="rev-item ' + (isDone ? 'done' : 'pending') + '">' +
                '<span class="rev-check ' + (isDone ? '' : 'pend') + '">' + (isDone ? '✓' : '→') + '</span>' +
                item + '</div>';
            }).join('');
            var block = document.createElement('div');
            block.className = 'rev-round ' + (isDone ? 'done' : 'active');
            block.innerHTML =
              '<div class="rev-round-header"><div style="display:flex;align-items:center;gap:8px">' +
              '<span class="rev-num" ' + (isDone ? '' : 'style="background:var(--orange);color:white"') + '>' + (idx+1) + '차</span>' +
              '<span class="rev-date">' + dateStr + '</span></div>' +
              '<span class="badge ' + (isDone ? 'badge-done' : 'badge-pending') + '" style="font-size:11px">' +
              (isDone ? '반영 완료' : '에디터 확인 중') + '</span></div>' +
              '<div class="rev-items">' + itemsHtml + '</div>';
            revList.appendChild(block);
          });
        }
      }
};

// ══════════════════════════════════════════
// 어드민 대시보드 Firestore 실시간 집계
// ══════════════════════════════════════════
window._dashInterval = null;

window.loadAdminDashboard = function loadAdminDashboard() {
  if (!window._db) { setTimeout(loadAdminDashboard, 600); return; }

  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
    // orders 전체 조회 (필터는 클라이언트에서)
    fs.getDocs(fs.collection(window._db, 'orders')).then(function(snap) {
      var all = [];
      snap.forEach(function(d) { all.push(d.data()); });

      var now   = new Date();
      var today = now.toISOString().slice(0,10); // YYYY-MM-DD
      var yyyyMM = today.slice(0,7);             // YYYY-MM

      // ── 이달 첫날/마지막날 ──
      var monthStart = new Date(now.getFullYear(), now.getMonth(), 1).getTime();
      var prevStart  = new Date(now.getFullYear(), now.getMonth()-1, 1).getTime();
      var prevEnd    = monthStart;

      // 매출 집계 대상 status (입금 확인된 것 모두)
      var PAID_STATUSES = ['done', 'review', 'editing', 'pending', 'waiting'];

      var thisMonthRevenue = 0, prevMonthRevenue = 0;
      var activeCount = 0, editingCount = 0, reviewCount = 0;
      var pendingUnassigned = 0, paymentPendingCount = 0;
      var todayDelivery = 0;
      var editorMap = {}; // { 에디터명: 건수 }
      var urgentOrders = [];

      all.forEach(function(o) {
        var status   = o.status || '';
        var editor   = o.editor || '';
        var ts       = o.createdAt && o.createdAt.toMillis ? o.createdAt.toMillis() : 0;
        var dueDate  = o.deadlineDate || o.dueDate || '';
        var price    = Number(o.price || o.total || 0);

        // [1] 이번달 매출 (입금 확인된 주문 모두 — done/editing/review/pending)
        if (PAID_STATUSES.indexOf(status) !== -1 && ts >= monthStart) thisMonthRevenue += price;
        // 전달 매출
        if (PAID_STATUSES.indexOf(status) !== -1 && ts >= prevStart && ts < prevEnd) prevMonthRevenue += price;

        // [2] 진행중 (편집중 + 검수중)
        if (status === 'editing') { activeCount++; editingCount++; }
        if (status === 'review')  { activeCount++; reviewCount++;  }

        // [3] 입금완료(대기중) + 미배정
        if ((status === 'payment_pending' || status === 'pending' || status === 'waiting') && !editor) pendingUnassigned++;

        // [5] 금일 납품 예정
        if (dueDate === today && status !== 'done') todayDelivery++;

        // [8] 입금 확인 대기
        if (status === 'payment_pending') paymentPendingCount++;

        // [7] 에디터별 담당 건수 (진행 중 주문)
        if (editor && (status === 'editing' || status === 'review' || status === 'pending')) {
          editorMap[editor] = (editorMap[editor] || 0) + 1;
        }

        // [6] 즉시 처리 필요 (D-0, D-1, 납품완료 제외)
        if (dueDate && status !== 'done') {
          var due = new Date(dueDate).getTime();
          var diffDays = Math.floor((due - new Date(today).getTime()) / 86400000);
          if (diffDays <= 1) {
            urgentOrders.push({ o: o, diffDays: diffDays });
          }
        }
      });

      // ── 화면 업데이트 ──
      var set = function(id, val) { var el = document.getElementById(id); if (el) el.textContent = val; };

      // [1] 매출
      var revenueStr = thisMonthRevenue >= 1000000
        ? '₩' + (thisMonthRevenue / 1000000).toFixed(1) + 'M'
        : '₩' + thisMonthRevenue.toLocaleString();
      set('dashRevenue', revenueStr);
      if (prevMonthRevenue > 0) {
        var pct = Math.round((thisMonthRevenue - prevMonthRevenue) / prevMonthRevenue * 100);
        set('dashRevenueChange', (pct >= 0 ? '↑ ' : '↓ ') + Math.abs(pct) + '% vs 전달');
      } else {
        set('dashRevenueChange', thisMonthRevenue > 0 ? '이번달 첫 매출' : '매출 없음');
      }

      // [2] 진행중
      set('dashActive', activeCount);
      set('dashActiveChange', '편집중 ' + editingCount + ' / 검수중 ' + reviewCount);

      // [3] 대기중 미배정
      set('dashPending', pendingUnassigned);
      set('dashPendingChange', pendingUnassigned > 0 ? '↑ 즉시 배정 필요' : '✅ 전원 배정됨');

      // [4] 에디터 가동률
      var editorNames = Object.keys(editorMap);
      var totalEditors = 5; // Jason, Luke, Eric, Chris, Victor
      var busyEditors = editorNames.length;
      var rate = Math.round(busyEditors / totalEditors * 100);
      set('dashEditorRate', rate + '%');
      set('dashEditorChange', totalEditors + '명 중 ' + busyEditors + '명 가동');

      // [5] 금일 납품
      set('dashDelivery', todayDelivery + '건');

      // [8] 입금 확인 대기
      var payBadge = document.getElementById('paymentPendingBadge');
      if (payBadge) {
        payBadge.textContent = '💰 입금 확인 대기 ' + paymentPendingCount + '건';
        payBadge.style.display = paymentPendingCount > 0 ? 'block' : 'none';
      }

      // urgentBell
      var totalUrgent = urgentOrders.length + paymentPendingCount;
      set('urgentBell', totalUrgent > 0
        ? '🔴 긴급 ' + totalUrgent + '건 처리 필요'
        : '✅ 긴급 처리 없음');
      var bellEl = document.getElementById('urgentBell');
      if (bellEl) {
        bellEl.style.background = totalUrgent > 0 ? '#fee2e2' : '#d1fae5';
        bellEl.style.color      = totalUrgent > 0 ? '#991b1b' : '#065f46';
      }

      // [6] 즉시 처리 필요 테이블
      var urgentTable = document.getElementById('adminUrgentTable');
      var urgentEmpty = document.getElementById('adminUrgentEmpty');
      if (urgentTable) {
        urgentTable.querySelectorAll('tr[data-urgent]').forEach(function(r) { r.remove(); });
        if (urgentOrders.length === 0) {
          if (urgentEmpty) urgentEmpty.style.display = '';
        } else {
          if (urgentEmpty) urgentEmpty.style.display = 'none';
          var statusLabel = { payment_pending:'결제대기', pending:'소스대기', waiting:'소스대기', editing:'편집중', review:'검수중', done:'납품완료' };
          urgentOrders.sort(function(a,b) { return a.diffDays - b.diffDays; });
          urgentOrders.forEach(function(item) {
            var o = item.o;
            var oid = o.orderId || '-';
            var dDay = item.diffDays === 0 ? '<span style="color:var(--red);font-weight:700">D-0</span>'
                     : '<span style="color:var(--orange);font-weight:700">D-1</span>';
            var statusBadge = { editing:'badge-editing', review:'badge-review', pending:'badge-pending', waiting:'badge-pending' };
            var cls = statusBadge[o.status] || 'badge-pending';
            var tr = document.createElement('tr');
            tr.setAttribute('data-urgent', '1');
            tr.innerHTML =
              '<td style="font-size:12px;color:var(--gray-400)">#' + oid + '</td>' +
              '<td style="font-weight:600">' + (o.clientName || '-') + '</td>' +
              '<td>' + (o.title || o.planName || '-') + '</td>' +
              '<td><span style="font-size:11px;font-weight:700;color:var(--accent)">' + (o.planName || '-') + '</span></td>' +
              '<td><span class="badge ' + cls + '">' + (statusLabel[o.status] || o.status) + '</span></td>' +
              '<td>' + dDay + '</td>' +
              '<td style="font-size:13px">' + (o.editor || '미배정') + '</td>' +
              '<td><button class="btn btn-primary" style="padding:4px 10px;font-size:11px" onclick="window._currentAdminOrderId=&quot;' + oid + '&quot;;showTab(&quot;admin&quot;,&quot;a-orders&quot;,null)">처리</button></td>';
            urgentTable.appendChild(tr);
          });
        }
      }

      // [7] 에디터 현황 카드
      var editorGrid = document.getElementById('dashEditorGrid');
      if (editorGrid) {
        var editorDefs = [
          { name:'Jason', spec:'롱폼 전문',   color:'var(--blue)' },
          { name:'Luke',  spec:'모션그래픽', color:'var(--orange)' },
          { name:'Eric',  spec:'숏폼 전문',   color:'var(--green)' },
          { name:'Chris', spec:'자막/번역',   color:'var(--blue)' },
          { name:'Victor',spec:'CG / VFX',    color:'var(--green)' },
        ];
        var maxLoad = 5;
        editorGrid.innerHTML = editorDefs.map(function(e) {
          var cnt = editorMap[e.name] || 0;
          var pct = Math.min(100, Math.round(cnt / maxLoad * 100));
          var barColor = pct >= 100 ? '#ef4444' : pct >= 80 ? 'var(--orange)' : e.color;
          return '<div style="background:var(--gray-50);border-radius:10px;padding:14px;text-align:center;border:1px solid var(--gray-200)">' +
            '<div style="font-size:13px;font-weight:700;color:var(--primary)">' + e.name + '</div>' +
            '<div style="font-size:11px;color:var(--gray-400);margin:3px 0 8px">' + e.spec + '</div>' +
            '<div style="font-size:20px;font-weight:700;color:' + e.color + '">' + cnt + '건</div>' +
            '<div style="height:4px;background:var(--gray-200);border-radius:2px;margin-top:8px">' +
              '<div style="width:' + pct + '%;height:100%;background:' + barColor + ';border-radius:2px;transition:width 0.5s"></div>' +
            '</div></div>';
        }).join('');
      }

      // B2B 계약 매출도 합산 (b2b_contracts 컬렉션)
      fs.getDocs(fs.collection(window._db, 'b2b_contracts')).then(function(b2bSnap) {
        b2bSnap.forEach(function(d) {
          var c = d.data();
          var ts = c.createdAt && c.createdAt.toMillis ? c.createdAt.toMillis() : 0;
          var amount = Number(c.price || c.amount || c.monthlyFee || 0);
          if (ts >= monthStart) thisMonthRevenue += amount;
          if (ts >= prevStart && ts < prevEnd) prevMonthRevenue += amount;
        });
        // 매출 재계산 후 UI 업데이트
        var revenueStr2 = thisMonthRevenue >= 1000000
          ? '₩' + (thisMonthRevenue / 1000000).toFixed(1) + 'M'
          : '₩' + thisMonthRevenue.toLocaleString();
        set('dashRevenue', revenueStr2);
        if (prevMonthRevenue > 0) {
          var pct2 = Math.round((thisMonthRevenue - prevMonthRevenue) / prevMonthRevenue * 100);
          set('dashRevenueChange', (pct2 >= 0 ? '↑ ' : '↓ ') + Math.abs(pct2) + '% vs 전달');
        }
      }).catch(function() {
        // b2b_contracts 없어도 orders 기반 매출은 표시됨
      });

      console.log('[Dashboard] 갱신 완료 —', all.length, '건, 매출:', revenueStr);
    }).catch(function(e) {
      console.error('[Dashboard] 조회 실패:', e.code, e.message);
    });
  });
};

// 대시보드 탭 진입 시 + 30초 자동 갱신
window.startDashboardRefresh = function() {
  loadAdminDashboard();
  if (window._dashInterval) clearInterval(window._dashInterval);
  window._dashInterval = setInterval(loadAdminDashboard, 30000);
};
// ── 어드민 회원 관리 Firestore 연동 ──
window.loadAdminUsers = function loadAdminUsers() {
  if (!window._db) { setTimeout(loadAdminUsers, 500); return; }
  var tableWrap = document.getElementById('adminUsersTable');
  if (!tableWrap) return;
  var tableEl = tableWrap.querySelector('tbody') || tableWrap;

  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
    // orders 컬렉션에서 주문수 집계
    var orderCount = {};
    fs.getDocs(fs.collection(window._db, 'orders')).then(function(orderSnap) {
      orderSnap.forEach(function(d) {
        var email = d.data().clientEmail || '';
        if (email) orderCount[email] = (orderCount[email] || 0) + 1;
      });
    }).catch(function(){});

    // users 컬렉션 우선 조회 (가입 시 저장된 데이터)
    var usersQ = fs.query(fs.collection(window._db, 'users'), fs.orderBy('createdAt', 'desc'));
    fs.getDocs(usersQ).then(function(userSnap) {
      var rows = [];
      userSnap.forEach(function(d) {
        var u = d.data();
        if (u.email) rows.push({
          name:      u.name || u.email.split('@')[0],
          email:     u.email,
          createdAt: u.createdAt,
          lastLogin: u.lastLogin,
          count:     orderCount[u.email] || 0,
          role:      u.role || 'client',
        });
      });

      // users 컬렉션에 없는 주문자도 추가 (구 데이터 호환)
      fs.getDocs(fs.collection(window._db, 'orders')).then(function(orderSnap) {
        var knownEmails = new Set(rows.map(function(r){ return r.email; }));
        orderSnap.forEach(function(d) {
          var o = d.data();
          var email = o.clientEmail || '';
          if (email && !knownEmails.has(email)) {
            rows.push({
              name:      o.clientName || email.split('@')[0],
              email:     email,
              createdAt: o.createdAt,
              lastLogin: null,
              count:     orderCount[email] || 0,
              role:      'client',
            });
            knownEmails.add(email);
          }
        });

        rows.sort(function(a,b) {
          var ta = a.createdAt && a.createdAt.toMillis ? a.createdAt.toMillis() : 0;
          var tb = b.createdAt && b.createdAt.toMillis ? b.createdAt.toMillis() : 0;
          return tb - ta;
        });

        // 기존 동적 행 제거 후 렌더
        tableEl.querySelectorAll('tr[data-user]').forEach(function(r) { r.remove(); });

      if (rows.length === 0) {
        var tr = document.createElement('tr');
        tr.setAttribute('data-user', '1');
        tr.innerHTML = '<td colspan="5" style="text-align:center;padding:32px;color:var(--gray-400)">가입 회원이 없습니다</td>';
        tableEl.appendChild(tr);
        return;
      }

      rows.forEach(function(u) {
        var dateStr   = u.createdAt && u.createdAt.toDate ? u.createdAt.toDate().toLocaleDateString('ko-KR') : '-';
        var loginStr  = u.lastLogin && u.lastLogin.toDate ? u.lastLogin.toDate().toLocaleDateString('ko-KR') : '-';
        var provider  = u.provider === 'kakao' ? '카카오' : u.provider === 'naver' ? '네이버' : u.provider === 'google' ? 'Google' : '이메일';
        var statusBadge = u.status === 'active' ? '<span class="badge badge-done">활성</span>' : '<span class="badge badge-pending">-</span>';
        var loginCnt  = u.loginCount || '-';
        var tr = document.createElement('tr');
        tr.setAttribute('data-user', u.email);
        tr.innerHTML =
          '<td style="font-weight:600">' + u.name + '</td>' +
          '<td style="font-size:13px;color:var(--gray-500)">' + u.email + '</td>' +
          '<td style="font-size:12px;color:var(--gray-400)">' + provider + '</td>' +
          '<td style="font-size:13px;color:var(--gray-400)">' + dateStr + '</td>' +
          '<td style="font-size:13px;color:var(--gray-400)">' + loginStr + '</td>' +
          '<td style="font-size:13px;text-align:center">' + loginCnt + '</td>' +
          '<td>' + statusBadge + '</td>' +
          '<td style="font-family:monospace;font-weight:600;color:var(--accent)">' + u.count + '건</td>';
        tableEl.appendChild(tr);
      });
      console.log('[회원관리] ' + rows.length + '명 로드');
      }); // orders getDocs end
    }); // users getDocs end
  });
};

window.stopDashboardRefresh = function() {
  if (window._dashInterval) { clearInterval(window._dashInterval); window._dashInterval = null; }
};

window.loadAdminOrders = function loadAdminOrders() {
  if (!window._db) {
    var retry = (window._loadOrdersRetry || 0) + 1;
    window._loadOrdersRetry = retry;
    if (retry <= 6) { setTimeout(loadAdminOrders, 500); }
    else { window._loadOrdersRetry = 0; console.warn('[Firestore] DB 초기화 실패'); }
    return;
  }
  window._loadOrdersRetry = 0;

  var emptyRow = document.getElementById('adminOrderEmptyRow');
  if (emptyRow) { emptyRow.style.display = ''; emptyRow.cells[0].textContent = '🔄 데이터 조회 중...'; }

  // 어드민 인증 상태 확인
  var adminUser = window._fbAuth && window._fbAuth.currentUser;
  if (!adminUser) {
    console.warn('[loadAdminOrders] 로그인 필요');
    return;
  }

  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
    var q = fs.query(
      fs.collection(window._db, 'orders'),
      fs.orderBy('createdAt', 'desc'),
      fs.limit(100)
    );
    // onSnapshot으로 실시간 반영
    if (window._adminOrdersUnsubscribe) {
      try { window._adminOrdersUnsubscribe(); } catch(e) {}
    }
    window._adminOrdersUnsubscribe = fs.onSnapshot(q, function(snapshot) {
      var tbody = document.getElementById('adminOrderTable');
      if (!tbody) return;
      tbody.querySelectorAll('tr[data-source="firestore"]').forEach(function(r) { r.remove(); });

      var emptyRow = document.getElementById('adminOrderEmptyRow');
      if (snapshot.empty) {
        if (emptyRow) { emptyRow.style.display = ''; emptyRow.cells[0].textContent = '📭 접수된 주문이 없습니다'; }
        return;
      }
      if (emptyRow) emptyRow.style.display = 'none';

      var statusMap = {
        payment_pending: ['badge-pending', '💳 결제대기', 'background:#fef3c7;color:#92400e'],
        waiting: ['badge-pending', '📦 소스대기', 'background:#e0f2fe;color:#0369a1'],
        pending: ['badge-pending', '📦 소스대기', 'background:#e0f2fe;color:#0369a1'],
        editing: ['badge-editing', '편집중', ''],
        review:  ['badge-review',  '검수중', ''],
        done:    ['badge-done',    '납품완료',''],
      };

      snapshot.forEach(function(docSnap) {
        var o = docSnap.data();
        var oid = o.orderId || docSnap.id;
        var si = statusMap[o.status] || ['badge-pending', '📦 소스대기', 'background:#e0f2fe;color:#0369a1'];
        var cls = si[0], txt = si[1], bStyle = si[2] ? 'style="' + si[2] + '"' : '';

        var createdStr = '-';
        if (o.createdAt && o.createdAt.toDate) {
          var d = o.createdAt.toDate();
          createdStr = (d.getMonth()+1) + '/' + d.getDate() + ' ' +
            String(d.getHours()).padStart(2,'0') + ':' + String(d.getMinutes()).padStart(2,'0');
        }

        var tr = document.createElement('tr');
        tr.setAttribute('data-s', o.status || 'pending');
        tr.setAttribute('data-source', 'firestore');
        tr.innerHTML =
          '<td style="font-family:Pretendard,sans-serif;font-size:12px;color:var(--gray-400)">#' + oid + '</td>' +
          '<td style="font-weight:600;font-size:13px">' + (o.clientName || '-') + '</td>' +
          '<td style="font-size:11px;color:var(--gray-400)">' + (o.clientEmail || o.userId || '-') + '</td>' +
          '<td><span style="font-size:12px;font-weight:700;color:var(--accent)">' + (o.planName || '-') + '</span></td>' +
          '<td style="font-family:Pretendard,sans-serif;font-size:13px;font-weight:600">₩' + ((o.price || o.total || 0).toLocaleString()) + '</td>' +
          '<td style="font-size:12px;color:var(--gray-600)">' + (o.type || '-') + '</td>' +
          '<td style="font-size:12px;color:var(--gray-400)">' + (o.deadlineDate || o.deadline || '-') + '</td>' +
          '<td style="font-size:11px;color:var(--gray-400);white-space:nowrap">' + createdStr + '</td>' +
          '<td><span class="badge ' + cls + '" ' + bStyle + '>' + txt + '</span></td>' +
          '<td><select class="form-select" style="padding:5px 8px;font-size:11px;border-radius:8px;min-width:80px" onchange="adminChangeOrderStatusFromSelect(this,&quot;' + oid + '&quot;,&quot;' + docSnap.id + '&quot;)">' +
            '<option value="">변경</option>' +
            '<option value="payment_pending">💳 결제대기</option>' +
            '<option value="pending">📦 소스대기</option>' +
            '<option value="editing">✂️ 편집중</option>' +
            '<option value="review">🔍 검수중</option>' +
            '<option value="done">✅ 납품완료</option>' +
          '</select></td>' +
          '<td><button class="btn btn-outline" style="padding:5px 10px;font-size:11px;white-space:nowrap" onclick="window._currentAdminOrderId=&quot;' + oid + '&quot;;showAdminOrderDetail()">상세</button></td>' +
          '<td><button class="btn" style="padding:5px 10px;font-size:11px;background:#fef2f2;color:var(--red);border:1px solid #fecaca;border-radius:8px;white-space:nowrap" onclick="deleteAdminOrder(&quot;' + docSnap.id + '&quot;,&quot;' + oid + '&quot;,this)">삭제</button></td>';
        tbody.appendChild(tr);
      });
      console.log('[Firestore] 주문 ' + snapshot.size + '건 로드 완료');
    }, function(e) {
      console.error('[Firestore] 주문 조회 실패:', e.code, e.message);
      var emptyRow = document.getElementById('adminOrderEmptyRow');
      if (emptyRow) {
        emptyRow.style.display = '';
        emptyRow.cells[0].textContent = e.code === 'permission-denied'
          ? '❌ 권한 오류 — Firestore 규칙을 확인해주세요.'
          : '❌ 조회 실패: ' + (e.code || e.message);
      }
    }, function(snapErr) {
      console.error('[Firestore] onSnapshot 에러:', snapErr.code, snapErr.message);
      if (snapErr.code === 'permission-denied') {
        console.warn('[Firestore] 권한 없음 — 어드민 계정 확인 필요');
      }
    });
  });
};

// ===== CLIENT ORDER DETAIL =====
window.showOrderDetail = function showOrderDetail() {
  showTab('client','c-orders',null);
  document.getElementById('order-detail').style.display='block';
  document.getElementById('order-list').style.display='none';
}

// ===== CHAT =====
const autoReplies = [
  '네, 확인했습니다! 담당자가 곧 안내드릴게요 😊',
  '감사합니다. 빠른 시일 내 연락드리겠습니다!',
  '해당 내용은 PREMIUM 플랜에서 가능합니다. 더 궁금한 점 있으시면 편하게 말씀해 주세요.',
  '요청하신 내용 반영하겠습니다. 잠시만 기다려 주세요!',
];
let replyIdx = 0;

function sendMsg(chatId, inputId, isSupport) {
  const inp = document.getElementById(inputId);
  const msg = inp.value.trim();
  if (!msg) return;
  const chat = document.getElementById(chatId);
  chat.innerHTML += `<div class="msg me"><div class="msg-avatar">👤</div><div><div class="msg-bubble">${msg}</div><div class="msg-time">나 · 방금</div></div></div>`;
  chat.scrollTop = chat.scrollHeight;
  inp.value = '';
  setTimeout(() => {
    const r = isSupport ? autoReplies[replyIdx++ % autoReplies.length] : '확인했습니다! 요청사항 반영하겠습니다 😊';
    chat.innerHTML += `<div class="msg"><div class="msg-avatar">🎬</div><div><div class="msg-bubble">${r}</div><div class="msg-time">${isSupport?'운영팀':'Jason'} · 방금</div></div></div>`;
    chat.scrollTop = chat.scrollHeight;
  }, 700);
}

// ===== ADMIN =====
window.filterAdmin = function filterAdmin(status) {
  document.querySelectorAll('#adminOrderTable tr[data-s]').forEach(r => {
    r.style.display = (status==='all' || r.dataset.s===status) ? '' : 'none';
  });
}

window.changeStatus = function changeStatus(btn, newStatus, label, cls) {
  const row = btn.closest('tr');
  const badge = row.querySelector('.badge');
  badge.className = 'badge '+cls;
  badge.textContent = label;
  row.dataset.s = newStatus;
  showToast('상태가 변경되었습니다: ' + label);
}

// ===== TOAST =====
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 3000);
}

// ===== DRAG & DROP =====
const uploadZone = document.querySelector('.upload-zone');
if (uploadZone) {
  uploadZone.addEventListener('dragover', e => { e.preventDefault(); uploadZone.classList.add('drag'); });
  uploadZone.addEventListener('dragleave', () => uploadZone.classList.remove('drag'));
  uploadZone.addEventListener('drop', e => {
    e.preventDefault();
    uploadZone.classList.remove('drag');
    showToast('파일이 업로드되었습니다 ✓');
  });
}

// ===== COUNTER ANIMATION =====
function animateCounter(el) {
  const target = parseInt(el.dataset.target);
  const suffix = el.dataset.suffix || '';
  const duration = 1800;
  const startTime = performance.now();
  function formatNum(n) { return n.toLocaleString('ko-KR'); }
  function easeOutExpo(t) { return t === 1 ? 1 : 1 - Math.pow(2, -10 * t); }
  function step(now) {
    const elapsed = now - startTime;
    const progress = Math.min(elapsed / duration, 1);
    const current = Math.floor(easeOutExpo(progress) * target);
    el.textContent = formatNum(current) + suffix;
    if (progress < 1) requestAnimationFrame(step);
    else { el.textContent = formatNum(target) + suffix; }
  }
  requestAnimationFrame(step);
}
const counterObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.querySelectorAll('.counter').forEach((c, i) => {
        setTimeout(() => animateCounter(c), i * 120);
      });
      counterObserver.unobserve(entry.target);
    }
  });
}, { threshold: 0.3 });
const statsSection = document.getElementById('statsSection');
if (statsSection) counterObserver.observe(statsSection);

window.showAdminOrderDetail = function showAdminOrderDetail(orderId) {
  if (orderId) {
    window._currentAdminOrderId = orderId;
  } else {
    var tr = event && event.target ? event.target.closest('tr') : null;
    if (tr) {
      var idCell = tr.querySelector('td:first-child');
      if (idCell) window._currentAdminOrderId = idCell.textContent.replace('#','').trim();
    }
  }

  var oid = window._currentAdminOrderId;
  document.getElementById('admin-order-list').style.display = 'none';
  document.getElementById('admin-order-detail').style.display = 'block';

  if (!oid) return;

  // Firestore에서 실제 데이터 조회
  if (!window._db) { console.warn('[상세] Firestore 미초기화'); return; }

  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
    // orderId 필드로 쿼리 (addDoc 사용 시 문서ID와 orderId 다를 수 있음)
    var q = fs.query(
      fs.collection(window._db, 'orders'),
      fs.where('orderId', '==', oid),
      fs.limit(1)
    );
    fs.getDocs(q).then(function(snap) {
      var data = null;
      if (!snap.empty) {
        data = snap.docs[0].data();
      } else {
        // orderId 필드가 없으면 문서 ID로 직접 조회
        return fs.getDoc(fs.doc(window._db, 'orders', oid)).then(function(docSnap) {
          if (docSnap.exists()) fillAdminOrderDetail(docSnap.data(), oid);
          else console.warn('[상세] 문서 없음:', oid);
        });
      }
      if (data) fillAdminOrderDetail(data, oid);
    }).catch(function(e) {
      console.error('[상세] 조회 실패:', e.code, e.message);
    });
  });
};

// 어드민 주문 상세 화면 데이터 채우기
window.fillAdminOrderDetail = function fillAdminOrderDetail(o, oid) {
  var statusMap = {
    payment_pending: ['badge-pending', '💳 결제대기', '#fef3c7', '#92400e'],
    waiting: ['badge-pending', '📦 소스대기', 'background:#e0f2fe;color:#0369a1', '#0369a1'],
    pending: ['badge-pending', '📦 소스대기', 'background:#e0f2fe;color:#0369a1', '#0369a1'],
    editing: ['badge-editing', '편집중', '', ''],
    review:  ['badge-review',  '검수중', '', ''],
    done:    ['badge-done',    '납품완료', '', ''],
  };
  var si = statusMap[o.status] || ['badge-pending', '📦 소스대기', 'background:#e0f2fe;color:#0369a1', '#0369a1'];

  // 동적 ID로 직접 채우기
  var setEl = function(id, val) { var el = document.getElementById(id); if (el) el.textContent = val || '-'; };
  setEl('adminDetailOrderNum', '#' + (o.orderId || oid));
  setEl('adminDetailTitle',    o.title || o.planName || '-');
  setEl('ad-client',   o.clientName  || '-');
  setEl('ad-email',    o.clientEmail || '-');
  setEl('ad-plan',     o.planName    || '-');
  setEl('ad-price',    o.price ? '₩' + Number(o.price).toLocaleString() : '-');
  // 증빙 서류 + NDA — renderTaxInfo 단일 함수로 처리
  if (typeof window.renderTaxInfo === 'function') window.renderTaxInfo(o);

  // detail-grid 증빙 표시 (taxType 라벨 + 상세값)
  var _taxLabelMap = { tax:'🧾 세금계산서', receipt:'🧾 현금영수증', cash:'🧾 현금영수증', none:'필요없음' };
  var _payTaxType  = o.taxType || '';
  setEl('ad-taxtype', _taxLabelMap[_payTaxType] || '미선택');
  var taxValEl2  = document.getElementById('ad-taxvalue');
  var taxValRow2 = document.getElementById('ad-taxvalue-row');
  var taxDetail  = '';
  if (_payTaxType === 'tax') {
    var bizNum = o.taxBizNum || o.taxBiznum || '';
    if (bizNum)      taxDetail += bizNum;
    if (o.taxCompany)taxDetail += (taxDetail ? ' / ' : '') + o.taxCompany;
    if (o.taxEmail)  taxDetail += (taxDetail ? ' / ' : '') + o.taxEmail;
  } else if (_payTaxType === 'receipt' || _payTaxType === 'cash') {
    var rv = o.receiptNum || o.taxValue || '';
    if (rv) taxDetail = (o.receiptType === 'biznum' ? '사업자: ' : '휴대폰: ') + rv;
  }
  if (taxDetail && taxValEl2) {
    setEl('ad-taxvalue', taxDetail);
    if (taxValRow2) taxValRow2.style.display = '';
  } else {
    if (taxValRow2) taxValRow2.style.display = 'none';
  }
  // NDA
  var ndaEl2 = document.getElementById('ad-nda');
  if (ndaEl2) ndaEl2.innerHTML = o.ndaAgreed
    ? '<span style="color:#059669;font-weight:700">✅ 동의완료</span>'
    : '<span style="color:#9ca3af">미동의</span>';
  setEl('ad-editor',   o.editor || '미배정');
  // 에디터 배정 드롭다운 Firestore 에디터로 채우기
  if (typeof window.populateEditorSelect === 'function') window.populateEditorSelect(o.editor || '');
  setEl('ad-deadline', o.deadlineDate || o.deadline || '-');
  setEl('ad-type',     o.type || '-');
  setEl('ad-desc',     o.desc || '-');
  // 레퍼런스 URL
  var refLinkEl = document.getElementById('ad-ref-link');
  if (refLinkEl) {
    if (o.ref && o.ref.startsWith('http')) {
      refLinkEl.href        = o.ref;
      refLinkEl.textContent = o.ref;
      refLinkEl.style.display = '';
    } else {
      refLinkEl.textContent = o.ref || '없음';
      refLinkEl.removeAttribute('href');
      refLinkEl.style.color = 'var(--gray-400)';
    }
  }

  // 상태 배지
  var badgeEl = document.getElementById('adminDetailBadge');
  if (badgeEl) {
    badgeEl.className = 'badge ' + si[0];
    badgeEl.textContent = si[1];
    if (si[2]) { badgeEl.style.background = si[2]; badgeEl.style.color = si[3]; }
  }

  // adminTaxInfo (빠른 액션 패널) — renderTaxInfo가 이미 처리함

  // 입금대기 상태면 확인 블록 표시
  var payBlock = document.getElementById('adminPayConfirmBlock');
  if (payBlock) {
    payBlock.style.display = o.status === 'payment_pending' ? 'block' : 'none';
  }

  // 어드민 수정이력 패널 플랜정보
  var adminRevPlan = document.getElementById('adminRevPlanInfo');
  if (adminRevPlan) adminRevPlan.textContent = (o.planName || '-');

  // 에디터 select 현재값 반영
  var editorOpt = document.getElementById('adminEditorCurrent');
  if (editorOpt) editorOpt.textContent = o.editor || '미배정';

  // 수정이력 동적 렌더링
  var revListEl = document.getElementById('adminRevisionList');
  var revCountEl = document.getElementById('adminRevCount');
  if (revListEl) {
    var revs = o.revisions || [];
    if (revCountEl) revCountEl.textContent = revs.length > 0 ? revs.length + '회 진행' : '';
    var revSource = o.revisionRequests || revs;
    if (revCountEl) revCountEl.textContent = revSource.length > 0 ? revSource.length + '회 진행' : '';
    if (revSource.length === 0) {
      revListEl.innerHTML = '<div style="text-align:center;padding:24px;color:var(--gray-400);font-size:13px">아직 수정 요청이 없습니다</div>';
    } else {
      revListEl.innerHTML = revSource.map(function(rev, idx) {
        var isDone = rev.status === 'completed' || rev.status === 'done';
        var items = rev.items || (rev.content ? [rev.content] : []);
        var dateStr = rev.date || (rev.requestedAt && rev.requestedAt.toDate
          ? rev.requestedAt.toDate().toLocaleDateString('ko-KR') : '');
        var itemsHtml = items.map(function(item) {
          return '<div class="rev-item ' + (isDone ? 'done' : 'pending') + '">' +
            '<span class="rev-check ' + (isDone ? '' : 'pend') + '">' + (isDone ? '✓' : '→') + '</span>' + item + '</div>';
        }).join('');
        var completeBtn = !isDone
          ? '<button class="btn btn-outline" style="font-size:11px;padding:3px 10px" ' +
            'onclick="adminCompleteRevision(' + idx + ',&quot;' + oid + '&quot;)">완료 처리</button>' : '';
        return '<div class="rev-round ' + (isDone ? 'done' : 'active') + '">' +
          '<div class="rev-round-header"><div style="display:flex;align-items:center;gap:8px">' +
          '<span class="rev-num" ' + (isDone ? '' : 'style="background:var(--orange);color:white"') + '>' + (idx+1) + '차</span>' +
          '<span class="rev-date">' + dateStr + '</span></div>' +
          '<div style="display:flex;align-items:center;gap:6px">' +
          '<span class="badge ' + (isDone ? 'badge-done' : 'badge-pending') + '" style="font-size:11px">' +
          (isDone ? '반영 완료' : '확인 중') + '</span>' + completeBtn + '</div>' +
          '</div><div class="rev-items">' + itemsHtml + '</div></div>';
      }).join('');
    }
  }

  console.log('[상세] 데이터 로드 완료:', oid, o.status);
};

// ===== 정보 모달 (FAQ / 이용 가이드 / 에디터 지원) =====
