/* ===== VFX 섹션 Scroll-driven Zoom ===== */
(function() {
  function initVfxScroll() {
    var sec  = document.getElementById('vfx-section');
    var vid  = document.getElementById('vfxBgVideo');
    var ovl  = document.getElementById('vfxOverlay');
    var els  = ['vfxEyebrow','vfxTitle','vfxDesc','vfxTags','vfxCta'].map(function(id){ return document.getElementById(id); });
    if (!sec || !vid) return;

    var entered = false;

    function onScroll() {
      var rect = sec.getBoundingClientRect();
      var wh   = window.innerHeight;

      // 섹션이 뷰포트 안에 있는 비율 (0~1)
      var visible = Math.max(0, Math.min(1, (wh - rect.top) / (wh + rect.height)));

      // 진입 애니메이션 — 50% 이상 보이면 트리거
      if (visible > 0.3 && !entered) {
        entered = true;
        els.forEach(function(el){ if(el){ el.style.opacity='1'; el.style.transform='translateY(0)'; } });
      }
      if (visible < 0.1 && entered) {
        entered = false;
        els.forEach(function(el){ if(el){ el.style.opacity='0'; } });
      }

      // scroll-driven zoom — 섹션 중앙 통과 시 scale 1.15 → 1.0
      var progress = Math.max(0, Math.min(1, (wh - rect.top) / wh));
      var scale    = 1.15 - progress * 0.15;  // 1.15 → 1.0
      vid.style.transform = 'scale(' + scale.toFixed(3) + ')';

      // 오버레이 밝기 — 진입할수록 살짝 어두워졌다 밝아짐
      var alpha = 0.45 - progress * 0.1;
      if (ovl) ovl.style.background = 'rgba(0,0,0,' + alpha.toFixed(2) + ')';
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll(); // 초기 실행
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVfxScroll);
  } else {
    initVfxScroll();
  }
})();

/* ===== 주문 요약 업데이트 ===== */
window.updateOrderSummary = function() {
  var sel = document.getElementById('newOrderPlan');
  var dlSel = document.getElementById('newOrderDeadline');
  if (!sel) return;
  var parts = sel.value.split('|');
  var planKey = parts[0];
  var basePrice = parseInt(parts[1]) || 0;
  var isExpress = dlSel && dlSel.value === 'express';
  var expressAmt = isExpress ? Math.round(basePrice * 0.5) : 0;
  var price = basePrice + expressAmt;

  var PKG = {
  "STARTER": {name:"STARTER 월 정기",title:"STARTER 패키지 포함 내역",items:["월 4편 정기 편집","전담 에디터 1명 배정","컷편집 + 자막 + BGM","편당 2회 무료 수정","브랜드 가이드 저장","영업일 3~5일"]},
  "STANDARD": {name:"STANDARD 월 정기",title:"STANDARD 패키지 포함 내역",items:["월 10편 정기 편집","전담 에디터 1명 배정","STARTER 전체 포함 (썸네일 디자인 포함)","모션그래픽 · 인트로/아웃트로","편당 3회 무료 수정","영업일 3~5일"]},
  "ENTERPRISE": {name:"ENTERPRISE 맞춤 협의",title:"ENTERPRISE 패키지 포함 내역",items:["월 20편 이상","STANDARD 전체 포함","전용 작업 채널 운영","모션그래픽 · CG · VFX","무제한 수정","건당 단가 최대 35% 할인"]},
  "STANDARD_1": {name:"건당 STANDARD",title:"건당 STANDARD 포함 내역",items:["완성본 10분 이내","컷편집 + 자막 + BGM","타이포그래피 디자인","2회 무료 수정"]},
  "PRO_1": {name:"건당 PRO",title:"건당 PRO 포함 내역",items:["완성본 30분 이내","STANDARD 전체 포함","컬러그레이딩","모션그래픽 · 인트로/아웃트로","3회 무료 수정"]},
  "SHORTFORM_1": {name:"건당 숏폼",title:"건당 숏폼 포함 내역",items:["완성본 60초 이내","컷편집 + 자막 + BGM","세로형 최적화","1회 무료 수정"]},
};

  var pkg = PKG[planKey] || PKG['STARTER'];
  var vat = Math.round(price * 0.1);
  var total = price + vat;

  var sn  = document.getElementById('sumPlanName');
  var sb  = document.getElementById('sumBase');
  var sv  = document.getElementById('sumVat');
  var st  = document.getElementById('sumTotal');
  var spt = document.getElementById('sumPkgTitle');
  var spl = document.getElementById('sumPkgList');
  var ser = document.getElementById('sumExpressRow');
  var sea = document.getElementById('sumExpress');

  if (sn) sn.textContent = pkg.name;
  if (sb) sb.textContent = basePrice === 0 ? '맞춤 협의' : '₩' + basePrice.toLocaleString('ko-KR');
  if (ser) ser.style.display = isExpress ? 'flex' : 'none';
  if (sea) sea.textContent = '₩' + expressAmt.toLocaleString('ko-KR');
  if (sv) sv.textContent = basePrice === 0 ? '협의 후 결정' : '₩' + vat.toLocaleString('ko-KR');
  if (st) st.textContent = basePrice === 0 ? '맞춤 협의' : '₩' + total.toLocaleString('ko-KR');
  if (spt) spt.textContent = pkg.title;
  if (spl) spl.innerHTML = pkg.items.map(function(i) { return '<div>✓ ' + i + '</div>'; }).join('');
};

window.scrollTo_ = function(id) {
  var NAV_H = 52;
  function doScroll() {
    var el = document.querySelector(id);
    if (!el) return;
    var top = el.getBoundingClientRect().top + window.pageYOffset - NAV_H;
    window.scrollTo({ top: top, behavior: 'smooth' });
  }
  var homePage = document.getElementById('page-home');
  var isHome = homePage && homePage.classList.contains('active');
  if (!isHome) {
    showPage('home');
    setTimeout(doScroll, 350);
  } else {
    doScroll();
  }
};
window.openB2B = window.openB2B || function() { document.getElementById('b2bModal')?.classList.add('open'); };
window.openInfoModal = window.openInfoModal || function() {};

window.showTab = window.showTab || function(s,t) {
  const pre = s==='client'?'c-':'a-';
  const pid = s==='client'?'page-client':'page-admin';
  document.querySelectorAll('#'+pid+' .dash-tab').forEach(el=>el.style.display='none');
  const tab = document.getElementById('tab-'+t);
  if(tab) tab.style.display='block';
};
// ===== PAGE & NAVIGATION =====
window.showPage = function showPage(id) {
  const session = getSession();

  // ── 어드민 페이지: Firebase Custom Claims 동기 검증 ──
  if (id === 'admin') {
    const fbUser = window._fbCurrentUser;
    // _adminIdToken 없거나 Firebase 미로그인이면 모달
    if (!window._adminIdToken || !fbUser) {
      if (typeof openModal === 'function') openModal('admin');
      return;
    }
    // session role도 admin이어야 함 (localStorage 조작 방지)
    if (!session || session.role !== 'admin') {
      window._adminIdToken = null;
      if (typeof openModal === 'function') openModal('admin');
      return;
    }
    // 백그라운드에서 claims 재검증 (위변조 감지)
    fbUser.getIdTokenResult(true).then(function(result) {
      if (result.claims.admin !== true || !window.ADMIN_EMAILS || window.ADMIN_EMAILS.indexOf(fbUser.email) === -1) {
        window._adminIdToken = null;
        window._adminClaimRole = null;
        clearSession();
        showPage('home');
        showToast('⛔ 관리자 권한이 확인되지 않습니다.');
      } else {
        window._adminIdToken   = result.token;
        window._adminClaimRole = result.claims.role || 'ops';
      }
    }).catch(function() {
      window._adminIdToken = null;
      clearSession();
      showPage('home');
      showToast('⛔ 세션이 만료되었습니다. 다시 로그인해주세요.');
    });
  }

  // ── 클라이언트 페이지 ──
  if (id === 'client') {
    if (!session) {
      // 비로그인 → 로그인 모달
      if (typeof openModal === 'function') openModal('login');
      return;
    }
    if (session.role === 'admin') {
      // 어드민 계정으로 client 접근 시도 → 어드민 페이지로 리다이렉트
      id = 'admin';
    }
  }

  // ── home/pricing: 누구나 접근 가능 (세션 무관) ──
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById('page-'+id).classList.add('active');
  window.scrollTo(0,0);

  // URL 해시 동기화 (공유 가능한 링크 생성)
  // home은 깔끔하게 # 없이, 나머지는 #page 형태
  if (id === 'home') {
    try { window.history.replaceState({page: id}, '', window.location.pathname); } catch(e) {}
  } else {
    try { window.history.replaceState({page: id}, '', '#' + id); } catch(e) {}
  }
  document.getElementById('mainNav').style.display = (id === 'home' || id === 'pricing') ? 'flex' : 'none';
  var nav = document.getElementById('mainNav');
  if (nav) {
    if (id === 'pricing') {
      nav.classList.remove('nav-top');
      nav.classList.add('nav-scrolled');
      // nav-top 인라인 스타일 제거
      nav.querySelectorAll('.nav-item > a').forEach(function(a) {
        a.style.removeProperty('color');
      });
    } else if (id === 'home') {
      // home 진입 시 scroll 기반으로 재설정
      nav.classList.remove('nav-scrolled');
    }
  }
  var sf = document.getElementById('shared-footer');
  if (sf) sf.style.display = (id === 'home' || id === 'pricing') ? 'block' : 'none';
  updateNavState(id);
  // 네비 요금제 링크 active 표시
  document.querySelectorAll('.nav-links a').forEach(a => a.style.fontWeight = '');
  // nav-item 색상 — pricing은 dark 색상 강제 적용
  document.querySelectorAll('.nav-item > a').forEach(function(a) {
    if (id === 'pricing') {
      a.style.setProperty('color', '#2d2d4e', 'important');
      a.style.fontWeight = '500';
    } else {
      a.style.removeProperty('color');
      a.style.fontWeight = '';
    }
  });
  if (id === 'pricing') {
    document.querySelectorAll('.nav-item > a').forEach(function(a) {
      if (a.textContent.trim().startsWith('요금제')) {
        a.style.setProperty('color', 'var(--accent)', 'important');
        a.style.fontWeight = '700';
      }
    });
  }
}

function updateNavState(id) {
  const session = getSession();
  const loginBtn = document.getElementById('navLoginBtn');
  const logoutBtn = document.getElementById('navLogoutBtn');
  const mypageBtn = document.getElementById('navMypageBtn');
  const consultBtn = document.getElementById('navConsultBtn');
  if (!loginBtn) return;
  if (session) {
    loginBtn.style.display = 'none';
    if (logoutBtn) logoutBtn.style.display = 'inline-flex';
    if (mypageBtn) {
      mypageBtn.style.display = 'inline-flex';
      mypageBtn.textContent = (session.role === 'admin' && window._adminIdToken) ? '어드민' : '마이페이지';
    }
    if (consultBtn) consultBtn.style.display = 'none';
  } else {
    loginBtn.style.display = 'inline-flex';
    if (logoutBtn) logoutBtn.style.display = 'none';
    if (mypageBtn) mypageBtn.style.display = 'none';
    if (consultBtn) consultBtn.style.display = 'inline-flex';
  }
}

function getSession() {
  try {
    var s = JSON.parse(localStorage.getItem('aicut_session'));
    if (!s) return null;
    // 만료 체크
    if (s.expireAt && Date.now() > s.expireAt) {
      localStorage.removeItem('aicut_session');
      return null;
    }
    return s;
  } catch { return null; }
}
function setSession(role, name, email) {
  var EXPIRE_DAYS = 30;
  var expireAt = Date.now() + (EXPIRE_DAYS * 24 * 60 * 60 * 1000);
  // admin role은 메모리 토큰(_adminIdToken)과 함께 사용될 때만 유효
  // localStorage의 role:'admin' 단독으로는 어드민 페이지 접근 불가 (가드에서 이중 검증)
  localStorage.setItem('aicut_session', JSON.stringify({ role, name, email: email||'', time: Date.now(), expireAt: expireAt }));
}
function clearSession() {
  localStorage.removeItem('aicut_session');
  localStorage.removeItem('aicut_admin_role');
  // 메모리 어드민 토큰 초기화 (페이지 새로고침 없이도 즉시 차단)
  window._adminIdToken   = null;
  window._adminClaimRole = null;
}

window.doLogout = function doLogout() {
  clearSession();
  updateNavState('home');
  showPage('home');
  showToast('로그아웃되었습니다. 안녕히 가세요 👋');
}

window.goMypage = function goMypage() {
  const session = getSession();
  if (!session) { openModal('login'); return; }
  // admin 페이지는 반드시 메모리 토큰(_adminIdToken) 존재 시에만 허용
  // localStorage role 조작으로 직행 차단
  if (session.role === 'admin') {
    if (!window._adminIdToken || !window._fbCurrentUser) {
      clearSession();
      openModal('login');
      showToast('⛔ 세션이 만료되었습니다. 다시 로그인해주세요.');
      return;
    }
  }
  showPage(session.role);
}

// ===== MODAL =====
window.openModal = function openModal(type) {
  if (type === 'admin') {
    document.getElementById('adminLoginModal').classList.add('open');
    return;
  }
  document.getElementById('authModal').classList.add('open');
  if (type === 'register') switchAuthTab('register', document.querySelector('.tab-switch button:nth-child(2)'));
  else switchAuthTab('login', document.querySelector('.tab-switch button:first-child'));
}
window.closeModal = function closeModal() { document.getElementById('authModal').classList.remove('open'); }
window.openB2B = function openB2B() {
  // 폼 초기화
  ['b2bCompany','b2bManager','b2bEmail','b2bPhone','b2bDesc'].forEach(function(id) {
    var el = document.getElementById(id);
    if (el) el.value = '';
  });
  var err = document.getElementById('b2bError');
  if (err) err.style.display = 'none';
  var btn = document.getElementById('b2bSubmitBtn');
  if (btn) { btn.disabled = false; btn.textContent = '상담 신청하기'; }
  document.getElementById('b2bModal').classList.add('open');
}

window.submitB2B = function submitB2B() {
  // GA4 form_submit 추적 (함수 시작 시점)
  if (typeof gtag === 'function') {
    gtag('event', 'form_submit', {
      form_name: 'b2b_inquiry',
      method: 'B2B 문의 폼'
    });
  }
  var company  = (document.getElementById('b2bCompany')  || {}).value || '';
  var manager  = (document.getElementById('b2bManager')  || {}).value || '';
  var email    = (document.getElementById('b2bEmail')    || {}).value || '';
  var phone    = (document.getElementById('b2bPhone')    || {}).value || '';
  var country  = (document.getElementById('b2bCountry') || {}).value || 'KR';
  var volume   = (document.getElementById('b2bVolume')   || {}).value || '';
  var desc     = (document.getElementById('b2bDesc')     || {}).value || '';
  var errEl    = document.getElementById('b2bError');
  var btn      = document.getElementById('b2bSubmitBtn');

  // 유효성 검사
  if (!company.trim()) {
    if (errEl) { errEl.textContent = '기업명을 입력해주세요'; errEl.style.display = 'block'; } return;
  }
  if (!email.trim() || !email.includes('@')) {
    if (errEl) { errEl.textContent = '올바른 이메일을 입력해주세요'; errEl.style.display = 'block'; } return;
  }
  if (!phone.trim()) {
    if (errEl) { errEl.textContent = '연락처를 입력해주세요'; errEl.style.display = 'block'; } return;
  }
  if (errEl) errEl.style.display = 'none';
  if (btn) { btn.disabled = true; btn.textContent = '신청 중...'; }

  // Firestore b2b_inquiries 컬렉션에 저장
  var saveB2B = function() {
    if (!window._db) {
      // Firestore 미초기화 시 재시도 (초기화 지연 대응)
      setTimeout(saveB2B, 500);
      return;
    }
    import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
      fs.addDoc(fs.collection(window._db, 'b2b_inquiries'), {
        company:   company.trim(),
        manager:   manager.trim(),
        email:     email.trim(),
        phone:     phone.trim(),
        country:   country || 'KR',
        volume:    volume,
        desc:      desc.trim(),
        status:    '신규',
        createdAt: fs.serverTimestamp()
      }).then(function(docRef) {
        console.log('[Firestore] B2B 상담 저장 완료:', docRef.id);

        // 채널톡 알림 — updateUser로 고객 정보 등록 + openChat으로 상담 자동 시작
        if (typeof ChannelIO !== 'undefined') {
          // 1) 고객 정보 채널톡에 등록 (어드민에서 식별 가능)
          ChannelIO('updateUser', {
            profile: {
              name:  manager.trim() + ' (' + company.trim() + ')',
              email: email.trim(),
              mobileNumber: phone.trim(),
            },
            tags: ['B2B상담신청'],
          });

          // 2) 자동으로 상담 채팅 오픈 + 메시지 전송 (어드민 단체방에 알림)
          ChannelIO('openChat', undefined,
            '[B2B] ' + company.trim() + ' / ' + manager.trim() + ' / ' + email.trim() + ' / ' + phone.trim() + ' / ' + volume
          );

          // 3) track 이벤트도 동시 발송 (자동화 설정 시 활용)
          ChannelIO('track', 'B2B상담신청', {
            기업명: company.trim(),
            담당자: manager.trim(),
            이메일: email.trim(),
            연락처: phone.trim(),
            월건수: volume
          });
        }

        // 완료 처리
        document.getElementById('b2bModal').classList.remove('open');
        showToast('🎉 상담 신청 완료! 영업일 1일 이내 연락드립니다');
        if (btn) { btn.disabled = false; btn.textContent = '계약 문의하기'; }
        // 폼 초기화
        ['b2bCompany','b2bManager','b2bEmail','b2bPhone','b2bDesc'].forEach(function(id) {
          var el = document.getElementById(id);
          if (el) el.value = '';
        });
      }).catch(function(e) {
        console.error('[Firestore] B2B 저장 실패 코드:', e.code, '메시지:', e.message);
        var msg = '저장 중 오류가 발생했습니다. 잠시 후 다시 시도해주세요.';
        if (e.code === 'permission-denied') {
          msg = 'Firestore 보안 규칙 오류입니다. Firebase Console에서 규칙을 확인해주세요.';
        } else if (e.code === 'unavailable' || e.code === 'failed-precondition') {
          msg = 'Firestore 데이터베이스가 준비되지 않았습니다. 잠시 후 다시 시도해주세요.';
        } else if (e.code === 'not-found') {
          msg = 'Firestore 데이터베이스를 찾을 수 없습니다. Firebase Console에서 Firestore를 생성해주세요.';
        }
        if (errEl) { errEl.textContent = msg + ' (코드: ' + (e.code||'unknown') + ')'; errEl.style.display = 'block'; }
        if (btn) { btn.disabled = false; btn.textContent = '계약 문의하기'; }
      });
    });
  };
  saveB2B();
}
// ───── B2B 상담 신청 Firestore 조회 ─────
window.loadB2BInquiries = function loadB2BInquiries() {
  if (!window._db) { setTimeout(loadB2BInquiries, 600); return; }
  var countEl  = document.getElementById('b2bInquiryCount');
  var emptyEl  = document.getElementById('b2bInquiryEmpty');
  var tableEl  = document.getElementById('b2bInquiryTable');
  if (countEl) countEl.textContent = '조회 중...';

  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
    var q = fs.query(
      fs.collection(window._db, 'b2b_inquiries'),
      fs.orderBy('createdAt', 'desc'),
      fs.limit(100)
    );
    fs.getDocs(q).then(function(snapshot) {
      // 기존 동적 행 제거
      if (tableEl) tableEl.querySelectorAll('tr[data-b2b]').forEach(function(r) { r.remove(); });

      if (snapshot.empty) {
        if (emptyEl) emptyEl.style.display = 'block';
        if (countEl) countEl.textContent = '0건';
        return;
      }
      if (emptyEl) emptyEl.style.display = 'none';
      if (countEl) countEl.textContent = snapshot.size + '건';

      snapshot.forEach(function(docSnap) {
        var d = docSnap.data();
        var docId = docSnap.id;
        var dateStr = d.createdAt && d.createdAt.toDate
          ? d.createdAt.toDate().toLocaleString('ko-KR', {month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit'})
          : '—';
        var statusMap = {
          '신규':    'badge-pending',
          '상담중':  'badge-editing',
          '계약완료':'badge-done',
          '미진행':  'badge-pending'
        };
        var badgeCls = statusMap[d.status] || 'badge-pending';
        var tr = document.createElement('tr');
        tr.setAttribute('data-b2b', docId);
        tr.innerHTML = `
          <td style="font-size:12px;color:var(--gray-400);white-space:nowrap">${dateStr}</td>
          <td style="font-weight:700">${d.company || '-'}</td>
          <td>${d.manager || '-'}</td>
          <td style="font-size:13px"><a href="mailto:${d.email}" style="color:var(--accent)">${d.email || '-'}</a></td>
          <td style="font-size:13px">${d.phone || '-'}</td>
          <td style="font-size:12px;color:var(--gray-400)">${d.country || 'KR'}</td>
          <td style="font-family:Pretendard,sans-serif;font-size:13px">${d.volume || '-'}</td>
          <td style="font-size:12px;color:var(--gray-500);max-width:240px">
            <div style="line-height:1.6;word-break:keep-all;white-space:pre-wrap">${d.desc || '-'}</div>
          </td>
          <td><span class="badge ${badgeCls}" id="b2b-status-${docId}">${d.status || '신규'}</span></td>
          <td style="display:flex;gap:4px;flex-wrap:wrap">
            <button class="btn btn-outline" style="padding:4px 8px;font-size:11px"
              onclick="changeB2BStatus('${docId}','상담중')">상담중</button>
            <button class="btn btn-primary" style="padding:4px 8px;font-size:11px"
              onclick="changeB2BStatus('${docId}','계약완료')">계약완료</button>
            <button class="btn btn-outline" style="padding:4px 8px;font-size:11px;color:var(--gray-400)"
              onclick="changeB2BStatus('${docId}','미진행')">미진행</button>
            <button class="btn btn-outline" style="padding:4px 8px;font-size:11px;color:#dc2626;border-color:#fca5a5"
              onclick="deleteB2BInquiry('${docId}','${(d.company||'').replace(/'/g,'')}')" title="삭제">🗑</button>
          </td>
        `;
        if (tableEl) tableEl.appendChild(tr);
      });
    }).catch(function(e) {
      console.warn('[Firestore] B2B 조회 실패:', e.message);
      if (countEl) countEl.textContent = '조회 실패';
    });
  });
};

// B2B 상담 상태 변경
window.changeB2BStatus = function changeB2BStatus(docId, newStatus) {
  if (!window._db) return;
  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
    var ref = fs.doc(window._db, 'b2b_inquiries', docId);
    // 기존 데이터 읽기
    fs.getDoc(ref).then(function(snap) {
      var d = snap.exists() ? snap.data() : {};
      // b2b_inquiries 상태 업데이트
      return fs.updateDoc(ref, {
        status: newStatus,
        updatedAt: fs.serverTimestamp()
      }).then(function() {
        // 계약완료 → b2b_contracts에 자동 등록
        if (newStatus === '계약완료') {
          var contractRef = fs.doc(window._db, 'b2b_contracts', docId);
          fs.setDoc(contractRef, {
            inquiryId:  docId,
            company:    d.company   || '',
            manager:    d.manager   || '',
            email:      d.email     || '',
            phone:      d.phone     || '',
            country:    d.country   || 'KR',
            volume:     d.volume    || '',
            desc:       d.desc      || '',
            status:     '계약중',
            contractAt: fs.serverTimestamp(),
            createdAt:  d.createdAt || fs.serverTimestamp(),
          }, { merge: true });
        }
        // 미진행 → b2b_contracts에서 상태 업데이트
        if (newStatus === '미진행') {
          var cRef = fs.doc(window._db, 'b2b_contracts', docId);
          fs.setDoc(cRef, { status: '미진행', updatedAt: fs.serverTimestamp() }, { merge: true })
            .catch(function() {}); // 없으면 무시
        }
        // 배지 즉시 업데이트
        var badge = document.getElementById('b2b-status-' + docId);
        var statusMap = { '신규':'badge-pending','상담중':'badge-editing','계약완료':'badge-done','미진행':'badge-pending' };
        if (badge) {
          badge.className = 'badge ' + (statusMap[newStatus] || 'badge-pending');
          badge.textContent = newStatus;
        }
        showToast('✓ "' + newStatus + '"으로 변경됐습니다');
      });
    }).catch(function(e) {
      showToast('❌ 상태 변경 실패: ' + e.message);
    });
  });
};

// B2B 문의 삭제
window.deleteB2BInquiry = function deleteB2BInquiry(docId, company) {
  if (!confirm((company || '해당 기업') + ' 문의를 삭제하시겠습니까?\n이 작업은 되돌릴 수 없습니다.')) return;
  if (!window._db) return;
  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
    fs.deleteDoc(fs.doc(window._db, 'b2b_inquiries', docId))
      .then(function() {
        var row = document.querySelector('tr[data-b2b="' + docId + '"]');
        if (row) row.remove();
        showToast('🗑 삭제됐습니다');
        // 카운터 업데이트
        if (typeof loadB2BInquiries === 'function') loadB2BInquiries();
      })
      .catch(function(e) {
        showToast('❌ 삭제 실패: ' + e.message);
      });
  });
};
// ===== 프로모션 관리 (YouTube + 모바일 이미지) =====
window._promoFile = null;

window.handlePromoImageSelect = function(input) {
  if (!input.files || !input.files[0]) return;
  var file = input.files[0];
  if (file.size > 5 * 1024 * 1024) { showToast('⚠️ 5MB 이하 이미지만 등록 가능합니다'); return; }
  window._promoFile = file;
  var reader = new FileReader();
  reader.onload = function(e) {
    var preview = document.getElementById('promoPreview');
    var content = document.getElementById('promoDropContent');
    if (preview) { preview.src = e.target.result; preview.style.display = 'block'; }
    if (content) content.style.display = 'none';
  };
  reader.readAsDataURL(file);
};

window.handlePromoDrop = function(e) {
  e.preventDefault();
  var zone = document.getElementById('promoDropZone');
  if (zone) { zone.style.borderColor = 'var(--border)'; zone.style.background = ''; }
  var file = e.dataTransfer.files[0];
  if (!file || !file.type.startsWith('image/')) { showToast('이미지 파일만 등록 가능합니다'); return; }
  window._promoFile = file;
  var reader = new FileReader();
  reader.onload = function(ev) {
    var preview = document.getElementById('promoPreview');
    var content = document.getElementById('promoDropContent');
    if (preview) { preview.src = ev.target.result; preview.style.display = 'block'; }
    if (content) content.style.display = 'none';
  };
  reader.readAsDataURL(file);
};

window.resetPromoForm = function() {
  window._promoFile = null;
  var urlEl    = document.getElementById('promoUrl');
  var preview  = document.getElementById('promoPreview');
  var content  = document.getElementById('promoDropContent');
  var inputEl  = document.getElementById('promoImageInput');
  if (urlEl)   urlEl.value = '';
  if (preview) { preview.src = ''; preview.style.display = 'none'; }
  if (content) content.style.display = '';
  if (inputEl) inputEl.value = '';
};

// YouTube URL → ID 추출
function _extractYTId(url) {
  if (!url) return '';
  var m = url.match(/(?:shorts\/|youtu\.be\/|embed\/|watch\?v=|&v=)([a-zA-Z0-9_-]{11})/);
  return m ? m[1] : '';
}

// 등록: YouTube URL + 모바일 이미지 (선택)
window.savePromoItem = function() {
  if (!window._db) { showToast('데이터베이스 연결 중입니다'); return; }
  var urlVal = (document.getElementById('promoUrl') || {value:''}).value.trim();
  var genre  = (document.getElementById('promoGenre') || {value:''}).value;
  var order  = parseInt((document.getElementById('promoOrder') || {value:'1'}).value) || 1;
  var videoId = _extractYTId(urlVal);

  if (!videoId) { showToast('YouTube URL을 입력해주세요'); return; }

  var saveData = {
    videoId:   videoId,
    url:       urlVal,
    genre:     genre,
    order:     order,
    createdAt: null // serverTimestamp 아래에서 설정
  };

  function _doSave(imageUrl, fileName) {
    import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
      var data = {
        videoId:   videoId,
        url:       urlVal,
        genre:     genre,
        order:     order,
        imageUrl:  imageUrl  || '',
        fileName:  fileName  || '',
        createdAt: fs.serverTimestamp()
      };
      fs.addDoc(fs.collection(window._db, 'promotions'), data).then(function() {
        showToast('✅ 등록됐습니다');
        window.resetPromoForm();
        loadPromoVideos();
      }).catch(function(e) { showToast('❌ 등록 실패: ' + e.message); });
    });
  }

  if (window._promoFile) {
    // 이미지 있으면 Storage 업로드 후 저장
    var file     = window._promoFile;
    var fileName = 'promotions/' + Date.now() + '_' + file.name.replace(/[^a-zA-Z0-9._]/g, '_');
    showToast('⏳ 이미지 업로드 중...');
    Promise.all([
      import('https://www.gstatic.com/firebasejs/11.6.0/firebase-storage.js')
    ]).then(function(mods) {
      var st = mods[0];
      var stRef = st.ref(st.getStorage(), fileName);
      st.uploadBytes(stRef, file).then(function(snap) {
        return st.getDownloadURL(snap.ref);
      }).then(function(url) {
        _doSave(url, fileName);
      }).catch(function(e) { showToast('❌ 이미지 업로드 실패: ' + e.message); });
    });
  } else {
    // 이미지 없으면 바로 저장
    _doSave('', '');
  }
};

// 목록 로드
window.loadPromoVideos = function() {
  if (!window._db) { setTimeout(loadPromoVideos, 600); return; }
  var tbody   = document.getElementById('promoTableBody');
  var emptyEl = document.getElementById('promoEmpty');
  if (!tbody) return;
  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
    var q = fs.query(fs.collection(window._db, 'promotions'), fs.orderBy('order', 'asc'));
    fs.getDocs(q).then(function(snap) {
      tbody.querySelectorAll('tr[data-promo]').forEach(function(r) { r.remove(); });
      if (snap.empty) { if (emptyEl) emptyEl.style.display = ''; return; }
      if (emptyEl) emptyEl.style.display = 'none';
      snap.forEach(function(doc) {
        var d = doc.data(); var pid = doc.id;
        var dateStr = d.createdAt && d.createdAt.toDate ? d.createdAt.toDate().toLocaleDateString('ko-KR') : '-';
        var ytThumb = d.videoId
          ? '<img src="https://img.youtube.com/vi/' + d.videoId + '/mqdefault.jpg" style="width:60px;height:45px;object-fit:cover;border-radius:6px;border:1px solid var(--border)">'
          : '<span style="color:var(--gray-400);font-size:11px">없음</span>';
        var mobileThumb = d.imageUrl
          ? '<img src="' + d.imageUrl + '" style="width:45px;height:80px;object-fit:cover;border-radius:6px;border:1px solid var(--border)">'
          : '<span style="color:var(--gray-400);font-size:11px">없음</span>';
        var fn = (d.fileName || '').split('/').pop();
        var tr = document.createElement('tr');
        tr.setAttribute('data-promo', pid);
        tr.innerHTML =
          '<td style="text-align:center">' + ytThumb + '</td>' +
          '<td style="text-align:center">' + mobileThumb + '</td>' +
          '<td style="font-size:13px">' + (d.genre || '-') + '</td>' +
          '<td style="text-align:center;font-weight:700">' + (d.order || '-') + '</td>' +
          '<td style="font-size:12px;color:var(--gray-400)">' + dateStr + '</td>' +
          '<td><button class="btn btn-outline" style="padding:4px 10px;font-size:11px;color:#dc2626;border-color:#fca5a5" onclick="deletePromoVideo(\'' + pid + '\',\'' + fn + '\')">🗑 삭제</button></td>';
        tbody.appendChild(tr);
      });
    });
  });
};

// 삭제
window.deletePromoVideo = function(docId, fileName) {
  if (!confirm('이 프로모션을 삭제하시겠습니까?')) return;
  if (!window._db) return;
  Promise.all([
    import('https://www.gstatic.com/firebasejs/11.6.0/firebase-storage.js'),
    import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js')
  ]).then(function(modules) {
    var st = modules[0]; var fs = modules[1];
    fs.deleteDoc(fs.doc(window._db, 'promotions', docId)).then(function() {
      if (fileName) {
        var ref = st.ref(st.getStorage(), 'promotions/' + fileName);
        st.deleteObject(ref).catch(function(){});
      }
      var row = document.querySelector('tr[data-promo="' + docId + '"]');
      if (row) row.remove();
      showToast('🗑 삭제됐습니다');
      loadPromoVideos();
    });
  });
};



