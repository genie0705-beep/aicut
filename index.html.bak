    // ── 에이컷 전환 이벤트 함수 ──
    window._// ===== GA4 전환 추적 =====

// CTA 클릭 통합 추적
window.trackCTA = function(label) {
  if (typeof gtag !== 'function') return;
  // GA4 cta_click 이벤트
  gtag('event', 'cta_click', {
    event_category: 'CTA',
    event_label: label,
    value: 1
  });
  // GA4 generate_lead 전환 이벤트
  gtag('event', 'generate_lead', {
    currency: 'KRW',
    value: 500000,
    lead_source: label
  });
  // 네이버 전환추적
  if (typeof window._naverConv === 'function') {
    window._naverConv('1', '0');
  }
  console.log('[GA4+Naver] CTA 클릭:', label);
};

// 스크롤 깊이 추적 (25/50/75/100%)
(function() {
  var _scrollMarks = { 25: false, 50: false, 75: false, 100: false };
  function _getScrollPct() {
    var el  = document.documentElement;
    var top = window.scrollY || el.scrollTop;
    var h   = el.scrollHeight - el.clientHeight;
    return h > 0 ? Math.round((top / h) * 100) : 0;
  }
  function _onScroll() {
    var pct = _getScrollPct();
    [25, 50, 75, 100].forEach(function(mark) {
      if (!_scrollMarks[mark] && pct >= mark) {
        _scrollMarks[mark] = true;
        if (typeof gtag === 'function') {
          gtag('event', 'scroll_depth', {
            event_category: 'Scroll',
            event_label: mark + '%',
            value: mark,
            non_interaction: true
          });
          console.log('[GA4] 스크롤 깊이:', mark + '%');
        }
      }
    });
  }
  window.addEventListener('scroll', _onScroll, { passive: true });
})();

