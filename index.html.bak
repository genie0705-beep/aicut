  new Chart(rc, {
    type: 'bar',
    data: {
      labels: ['10월','11월','12월','1월','2월','3월'],
      datasets: [{
        label: '매출',
        data: [3200000,4100000,5800000,6200000,7100000,7850000],
        backgroundColor: '#5c3de8',
        borderRadius: 6
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: { y: { ticks: { callback: v => '₩'+(v/10000)+'만' } } }
    }
  });
  new Chart(pc, {
    type: 'doughnut',
    data: {
      labels: ['STANDARD','PRO','PREMIUM','B2B'],
      datasets: [{ data: [232,553,1490,1170,3350], backgroundColor: ['#94a3b8','#3b82f6','#5c3de8','#1a1a2e','#10b981'], borderWidth: 2, borderColor: '#fff' }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false },
        tooltip: {
          callbacks: {
            label: ctx => ctx.label + ': ₩' + ctx.parsed.toLocaleString('ko-KR')
          }
        }
      }
    }
  });
}

