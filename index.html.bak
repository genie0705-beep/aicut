  icon.textContent = _fcOpen ? '✕' : '💬';
  if (_fcOpen) {
    badge.style.display = 'none';
    if (_fcFirstOpen) {
      _fcFirstOpen = false;
      setTimeout(() => fcBotMsg('궁금한 점을 아래 버튼으로 빠르게 물어보거나, 직접 메시지를 입력해주세요!'), 600);
    }
    setTimeout(() => document.getElementById('fcInput').focus(), 200);
