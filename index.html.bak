document.addEventListener('DOMContentLoaded', function() {
  // 페이지 로드 시 푸터 초기 표시 (home 페이지 기본)
  (function() {
    var sf = document.getElementById('shared-footer');
    if (sf) sf.style.display = 'block';
  })();

  // 페이지 로드 시 세션 상태 즉시 반영
  (function() {
    try {
      var s = typeof getSession === 'function' ? getSession() : null;
      var lb = document.getElementById('navLoginBtn');
      var lo = document.getElementById('navLogoutBtn');
      var mp = document.getElementById('navMypageBtn');
      var cb = document.getElementById('navConsultBtn');

      if (!s) {
        // 비로그인 상태 → 로그인 버튼만 표시
        if (lb) lb.style.display = 'inline-flex';
        if (lo) lo.style.display = 'none';
        if (mp) mp.style.display = 'none';
        if (cb) cb.style.display = 'inline-flex';
      } else {
        // 로그인 상태 → 로그아웃/마이페이지 표시
        if (lb) lb.style.display = 'none';
        if (lo) lo.style.display = 'inline-flex';
        if (mp) {
          mp.style.display = 'inline-flex';
          // 페이지 새로고침 시: admin role이 localStorage에 있어도
          // 메모리 토큰(_adminIdToken)이 없으므로 '마이페이지'로만 표시
          // 실제 접근은 goMypage 내부에서 토큰 재검증으로 차단
          var isRealAdmin = (s.role === 'admin' && window._adminIdToken);
          mp.textContent = isRealAdmin ? '어드민' : '마이페이지';
        }
        if (cb) cb.style.display = 'none';
      }
    } catch(e) {}
  })();

  document.querySelectorAll('.nav-item > a').forEach(function(a) {
    a.addEventListener('click', function(e) {
      var item = a.parentElement;
      var dropdown = item.querySelector('.nav-dropdown');
      if (!dropdown) return;
      e.stopPropagation();
      var isOpen = item.classList.contains('open');
      document.querySelectorAll('.nav-item').forEach(function(i) { i.classList.remove('open'); });
      if (!isOpen) item.classList.add('open');
    });
  });
  document.addEventListener('click', function() {
    document.querySelectorAll('.nav-item').forEach(function(i) { i.classList.remove('open'); });
  });
  document.querySelectorAll('.nav-dropdown').forEach(function(dd) {
    dd.addEventListener('click', function(e) { e.stopPropagation(); });
  });
});

