  <!-- 롤링 CSS -->
  <style>
  .rv-wrap{overflow:hidden;position:relative;margin-bottom:40px}
  .rv-wrap::before,.rv-wrap::after{content:'';position:absolute;top:0;bottom:0;width:80px;z-index:2;pointer-events:none}
  .rv-wrap::before{left:0;background:linear-gradient(to right,#09061a,transparent)}
  .rv-wrap::after{right:0;background:linear-gradient(to left,#09061a,transparent)}
  .rv-track{display:flex;gap:14px;width:max-content}
  .rv-t1{animation:rvroll1 44s linear infinite}
  .rv-t2{animation:rvroll2 52s linear infinite}
  
  @keyframes rvroll1{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
  @keyframes rvroll2{0%{transform:translateX(-50%)}100%{transform:translateX(0)}}
  .rvc{flex-shrink:0;border-radius:18px;overflow:hidden}
  .rvc-rv{width:340px;height:210px;background:white;padding:26px;display:flex;flex-direction:column;justify-content:space-between}
  .rvc-rv-q{font-size:14px;color:#374151;line-height:1.75}
  .rvc-rv-b{display:flex;align-items:center;justify-content:space-between;margin-top:6px}
  .rvc-rv-n{font-size:13px;font-weight:700;color:#111}
  .rvc-rv-r{font-size:11px;color:#6b7280}
  .rvc-stat{width:220px;height:210px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px}
  .rvc-stat-n{font-size:44px;font-weight:700;color:white;line-height:1}
  .rvc-stat-l{font-size:13px;font-weight:700;color:rgba(255,255,255,0.65)}
  .rvc-stat-s{font-size:11px;color:rgba(255,255,255,0.45)}
  .rvc-wide{width:420px;height:210px;background:white;padding:26px 28px;display:flex;flex-direction:column;justify-content:space-between}
  .rvc-wide-q{font-size:14px;color:#374151;line-height:1.75}
  .rvc-wide-b{display:flex;align-items:center;justify-content:space-between;margin-top:6px}
  .rvc-nm{width:240px;height:210px;padding:24px;display:flex;flex-direction:column;justify-content:flex-end;background:rgba(255,255,255,0.06);border:0.5px solid rgba(255,255,255,0.12)}
  .rvc-nm-s{color:#22c55e;font-size:16px;margin-bottom:8px}
  .rvc-nm-n{font-size:18px;font-weight:700;color:white;margin-bottom:4px}
  .rvc-nm-r{font-size:12px;color:rgba(255,255,255,0.5);line-height:1.6}
  .rv-pl{font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px}
  
/* ===== 고객 화면 비주얼 v3 ===== */

/* [1] 통계 카드 4개 색상 */
#page-client .stat-card-new.sc-purple { background: #f3f0ff; border-color: #c4b5fd; }
#page-client .stat-card-new.sc-purple .sc-icon { filter: none; }
#page-client .stat-card-new.sc-purple .sc-val { color: #6c63ff; }

#page-client .stat-card-new.sc-pink { background: #fff7ed; border-color: #fdba74; }
#page-client .stat-card-new.sc-pink .sc-val { color: #ea580c; }

#page-client .stat-card-new.sc-green { background: #f0fdf4; border-color: #86efac; }
#page-client .stat-card-new.sc-green .sc-val { color: #059669; }

#page-client .stat-card-new.sc-amber { background: #eff6ff; border-color: #93c5fd; }
#page-client .stat-card-new.sc-amber .sc-val { color: #2563eb; }

/* [1] 통계 카드 공통 둥글기·그림자 */
#page-client .stat-card-new {
  border-radius: 16px;
  box-shadow: 0 1px 8px rgba(0,0,0,.06), 0 0 0 1px rgba(0,0,0,.04);
  border-width: 1px;
}

/* [2] 주문 카드 배지 */
#page-client .badge { border-radius: 8px; font-size: 12px; padding: 4px 10px; }

/* [3] 단계 바 도트 현재 단계 1.3배 */
#page-client .spv-item.active .spv-dot { transform: scale(1.3); }

/* [4] 액션 박스 공통 — 좌측 보더 5px */
#page-client .action-box { border-left-width: 5px; border-radius: 12px; }

/* [5] 대시보드 패널 */
#page-client .panel { border-radius: 16px; border-color: #ede9ff; }

/* [6] 사이드바 로고 보라 강조 */
#page-client .sb-logo { color: #1e1b4b; }
#page-client .sb-logo span { color: #6c63ff; font-weight: 900; }

/* [6] 사이드바 활성 메뉴 — 아이콘도 보라 */
#page-client .sb-menu a.active .sb-icon { filter: none; color: #6c63ff; }

/* 주문 카드 border-radius */
#page-client .order-card { border-radius: 16px; }

/* 빈 상태 버튼 */
#page-client .empty-state-new button { border-radius: 50px; padding: 12px 28px; font-size: 14px; }

/* 검수 피드백 좌측 보더 */
#page-client .review-feedback-card { border-left-width: 5px; border-radius: 12px; }

/* 환영 히어로 카드 */
#page-client .client-welcome-hero { box-shadow: 0 4px 24px rgba(108,99,255,.25); }

/* 모바일 조정 */
@media(max-width: 640px) {
  #page-client .stat-card-new { border-radius: 14px; }
  #page-client .order-card { border-radius: 14px; }
  #page-client .action-box { border-radius: 10px; }
}
</style>

