  (function(){
    // 카운트업 애니메이션
    function countUp(el, target, dur) {
      var start = null;
      function step(ts) {
        if (!start) start = ts;
        var progress = Math.min((ts - start) / dur, 1);
        var ease = 1 - Math.pow(1 - progress, 4); // easeOutQuart
        el.textContent = Math.floor(ease * target);
        if (progress < 1) requestAnimationFrame(step);
        else el.textContent = target;
      }
      requestAnimationFrame(step);
    }
    var fired = false;
    var ob = new IntersectionObserver(function(entries){
      if(entries[0].isIntersecting && !fired){
        fired = true;
        document.querySelectorAll('.stats-count').forEach(function(el){
          var target = parseFloat(el.dataset.target);
          var isFloat = el.dataset.target && el.dataset.target.includes('.');
          var start = null;
          (function step(ts) {
            if (!start) start = ts;
            var p = Math.min((ts - start) / 1500, 1);
            var ease = 1 - Math.pow(1 - p, 4);
            var val = ease * target;
            el.textContent = isFloat ? val.toFixed(1) : Math.floor(val);
            if (p < 1) requestAnimationFrame(step);
            else el.textContent = isFloat ? target.toFixed(1) : target;
          })(performance.now());
        });
        ob.disconnect();
      }
    },{threshold:0.35});
    var sec=document.getElementById('stats-section'); if(sec) ob.observe(sec);
    // 호버 일시정지
    var wrap=document.getElementById('statsTrackWrap'), track=document.getElementById('statsTrack');
    if(wrap&&track){
      wrap.addEventListener('mouseenter',function(){track.style.animationPlayState='paused';});
      wrap.addEventListener('mouseleave',function(){track.style.animationPlayState='running';});
    }
  })();
  

  var psCur = 0, psTotal = 5, psAuto;
  window.pGoSlide = function(n) {
    psCur = ((n % psTotal) + psTotal) % psTotal;
    var slider = document.getElementById('psSlider');
    if (slider) slider.style.transform = 'translateX(-' + (psCur * 100) + '%)';

    // 스텝 인디케이터
    document.querySelectorAll('.ps-si').forEach(function(s, i) {
      var num = s.querySelector('.ps-sn');
      var lbl = s.querySelector('div:last-child');
      if (i <= psCur) {
        num.style.cssText = 'width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:800;transition:all .3s;background:#5c3de8;color:white;border:2px solid #5c3de8;' + (i === psCur ? 'box-shadow:0 0 0 5px rgba(92,61,232,0.15)' : 'box-shadow:none');
        lbl.style.color = '#5c3de8'; lbl.style.fontWeight = '700';
      } else {
        num.style.cssText = 'width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:800;transition:all .3s;background:var(--gray-100,#f3f4f6);color:#9ca3af;border:2px solid #e5e7eb;box-shadow:none';
        lbl.style.color = '#9ca3af'; lbl.style.fontWeight = '500';
      }
    });

    // 연결선 진행
    var line = document.getElementById('psLine');
    if (line) line.style.width = (psCur / (psTotal-1) * 80) + '%';

    // 점 인디케이터
    document.querySelectorAll('#psDots div').forEach(function(d, i) {
      d.style.width = i === psCur ? '20px' : '6px';
      d.style.borderRadius = i === psCur ? '3px' : '50%';
      d.style.background = i === psCur ? '#5c3de8' : '';
    });
  };

  function psStartAuto() {
    clearInterval(psAuto);
    psAuto = setInterval(function() { pGoSlide((psCur+1) % psTotal); }, 3500);
  }
  document.getElementById('steps-section').addEventListener('click', psStartAuto);
  psStartAuto();
  

  (function(){
    var t1=document.getElementById('rvt1');
    var t2=document.getElementById('rvt2');
    if(t1) t1.innerHTML+=t1.innerHTML;
    if(t2) t2.innerHTML+=t2.innerHTML;
  })();
  

