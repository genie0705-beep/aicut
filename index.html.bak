          ['근무 형태', '원격 근무 (국내 · 해외 거주 가능), 프로젝트 단위 계약'],
          ['정산 방식', '월 1회 프로젝트 수 기준 정산. 건수가 많을수록 단가 상향 적용'],
          ['지원 자격', '영상 편집 경력 1년 이상, 포트폴리오 3건 이상, 납기 준수 가능자'],
          ['지원 방법', 'master@aicut.co.kr 로 포트폴리오 + 간단 자기소개 발송'],
        ].map(([label, val]) => `
          <div style="display:flex;gap:16px;padding:12px 0;border-bottom:1px solid var(--gray-100)">
            <span style="font-size:13px;font-weight:700;color:var(--gray-500);min-width:80px;flex-shrink:0">${label}</span>
            <span style="font-size:13px;color:var(--primary);line-height:1.7">${val}</span>
          </div>
        `).join('')}
        <button class="btn btn-primary btn-full btn-lg" style="margin-top:8px" onclick="window.location.href='mailto:master@aicut.co.kr?subject=에디터 지원합니다'">
          📧 master@aicut.co.kr 지원하기
        </button>
      </div>
    `
  }
};

window.openInfoModal = function openInfoModal(type) {
  const content = infoContents[type];
  if (!content) return;
  document.getElementById('infoModalTitle').textContent = content.title;
  document.getElementById('infoModalBody').innerHTML = content.body;
  document.getElementById('infoModal').classList.add('open');
}

// ===== 에디터 상세 모달 =====
function showEditorDetail(btn) {
  const row = btn.closest('tr');
  if (!row) return;
  const cells = row.querySelectorAll('td');
  const name    = cells[0]?.textContent?.trim() || '-';
  const spec    = cells[1]?.textContent?.trim() || '-';
  const current = cells[2]?.textContent?.trim() || '-';
  const rate    = cells[4]?.textContent?.trim() || '-';
  const avgDay  = cells[5]?.textContent?.trim() || '-';
  const statusEl= cells[6]?.querySelector('.badge');
  const status  = statusEl?.textContent?.trim() || '-';
  const statusCls = statusEl?.className || 'badge';
  const isFull  = status === '포화';

  document.getElementById('editorDetailBody').innerHTML = `
    <div style="margin-bottom:20px">
      <div style="font-size:22px;font-weight:900;color:var(--primary);margin-bottom:4px">${name}</div>
      <div style="font-size:13px;color:var(--gray-400)">${spec}</div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:20px">
      <div style="background:var(--gray-50);border-radius:10px;padding:14px">
        <div style="font-size:11px;color:var(--gray-400);margin-bottom:4px">현재 진행 건수</div>
        <div style="font-size:20px;font-weight:800;color:var(--primary)">${current}</div>
      </div>
      <div style="background:var(--gray-50);border-radius:10px;padding:14px">
        <div style="font-size:11px;color:var(--gray-400);margin-bottom:4px">이번달 완료</div>
        <div style="font-size:20px;font-weight:800;color:var(--accent)">${rate}</div>
      </div>
      <div style="background:var(--gray-50);border-radius:10px;padding:14px">
        <div style="font-size:11px;color:var(--gray-400);margin-bottom:4px">평균 납품일</div>
        <div style="font-size:20px;font-weight:800;color:var(--primary)">${avgDay}</div>
      </div>
      <div style="background:var(--gray-50);border-radius:10px;padding:14px">
        <div style="font-size:11px;color:var(--gray-400);margin-bottom:4px">현재 상태</div>
        <span class="${statusCls}" style="font-size:13px">${status}</span>
      </div>
    </div>
    ${isFull ? `
    <div style="background:#fef3c7;border:1px solid #fcd34d;border-radius:10px;padding:12px 16px;font-size:13px;color:#92400e;margin-bottom:16px">
      ⚠️ 현재 포화 상태입니다. 신규 배정을 일시 중지하는 것을 권장합니다.
    </div>` : ''}
    <div style="display:flex;gap:10px">
      <button class="btn btn-outline btn-full" onclick="document.getElementById('editorDetailModal').classList.remove('open')">닫기</button>
      ${isFull
        ? `<button class="btn btn-full" style="background:var(--orange);color:white;border:none;font-family:inherit;font-size:14px;font-weight:600;border-radius:10px;cursor:pointer" onclick="pauseEditorAssign('${name}')">배정 일시 중지</button>`
        : `<button class="btn btn-primary btn-full" onclick="document.getElementById('editorDetailModal').classList.remove('open');showTab('admin','a-orders',null)">주문 배정하기</button>`}
    </div>
  `;
  document.getElementById('editorDetailModal').classList.add('open');
}

function pauseEditorAssign(name) {
  document.getElementById('editorDetailModal').classList.remove('open');
  showToast(`✓ ${name} 에디터 신규 배정이 일시 중지되었습니다`);
}

// ===== 관리자 계정 수정 모달 =====
function showAdminEditModal(name, email, role) {
  const existing = document.getElementById('adminEditModal');
  if (existing) existing.remove();
  const modal = document.createElement('div');
  modal.id = 'adminEditModal';
  modal.className = 'overlay open';
  modal.innerHTML = `
    <div class="modal-box" style="max-width:400px">
      <button class="modal-close" onclick="document.getElementById('adminEditModal').remove()">✕</button>
      <div class="modal-logo">AI<span>CUT</span></div>
      <div class="modal-title">권한 수정</div>
      <div class="modal-sub">${name} (${email})</div>
      <div class="form-group" style="margin-top:20px">
        <label class="form-label">역할</label>
        <select class="form-select" id="editAdminRole">
          <option value="master" ${role==='master'?'selected':''}>👑 마스터</option>
          <option value="ops" ${role==='ops'?'selected':''}>🛠 운영담당</option>
          <option value="cs" ${role==='cs'?'selected':''}>💬 고객상담</option>
        </select>
      </div>
      <div style="display:flex;gap:10px;margin-top:16px">
        <button class="btn btn-outline btn-full" onclick="document.getElementById('adminEditModal').remove()">취소</button>
        <button class="btn btn-primary btn-full" onclick="saveAdminEdit('${email}')">저장</button>
      </div>
    </div>`;
  modal.addEventListener('click', e => { if(e.target===modal) modal.remove(); });
  document.body.appendChild(modal);
}

function saveAdminEdit(email) {
  const role = document.getElementById('editAdminRole')?.value;
  const state = getAdminState();
  if (state.admins[email]) { state.admins[email].role = role; saveAdminState(state); }
  document.getElementById('adminEditModal')?.remove();
  showToast(`✓ 권한이 수정되었습니다`);
}

// ===== 어드민 상태 관리 (localStorage) =====
const ADMIN_KEY = 'aicut_admin_state';

function getAdminState() {
  try {
    const s = localStorage.getItem(ADMIN_KEY);
    if (s) return JSON.parse(s);
  } catch {}
  // 기본 초기 데이터
  return {
    orders: {
      'FC-0040': { title:'기업 인트로 VFX', client:'㈜미디어플러스', plan:'PREMIUM', status:'editing', editor:'Victor', deadline:'D-1' },
      'FC-0039': { title:'기업 홍보영상', client:'박지훈', plan:'PREMIUM', status:'review', editor:'Jason', deadline:'D-1' },
      'FC-0038': { title:'유튜브 인터뷰', client:'최미래', plan:'STANDARD', status:'waiting', editor:'', deadline:'D-0' },
      'FC-0037': { title:'SNS 릴스 10편', client:'이준혁', plan:'STANDARD', status:'editing', editor:'Luke', deadline:'D-2' },
      'FC-0036': { title:'제품 소개 영상', client:'강도현', plan:'STARTER', status:'waiting', editor:'', deadline:'D-2' },
      'FC-0035': { title:'브이로그 편집', client:'한소희', plan:'STARTER', status:'waiting', editor:'', deadline:'D-4' },
      'FC-0032': { title:'인터뷰 영상 3편', client:'김민준', plan:'STANDARD', status:'review', editor:'Jason', deadline:'D-2' },
    },
    editors: {
      'Jason': { spec:'롱폼/기업', status:'active', projects: 6 },
      'Luke':  { spec:'유튜브/롱폼', status:'active', projects: 5 },
      'Victor':{ spec:'CG/VFX', status:'active', projects: 3 },
      'Eric':  { spec:'모션그래픽', status:'active', projects: 4 },
      'Chris': { spec:'모션그래픽', status:'busy', projects: 7 },
    },
    pricing: { STANDARD:79000, PRO:180000, PREMIUM:0 },
    admins: {
      'admin@aicut.kr': { name:'김대표', role:'master', status:'active' },
      'ops@aicut.kr':   { name:'이운영', role:'ops', status:'active' },
      'cs@aicut.kr':    { name:'박상담', role:'cs', status:'inactive' },
    }
  };
}

function saveAdminState(state) {
  localStorage.setItem(ADMIN_KEY, JSON.stringify(state));
}

// 주문 상태 변경
// 현재 어드민에서 열려있는 주문 ID
window._currentAdminOrderId = null;

function adminChangeOrderStatus(orderId, newStatus, label) {
  const state = getAdminState();
  if (state.orders[orderId]) {
    state.orders[orderId].status = newStatus;
    saveAdminState(state);
  }
  // Firestore updateDoc — orderId 필드로 문서 찾아서 업데이트
  if (window._db) {
    import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
      // orderId 필드 기준 쿼리 (addDoc 사용 시 문서ID != orderId)
      var q = fs.query(fs.collection(window._db, 'orders'), fs.where('orderId', '==', orderId), fs.limit(1));
      fs.getDocs(q).then(function(snap) {
        if (snap.empty) {
          // 문서ID로 직접 시도
          return fs.updateDoc(fs.doc(window._db, 'orders', orderId), {
            status: newStatus, updatedAt: fs.serverTimestamp()
          });
        }
        return fs.updateDoc(snap.docs[0].ref, {
          status: newStatus, updatedAt: fs.serverTimestamp()
        });
      }).then(function() {
        console.log('[Firestore] ✅ 상태 업데이트:', orderId, newStatus);
      }).catch(function(e) {
        console.warn('[Firestore] 상태 업데이트 실패:', e.code, e.message);
      });
    });
  }
  // 화면 배지 업데이트
  const badgeMap = {
    'payment_pending': ['badge-pending','💳 결제대기'],
    'waiting':  ['badge-pending','📦 소스대기'],
    'pending':  ['badge-pending','📦 소스대기'],
    'editing':  ['badge-editing','편집중'],
    'review':   ['badge-review','검수중'],
    'done':     ['badge-done','납품완료'],
  };
  const [cls, txt] = badgeMap[newStatus] || ['badge-pending', label];
  document.querySelectorAll('#admin-order-detail .badge-editing, #admin-order-detail .badge-review, #admin-order-detail .badge-pending, #admin-order-detail .badge-done').forEach(b => {
    b.className = 'badge ' + cls;
    b.textContent = txt;
  });
  showToast(`✓ 상태가 "${txt}"으로 변경되었습니다`);
}

// 에디터 배정 변경
function adminChangeEditor() {
  const sel = document.getElementById('adminEditorSelect');
  if (!sel) return;
  const newEditor = sel.value.split(' ')[0];
  // 주문 상세 담당 에디터 텍스트 업데이트
  document.querySelectorAll('#admin-order-detail .detail-item').forEach(item => {
    const label = item.querySelector('label');
    if (label && label.textContent === '담당 에디터') {
      const p = item.querySelector('p');
      if (p) p.textContent = newEditor + ' 에디터';
    }
  });
  showToast(`✓ ${newEditor} 에디터로 배정이 변경되었습니다`);
}

// 수정 완료 처리
function adminCompleteRevision(roundNum) {
  const btn = event.target;
  const revRound = btn.closest('.rev-round');
  if (revRound) {
    revRound.classList.remove('active');
    revRound.classList.add('done');
    const badge = revRound.querySelector('.badge');
    if (badge) { badge.className = 'badge badge-done'; badge.textContent = '반영 완료'; }
    const items = revRound.querySelectorAll('.rev-item.pending');
    items.forEach(item => {
      item.classList.remove('pending');
      item.classList.add('done');
      const check = item.querySelector('.rev-check');
      if (check) { check.classList.remove('pend'); check.textContent = '✓'; }
    });
    const label = revRound.querySelector('.rev-num');
    showToast(`✓ ${label ? label.textContent : ''} 수정이 완료 처리되었습니다`);
  }
}

// 검수 요청 발송
// 어드민 주문 목록에서 직접 상태 변경
window.adminChangeOrderStatusFromSelect = function(sel, orderId, docId) {
  var newStatus = sel.value;
  if (!newStatus || !orderId) return;
  var label = sel.options[sel.selectedIndex].text;
  sel.value = '';  // 드롭다운 리셋

  // 행의 상태 배지 즉시 업데이트
  var tr = sel.closest('tr');
  if (tr) {
    var badgeMap = {
      payment_pending: ['badge-pending', '💳 결제대기', 'background:#fef3c7;color:#92400e'],
      pending:  ['badge-pending', '📦 소스대기', 'background:#e0f2fe;color:#0369a1'],
      waiting:  ['badge-pending', '📦 소스대기', 'background:#e0f2fe;color:#0369a1'],
      editing:  ['badge-editing', '✂️ 편집중', ''],
      review:   ['badge-review',  '🔍 검수중', ''],
      done:     ['badge-done',    '✅ 납품완료', ''],
    };
    var si = badgeMap[newStatus] || ['badge-pending', label, ''];
    var badge = tr.querySelector('.badge');
    if (badge) {
      badge.className = 'badge ' + si[0];
      badge.textContent = si[1];
      badge.style.cssText = si[2] ? si[2] : '';
    }
    tr.setAttribute('data-s', newStatus);
  }

  showToast('✓ 상태가 "' + label + '"으로 변경되었습니다');

  // Firestore — docId(문서 실제 ID)로 직접 updateDoc
  if (!window._db) { console.warn('[상태변경] DB 없음'); return; }
  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
    var doUpdate = function(ref) {
      fs.updateDoc(ref, { status: newStatus, updatedAt: fs.serverTimestamp() })
        .then(function() {
          console.log('[Firestore] ✅ 상태 업데이트:', orderId, '→', newStatus);
        })
        .catch(function(e) {
          console.error('[Firestore] ❌ 상태 업데이트 실패:', e.code, e.message);
          showToast('⚠️ 저장 실패: ' + (e.code || e.message));
        });
    };

    if (docId) {
      // 문서 ID 직접 사용 (가장 확실)
      doUpdate(fs.doc(window._db, 'orders', docId));
    } else {
      // orderId 필드로 조회 후 업데이트
      fs.getDocs(fs.query(
        fs.collection(window._db, 'orders'),
        fs.where('orderId', '==', orderId),
        fs.limit(1)
      )).then(function(snap) {
        if (snap.empty) {
          doUpdate(fs.doc(window._db, 'orders', orderId));
        } else {
          doUpdate(snap.docs[0].ref);
        }
      });
    }
  });
};

// 어드민 주문 삭제
window.deleteAdminOrder = function deleteAdminOrder(docId, orderId, btn) {
  if (!confirm('이 주문을 삭제하시겠습니까? (되돌릴 수 없습니다)\n\n주문번호: #' + orderId)) return;

  if (!window._db) { showToast('⚠️ DB 연결 오류'); return; }

  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
    // docId(문서ID)로 직접 삭제
    var ref = docId ? fs.doc(window._db, 'orders', docId)
                    : null;

    var doDelete = function(ref) {
      fs.deleteDoc(ref).then(function() {
        var tr = btn.closest('tr');
        if (tr) tr.remove();
        // 삭제 후 빈 상태 확인
        var tbody = document.getElementById('adminOrderTable');
        if (tbody && tbody.querySelectorAll('tr[data-source="firestore"]').length === 0) {
          var emptyRow = document.getElementById('adminOrderEmptyRow');
          if (emptyRow) { emptyRow.style.display = ''; emptyRow.cells[0].textContent = '📭 접수된 주문이 없습니다'; }
        }
        showToast('🗑️ 주문 #' + orderId + ' 삭제 완료');
        console.log('[Firestore] 주문 삭제:', orderId);
      }).catch(function(e) {
        console.error('[Firestore] 삭제 실패:', e.code, e.message);
        showToast('⚠️ 삭제 실패: ' + (e.code || e.message));
      });
    };

    if (ref) {
      doDelete(ref);
    } else {
      // orderId 필드로 문서 찾아서 삭제
      fs.getDocs(fs.query(fs.collection(window._db, 'orders'), fs.where('orderId', '==', orderId), fs.limit(1)))
        .then(function(snap) {
          if (snap.empty) { showToast('⚠️ 주문을 찾을 수 없습니다'); return; }
          doDelete(snap.docs[0].ref);
        });
    }
  });
};

// 고객 입금 완료 알림
// NDA 체크박스 → 버튼 활성화
// 어드민 증빙 서류 + NDA 렌더링
window.renderTaxInfo = function renderTaxInfo(orderData) {
  var el = document.getElementById('adminTaxInfo');
  if (!el) return;
  var taxType   = orderData.taxType   || '';
  var taxBizNum = orderData.taxBizNum || orderData.taxBiznum || '';
  var taxCompany= orderData.taxCompany|| '';
  var taxEmail  = orderData.taxEmail  || '';
  var recNum    = orderData.receiptNum|| orderData.taxValue  || '';
  var ndaAgreed = orderData.ndaAgreed || false;
  var h = '<div style="font-size:13px;line-height:1.8">';
  h += '<div>NDA 동의: ' + (ndaAgreed ? '✅ 동의함' : '❌ 미동의') + '</div>';
  if (taxType === 'tax') {
    h += '<div style="margin-top:8px"><strong>📄 세금계산서 발행 요청</strong><br>';
    h += '사업자번호: ' + (taxBizNum || '-') + '<br>';
    h += '상호명: '    + (taxCompany || '-') + '<br>';
    h += '수신 이메일: '+ (taxEmail   || '-') + '</div>';
  } else if (taxType === 'receipt') {
    h += '<div style="margin-top:8px"><strong>🧾 현금영수증 발행 요청</strong><br>';
    h += '발행 번호: ' + (recNum || '-') + '</div>';
  } else {
    h += '<div style="color:#9ca3af;margin-top:4px">증빙 서류 불필요</div>';
  }
  h += '</div>';
  el.innerHTML = h;
};

// 엔터프라이즈 플랜 선택 시 안내
window.checkEnterprisePlan = function checkEnterprisePlan(sel) {
  if (!sel) return;
  var val = sel.value || '';
  var noticeEl = document.getElementById('enterprisePlanNotice');
  if (val.startsWith('ENTERPRISE')) {
    if (!noticeEl) {
      var notice = document.createElement('div');
      notice.id = 'enterprisePlanNotice';
      notice.style.cssText = 'background:#ede9ff;border:1.5px solid #c4b5fd;border-radius:10px;padding:14px 16px;margin-top:10px;font-size:13px;color:#4c1d95;line-height:1.7';
      notice.innerHTML =
        '<div style="font-weight:700;margin-bottom:6px">💼 ENTERPRISE 플랜 안내</div>' +
        'ENTERPRISE는 맞춤 견적 후 진행됩니다.<br>' +
        '아래 <strong>"맞춤 견적 문의"</strong> 버튼을 눌러주시면<br>' +
        '담당자가 24시간 내 연락드립니다.' +
        '<div style="margin-top:10px">' +
          '<button onclick="openB2B()" style="background:#6c63ff;color:white;border:none;border-radius:8px;padding:10px 20px;font-size:13px;font-weight:700;cursor:pointer">💼 맞춤 견적 문의하기 →</button>' +
        '</div>';
      sel.parentNode.insertAdjacentElement('afterend', notice);
    } else {
      noticeEl.style.display = 'block';
    }
  } else {
    if (noticeEl) noticeEl.style.display = 'none';
  }
};

// 결제 증빙 서류 선택 처리
window.handlePayTaxType = function handlePayTaxType(val) {
  var taxD = document.getElementById('pay-tax-detail');
  var recD = document.getElementById('pay-receipt-detail');
  if (taxD) taxD.style.display = val === 'tax'     ? 'block' : 'none';
  if (recD) recD.style.display = val === 'receipt' ? 'block' : 'none';
};

window.toggleNdaBtn = function toggleNdaBtn(cb) {
  var btn = document.getElementById('ndaNotifyBtn');
  if (btn) btn.disabled = !cb.checked;
};

window.notifyPayment = function notifyPayment() {
  var oid = window._currentClientOrderId;
  if (!oid || !window._db) return;
  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
    var q = fs.query(fs.collection(window._db,'orders'), fs.where('orderId','==',oid), fs.limit(1));
    fs.getDocs(q).then(function(snap) {
      var docRef = snap.empty ? fs.doc(window._db,'orders',oid) : snap.docs[0].ref;
      return fs.setDoc(docRef, { paymentNotifiedAt: fs.serverTimestamp(), paymentNotified: true }, { merge: true });
    }).then(function(docRef) {
      // NDA 동의 Firestore 저장
      var ndaCb = document.getElementById('ndaCheckbox');
      if (ndaCb && ndaCb.checked) {
        var ref = docRef || fs.doc(window._db,'orders',oid);
        fs.setDoc(ref, {
          ndaAgreed:   true,
          ndaAgreedAt: fs.serverTimestamp(),
          ndaVersion:  'v1.0',
        }, { merge: true }).catch(function(){});
      }
      showToast('✅ 입금 알림을 보냈습니다! 곧 확인 후 연락드릴게요 😊');
    }).catch(function(e) {
      showToast('⚠️ 알림 전송 실패: ' + (e.code || e.message));
    });
  });
};

// 고객 납품 승인
window.clientApproveDelivery = function clientApproveDelivery() {
  var oid = window._currentClientOrderId;
  if (!oid) { showToast('⚠️ 주문 정보를 찾을 수 없습니다.'); return; }
  if (!confirm('납품을 승인하시겠습니까?\n승인 후에는 되돌릴 수 없습니다.')) return;

  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
    var q = fs.query(fs.collection(window._db,'orders'), fs.where('orderId','==',oid), fs.limit(1));
    fs.getDocs(q).then(function(snap) {
      var docRef = snap.empty ? fs.doc(window._db,'orders',oid) : snap.docs[0].ref;
      return fs.setDoc(docRef, { status: 'done', approvedAt: fs.serverTimestamp(), updatedAt: fs.serverTimestamp() }, { merge: true });
    }).then(function() {
      showToast('✅ 납품이 승인되었습니다. 감사합니다!');
      var panel = document.getElementById('reviewFeedbackPanel');
      if (panel) panel.style.display = 'none';
    }).catch(function(e) {
      showToast('⚠️ 처리 실패: ' + (e.code || e.message));
    });
  });
};

// 고객 수정 요청 (검수 단계에서)
window.clientRequestRevision = function clientRequestRevision() {
  // 수정 이력 섹션으로 스크롤 후 입력란 포커스
  var revArea = document.getElementById('rev-request-area');
  var input   = document.querySelector('#rev-input-list .rev-point-input');
  if (revArea) revArea.scrollIntoView({ behavior: 'smooth', block: 'center' });
  if (input)   { input.focus(); input.style.borderColor = 'var(--accent)'; }
  showToast('📝 아래 수정 요청 입력란에 내용을 작성해주세요.');
};

// 수정 요청 완료 처리
window.adminCompleteRevision = function adminCompleteRevision(revIdx, oid) {
  if (!window._db || !oid) return;
  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
    var q = fs.query(fs.collection(window._db,'orders'), fs.where('orderId','==',oid), fs.limit(1));
    fs.getDocs(q).then(function(snap) {
      if (snap.empty) return;
      var docRef = snap.docs[0].ref;
      var data   = snap.docs[0].data();
      var reqs   = (data.revisionRequests || data.revisions || []).slice();
      if (!reqs[revIdx]) return;
      reqs[revIdx] = Object.assign({}, reqs[revIdx], { status: 'completed' });
      var field = data.revisionRequests ? 'revisionRequests' : 'revisions';
      return fs.updateDoc(docRef, { [field]: reqs, updatedAt: fs.serverTimestamp() });
    }).then(function() {
      showToast('✅ ' + (revIdx+1) + '차 수정 요청이 완료 처리되었습니다.');
      if (typeof fillAdminOrderDetail === 'function' && window._currentAdminOrderId)
        showAdminOrderDetail(window._currentAdminOrderId);
    }).catch(function(e) {
      showToast('⚠️ 처리 실패: ' + (e.code || e.message));
    });
  });
};

// 입금 확인 완료 처리
function adminConfirmPayment() {
  const orderId = window._currentAdminOrderId;
  if (!orderId) { showToast('⚠️ 주문을 먼저 선택해주세요'); return; }
  adminChangeOrderStatus(orderId, 'pending', '소스대기');
  // 입금 확인 블록 숨기기
  const block = document.getElementById('adminPayConfirmBlock');
  if (block) block.style.display = 'none';
  // 입금대기 카운트 업데이트
  const badge = document.getElementById('paymentPendingBadge');
  if (badge) {
    const m = badge.textContent.match(/\d+/);
    const cur = m ? parseInt(m[0]) : 1;
    if (cur > 1) badge.textContent = '💰 입금 확인 대기 ' + (cur - 1) + '건';
    else badge.style.display = 'none';
  }
  showToast('✅ 입금이 확인되었습니다. 곧 파일 업로드 링크를 보내드리겠습니다.');
}

function adminSendReview() {
  const orderId = window._currentAdminOrderId;
  if (!orderId) { showToast('⚠️ 주문을 먼저 선택해주세요'); return; }
  adminChangeOrderStatus(orderId, 'review', '검수중');
  showToast('📨 검수 요청이 의뢰인에게 발송되었습니다');
}

// 납품 완료 처리
function adminCompleteDone() {
  const orderId = window._currentAdminOrderId;
  if (!orderId) { showToast('⚠️ 주문을 먼저 선택해주세요'); return; }
  adminChangeOrderStatus(orderId, 'done', '납품완료');
  const doneEl = document.querySelector('#admin-order-detail [style*="color:var(--orange)"]');
  if (doneEl) { doneEl.style.color = '#10b981'; doneEl.textContent = '납품 완료'; }
  showToast('🎉 납품 완료! 의뢰인에게 알림이 발송되었습니다');
}

// 요금제 저장
function adminSavePricing(plan) {
  const state = getAdminState();
  const inputMap = { STARTER:'priceStarter', STANDARD:'priceStandard', PRO:'pricePro', PREMIUM:'pricePremium', ENTERPRISE:'priceEnterprise' };
  const el = document.getElementById(inputMap[plan]);
  if (el) {
    const val = parseInt(el.value.replace(/,/g,''));
    if (!isNaN(val)) {
      state.pricing[plan] = val;
      saveAdminState(state);
      showToast(`✓ ${plan} 플랜 요금이 ₩${val.toLocaleString()}으로 저장되었습니다`);
    }
  } else {
    showToast(`✓ ${plan} 플랜이 저장되었습니다`);
  }
}

// 관리자 계정 상태 변경
function adminToggleAccount(email, action) {
  const state = getAdminState();
  if (state.admins[email]) {
    state.admins[email].status = action === 'activate' ? 'active' : 'inactive';
    saveAdminState(state);
  }
  // 버튼 UI 업데이트
  const btn = event.target;
  const row = btn.closest('tr');
  if (row) {
    const statusCell = row.querySelector('td:nth-child(5)');
    if (statusCell) {
      if (action === 'activate') {
        statusCell.innerHTML = '<span class="badge badge-review" style="font-size:11px">활성</span>';
        btn.textContent = '비활성화';
        btn.onclick = () => adminToggleAccount(email, 'deactivate');
        btn.className = 'btn btn-outline';
        btn.style.cssText = 'padding:5px 10px;font-size:11px;color:var(--red);border-color:var(--red)';
      } else {
        statusCell.innerHTML = '<span class="badge badge-pending" style="font-size:11px">비활성</span>';
        btn.textContent = '활성화';
        btn.onclick = () => adminToggleAccount(email, 'activate');
        btn.className = 'btn btn-primary';
        btn.style.cssText = 'padding:5px 10px;font-size:11px';
      }
    }
  }
  showToast(`✓ ${email} 계정이 ${action === 'activate' ? '활성화' : '비활성화'}되었습니다`);
}

// 새 관리자 초대
function adminInviteAccount() {
  const email = document.getElementById('newAdminEmail')?.value?.trim();
  const nameEl = document.querySelector('#tab-a-admins input[placeholder="홍길동"]');
  const name = nameEl?.value?.trim();
  const roleEl = document.querySelector('#tab-a-admins select');
  const role = roleEl?.value || 'ops';
  if (!email || !email.includes('@')) { showToast('⚠️ 이메일을 입력해주세요'); return; }
  if (!name) { showToast('⚠️ 이름을 입력해주세요'); return; }

  const state = getAdminState();
  state.admins[email] = { name, role, status: 'invited' };
  saveAdminState(state);

  // 테이블에 행 추가
  const tbody = document.querySelector('#tab-a-admins .data-table');
  if (tbody) {
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td style="font-weight:600">${name}</td>
      <td style="font-size:13px;color:var(--gray-400)">${email}</td>
      <td><span class="badge badge-pending" style="font-size:11px">${role === 'master' ? '마스터' : role === 'ops' ? '운영담당' : 'CS'}</span></td>
      <td style="font-size:13px;color:var(--gray-400)">초대 발송됨</td>
      <td><span class="badge" style="background:#fef3c7;color:#92400e;font-size:11px">초대중</span></td>
      <td>
        <button class="btn btn-outline" style="padding:5px 10px;font-size:11px" onclick="showToast('권한이 수정되었습니다')">수정</button>
        <button class="btn btn-outline" style="padding:5px 10px;font-size:11px;color:var(--red);border-color:var(--red)" onclick="adminToggleAccount('${email}','deactivate')">비활성화</button>
      </td>
    `;
    tbody.appendChild(tr);
  }
  if (document.getElementById('newAdminEmail')) document.getElementById('newAdminEmail').value = '';
  if (nameEl) nameEl.value = '';
  showToast(`📨 ${email}로 초대 링크가 발송되었습니다`);
}

// 에디터 등록
function adminRegisterEditor() {
  const nameEl = document.querySelector('#tab-a-editors input[placeholder="영어 닉네임"]');
  const specEl = document.querySelector('#tab-a-editors select');
  const name = nameEl?.value?.trim();
  const spec = specEl?.value || '유튜브/롱폼';
  if (!name) { showToast('⚠️ 에디터 닉네임을 입력해주세요'); return; }

  const state = getAdminState();
  state.editors[name] = { spec, status: 'active', projects: 0 };
  saveAdminState(state);

  // 테이블에 행 추가
  const tbody = document.querySelector('#tab-a-editors .data-table');
  if (tbody) {
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td style="font-weight:600">${name}</td>
      <td style="font-size:13px;color:var(--gray-400)">${spec}</td>
      <td><span class="badge badge-review" style="font-size:11px">활성</span></td>
      <td style="font-size:13px">0건</td>
      <td style="font-size:13px;color:var(--green);font-weight:600">0%</td>
      <td><button class="btn btn-outline" style="padding:5px 12px;font-size:12px" onclick="showEditorDetail(this)">상세</button></td>
    `;
    tbody.appendChild(tr);
  }
  if (nameEl) nameEl.value = '';
  showToast(`✓ ${name} 에디터가 등록되었습니다`);
}

// ===== 새 의뢰 제출 시뮬레이션 =====
window.submitOrder = function submitOrder() {
  const name = document.getElementById('newOrderName')?.value?.trim();
  const planEl = document.getElementById('newOrderPlan');
  const type = document.getElementById('newOrderType')?.value;
  const desc = document.getElementById('newOrderDesc')?.value?.trim();
  const deadline = document.getElementById('newOrderDeadline')?.value;

  if (!name) { showToast('⚠️ 프로젝트명을 입력해주세요'); return; }
  if (!desc) { showToast('⚠️ 편집 요구사항을 입력해주세요'); return; }

  const [planName, planPrice] = (planEl?.value || 'STANDARD|120000').split('|');
  const basePrice = parseInt(planPrice);
  const isExpress = deadline && deadline === 'express';
  const expressAmt = isExpress ? Math.round(basePrice * 0.5) : 0;
  const price = basePrice + expressAmt;
  const vat = Math.round(price * 0.1);
  const total = price + vat;
  const deadlineLabel = isExpress ? '익스프레스 (24시간 · +50%)' : (deadline === '2-3days' ? '영업일 3~5일 이내' : '영업일 3~5일 이내');

  // 결제 확인 모달 (심플 confirm 시뮬레이션)
  // 주문번호 미리 생성 — 고객이 모달에서 확인 후 입금 시 기재
  const preOrderNum = 'FC-' + String(Math.floor(Math.random() * 900) + 100).padStart(4,'0');
  showOrderPayModal({ name, planName, type, deadline: deadlineLabel, price, vat, total, basePrice, expressAmt, preOrderNum });
}

function showOrderPayModal(order) {
  const existing = document.getElementById('orderPayModal');
  if (existing) existing.remove();

  const hasExpress = order.expressAmt && order.expressAmt > 0;

  const modal = document.createElement('div');
  modal.id = 'orderPayModal';
  modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px;overflow-y:auto';
  modal.innerHTML = `
    <div style="background:white;border-radius:20px;padding:32px;max-width:480px;width:100%;box-shadow:0 20px 60px rgba(0,0,0,0.2);margin:auto">
      <div style="font-size:11px;font-weight:700;color:var(--accent);letter-spacing:1px;margin-bottom:6px">계좌이체 안내</div>
      <div style="font-size:20px;font-weight:900;color:var(--primary);margin-bottom:20px;letter-spacing:-0.5px">${order.name}</div>

      <!-- 주문 금액 요약 -->
      <div style="background:var(--gray-50);border-radius:12px;padding:16px;margin-bottom:16px">
        <div style="display:flex;justify-content:space-between;font-size:13px;padding:5px 0;border-bottom:1px solid var(--gray-200)">
          <span style="color:var(--gray-500)">플랜</span>
          <span style="font-weight:700;color:var(--accent)">${order.planName}</span>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:13px;padding:5px 0;border-bottom:1px solid var(--gray-200)">
          <span style="color:var(--gray-500)">납품 기간</span>
          <span style="font-weight:600">${order.deadline}</span>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:13px;padding:5px 0;border-bottom:1px solid var(--gray-200)">
          <span style="color:var(--gray-500)">기본 금액</span>
          <span style="font-weight:600">₩${(order.basePrice||order.price).toLocaleString()}</span>
        </div>
        ${hasExpress ? '<div style="display:flex;justify-content:space-between;font-size:13px;padding:5px 0;border-bottom:1px solid var(--gray-200)"><span style="color:#d97706">익스프레스 할증</span><span style="font-weight:600;color:#d97706">+₩' + (order.expressAmt||0).toLocaleString() + '</span></div>' : ''}
        <div style="display:flex;justify-content:space-between;font-size:13px;padding:5px 0;border-bottom:1px solid var(--gray-200)">
          <span style="color:var(--gray-500)">VAT (10%)</span>
          <span style="font-weight:600">₩${order.vat.toLocaleString()}</span>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:17px;font-weight:900;padding:10px 0 4px">
          <span style="color:var(--primary)">입금 금액</span>
          <span style="color:var(--accent)">₩${order.total.toLocaleString()}</span>
        </div>
      </div>

      <!-- 주문번호 강조 표시 -->
      <div style="background:#f0fdf4;border:1.5px solid #86efac;border-radius:12px;padding:14px 16px;margin-bottom:12px;display:flex;align-items:center;justify-content:space-between">
        <div>
          <div style="font-size:11px;font-weight:700;color:#166534;margin-bottom:4px">📋 주문번호 (입금 시 필수 기재)</div>
          <div style="font-size:22px;font-weight:900;color:#166534;font-family:Pretendard,sans-serif;letter-spacing:1px">#${order.preOrderNum}</div>
        </div>
        <button onclick="navigator.clipboard&&navigator.clipboard.writeText('${order.preOrderNum}').then(function(){showToast('주문번호가 복사되었습니다')})" style="background:#166534;color:white;border:none;border-radius:8px;padding:8px 14px;font-size:12px;font-weight:700;cursor:pointer">복사</button>
      </div>

      <!-- 계좌 정보 -->
      <div style="background:var(--accent-light);border:1.5px solid var(--accent);border-radius:12px;padding:16px;margin-bottom:16px">
        <div style="font-size:12px;font-weight:700;color:var(--accent);margin-bottom:10px">🏦 입금 계좌 정보</div>
        <div style="display:grid;grid-template-columns:auto 1fr;gap:6px 12px;font-size:14px">
          <span style="color:var(--gray-500);font-size:13px">은행</span>
          <span style="font-weight:700">우리은행</span>
          <span style="color:var(--gray-500);font-size:13px">계좌번호</span>
          <span style="font-weight:700;font-family:Pretendard,sans-serif;letter-spacing:0.5px">1005-304-593104</span>
          <span style="color:var(--gray-500);font-size:13px">예금주</span>
          <span style="font-weight:700">주식회사 온니바이어</span>
          <span style="color:var(--gray-500);font-size:13px">입금액</span>
          <span style="font-weight:900;color:var(--accent)">₩${order.total.toLocaleString()}</span>
        </div>
        <div style="margin-top:12px;padding:10px;background:white;border-radius:8px;font-size:12px;color:var(--gray-600);line-height:1.7">
          ⚠️ 입금 시 <strong>주문번호(#${order.preOrderNum})와 회사명</strong>을 함께 기재해주세요.<br>
          ✅ 입금 확인 후 담당자가 <strong>채널톡으로 연락</strong>드립니다.
        </div>
      </div>

      <!-- 세금계산서/현금영수증 선택 -->
      <div style="border:1px solid var(--gray-200);border-radius:12px;padding:16px;margin-bottom:16px">
        <div style="font-size:12px;font-weight:700;color:var(--primary);margin-bottom:12px">📄 증빙 서류 선택</div>
        <div style="display:flex;flex-direction:column;gap:8px">
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:14px">
            <input type="radio" name="taxType" value="tax" onchange="handleTaxTypeChange(this.value)" style="accent-color:var(--accent)">
            세금계산서 발행
          </label>
          <div id="taxInputWrap" style="display:none;margin-left:24px;display:flex;flex-direction:column;gap:8px">
            <input class="form-input" id="taxBizNum" placeholder="사업자번호 (000-00-00000)" style="font-size:13px;padding:8px 12px" maxlength="12">
            <input class="form-input" id="taxCompany" placeholder="상호명 (법인명)" style="font-size:13px;padding:8px 12px">
            <input class="form-input" id="taxEmail" type="email" placeholder="세금계산서 수신 이메일" style="font-size:13px;padding:8px 12px">
          </div>
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:14px">
            <input type="radio" name="taxType" value="cash" onchange="handleTaxTypeChange(this.value)" style="accent-color:var(--accent)">
            현금영수증 발행
          </label>
          <div id="cashInputWrap" style="display:none;margin-left:24px">
            <input class="form-input" id="cashPhone" placeholder="휴대폰번호 (010-0000-0000)" style="font-size:13px;padding:8px 12px">
          </div>
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:14px">
            <input type="radio" name="taxType" value="none" onchange="handleTaxTypeChange(this.value)" style="accent-color:var(--accent)" checked>
            필요없음
          </label>
        </div>
      </div>

      <!-- NDA 약관 동의 -->
      <div style="background:#f8f9ff;border:1.5px solid #c4b5fd;border-radius:12px;padding:16px;margin-bottom:16px">
        <div style="font-size:13px;font-weight:700;color:#4c1d95;margin-bottom:8px">📋 기밀유지 약관 동의 (필수)</div>
        <div style="font-size:12px;color:#5b21b6;line-height:1.7;margin-bottom:8px;word-break:keep-all">
          에이컷은 고객사의 원본 파일 및 기밀 정보를 외부에 공개하지 않으며,
          납품 완료 후 30일 이내 완전 삭제합니다.
        </div>
        <span onclick="var d=document.getElementById('orderNdaFull');d.style.display=d.style.display==='none'?'block':'none';this.textContent=d.style.display==='block'?'전문 접기 ↑':'전문 보기 ↓'"
          style="font-size:12px;color:#7c3aed;cursor:pointer;text-decoration:underline;display:inline-block;min-height:36px;line-height:36px">전문 보기 ↓</span>
        <div id="orderNdaFull" style="display:none;font-size:11px;color:#5b21b6;line-height:1.8;background:#ede9fe;border-radius:8px;padding:12px;margin:8px 0;max-height:150px;overflow-y:auto;-webkit-overflow-scrolling:touch">
          <strong>제1조</strong> 고객사가 제공하는 영상 원본 파일, 브랜드 소재, 미공개 콘텐츠, 경영 정보 일체를 기밀 정보로 규정합니다.<br><br>
          <strong>제2조</strong> 에이컷은 기밀 정보를 제3자에게 제공하거나 외부에 공개하지 않으며, 내부 편집 작업 목적으로만 사용합니다.<br><br>
          <strong>제3조</strong> 납품 완료 후 원본 파일은 30일 이내 완전 삭제하며, 고객 요청 시 즉시 삭제합니다.<br><br>
          <strong>제4조</strong> 고객사 사전 서면 동의 없이 작업물을 포트폴리오 또는 홍보 목적으로 사용하지 않습니다.<br><br>
          <strong>제5조</strong> 본 약관 위반 시 관련 법령에 따른 손해배상 책임을 집니다.
        </div>
        <label style="display:flex;align-items:center;gap:10px;margin-top:10px;cursor:pointer;min-height:44px">
          <input type="checkbox" id="orderNdaCheck" style="width:20px;height:20px;accent-color:#7c3aed;flex-shrink:0"
            onchange="document.getElementById('orderPayConfirmBtn').disabled=!this.checked">
          <span style="font-size:13px;font-weight:600;color:#4c1d95;word-break:keep-all;line-height:1.4">기밀유지 약관을 확인하였으며 동의합니다</span>
        </label>
      </div>

      <div style="display:flex;gap:10px">
        <button class="btn btn-outline btn-full" id="orderPayCancelBtn">취소</button>
        <button class="btn btn-primary btn-full btn-lg" id="orderPayConfirmBtn" disabled>💳 입금 완료했습니다</button>
      </div>
      <div style="font-size:11px;color:var(--gray-400);text-align:center;margin-top:12px">
        입금 확인 전까지 주문이 자동으로 보류됩니다
      </div>
    </div>
  `;
  document.body.appendChild(modal);

  // onclick 대신 addEventListener — order 객체 직접 전달 (JSON 파싱 오류 방지)
  document.getElementById('orderPayCancelBtn').addEventListener('click', function() {
    document.getElementById('orderPayModal').remove();
  });
  document.getElementById('orderPayConfirmBtn').addEventListener('click', function() {
    completeOrder(order);
  });
}

function handleTaxTypeChange(val) {
  var taxWrap  = document.getElementById('taxInputWrap');
  var cashWrap = document.getElementById('cashInputWrap');
  if (taxWrap)  taxWrap.style.display  = val === 'tax'  ? 'flex' : 'none';
  if (cashWrap) cashWrap.style.display = val === 'cash' ? 'block' : 'none';
}

function completeOrder(order) {
  // ① 모달 DOM 제거 전에 값 먼저 읽기 (제거 후엔 getElementById가 null 반환)
  var _ndaAgreed  = !!(document.getElementById('orderNdaCheck') || {checked:false}).checked;
  var _taxTypeEl  = document.querySelector('input[name="taxType"]:checked');
  var _taxType    = _taxTypeEl ? _taxTypeEl.value : 'none';
  var _taxBizNum  = (document.getElementById('taxBizNum')  || {value:''}).value.trim();
  var _taxCompany = (document.getElementById('taxCompany') || {value:''}).value.trim();
  var _taxEmail   = (document.getElementById('taxEmail')   || {value:''}).value.trim();
  var _cashPhone  = (document.getElementById('cashPhone')  || {value:''}).value.trim();
  var _descVal    = (document.getElementById('newOrderDesc') || {value:''}).value;
  var _refVal     = (document.getElementById('newOrderRef')  || {value:''}).value;

  // ② 이제 모달 제거
  document.getElementById('orderPayModal')?.remove();

  const now = new Date();
  // 모달에서 미리 생성된 주문번호 사용 (없으면 새로 생성)
  const orderNum = order.preOrderNum || ('FC-' + String(Math.floor(Math.random() * 900) + 100).padStart(4,'0'));
  const dateStr = `${now.getFullYear()}.${String(now.getMonth()+1).padStart(2,'0')}.${String(now.getDate()).padStart(2,'0')}`;
  const days = order.deadline.includes('24') ? 1 : order.deadline.includes('2~3') ? 3 : 5;
  const dDate = new Date(now); dDate.setDate(dDate.getDate() + days);
  const dStr = `${dDate.getFullYear()}.${String(dDate.getMonth()+1).padStart(2,'0')}.${String(dDate.getDate()).padStart(2,'0')}`;

  // 세션에서 고객 이름 가져오기
  const session = getSession();
  const clientName = session ? session.name : '신규 고객';

  // 값은 이미 모달 제거 전에 읽음
  var taxType  = _taxType;
  var taxValue = _taxType === 'tax' ? _taxBizNum : (_taxType === 'cash' ? _cashPhone : '');
  var descVal  = _descVal;
  var refVal   = _refVal;

  // DOM 직접 추가 제거 — onSnapshot이 자동으로 렌더링함 (중복 방지)
  // 대시보드 카운터만 업데이트
  try {
    var payBadge = document.getElementById('paymentPendingBadge');
    if (payBadge) {
      var m2 = payBadge.textContent.match(/\d+/);
      payBadge.textContent = '💰 입금 확인 대기 ' + ((m2 ? parseInt(m2[0]) : 0) + 1) + '건';
      payBadge.style.display = 'block';
    }
  } catch(e) {}

  // ── localStorage 저장 ──
  try {
    var state = getAdminState();
    state.orders[orderNum] = {
      orderId: orderNum, userId: session ? session.email : '',
      planName: order.planName, type: order.type, desc: descVal, ref: refVal,
      deadline: order.deadline, basePrice: order.basePrice || order.price,
      expressAmt: order.expressAmt || 0, price: order.price,
      vat: order.vat, total: order.total, status: 'pending',
      taxType: taxType, taxValue: taxValue,
      createdAt: now.toISOString(), title: order.name,
      client: clientName, editor: '', deadlineDate: dStr,
    };
    saveAdminState(state);
  } catch(e) {
    console.warn('[localStorage] 저장 실패 (무시):', e.message);
  }

  // ── Firestore 저장 (항상 실행) ──
  var user = window._fbAuth && window._fbAuth.currentUser;
  if (!user) {
    console.error('[Firestore] ❌ currentUser 없음 — 로그인 필요');
    showToast('로그인이 필요합니다');
    return;
  } else if (!window._db) {
    console.error('[Firestore] ❌ _db 없음 — Firestore 초기화 실패');
    showToast('⚠️ 데이터베이스 연결 오류');
    return;
  }
  console.log('[Firestore] 주문 저장 시작 — uid:', user.uid, '/ email:', user.email);
  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {
      fs.addDoc(fs.collection(window._db, 'orders'), {
        orderId:     orderNum,
        userId:      user.uid,
        clientName:  clientName,
        clientEmail: user.email,
        planName:    order.planName,
        price:       order.total,
        basePrice:   order.basePrice || order.price,
        expressAmt:  order.expressAmt || 0,
        vat:         order.vat,
        type:        order.type,
        desc:        descVal,
        ref:         refVal,
        deadline:    order.deadline,
        deadlineDate: dStr,
        status:      'payment_pending',
        ndaAgreed:   _ndaAgreed,
        ndaAgreedAt: _ndaAgreed ? fs.serverTimestamp() : null,
        ndaVersion:  'v1.0',
        taxType:     _taxType   || 'none',
        taxBizNum:   _taxBizNum  || '',
        taxCompany:  _taxCompany || '',
        taxEmail:    _taxEmail   || '',
        receiptNum:  _cashPhone  || '',
        title:       order.name,
        editor:      '',
        createdAt:   fs.serverTimestamp(),
      })
      .then(function(docRef) {
        console.log('[Firestore] 주문 저장 성공 ✅ docId:', docRef.id, '/ orderId:', orderNum);
        // onSnapshot이 자동 감지하지만 명시적 호출로 보장
        setTimeout(function() {
          if (typeof loadAdminOrders === 'function') loadAdminOrders();
        }, 800);
      })
      .catch(function(e) {
        console.error('[Firestore] 저장 실패:', e.code, e.message);
        showToast('⚠️ 주문 저장 실패: ' + (e.code || e.message));
      });
    });

  // ── 폼 초기화 + 이동
  ['newOrderName','newOrderDesc','newOrderRef'].forEach(id => {
    const el = document.getElementById(id); if (el) el.value = '';
  });

  showToast(`✅ 주문이 접수되었습니다. 입금 확인 후 카카오톡으로 안내드립니다.`);
  setTimeout(() => {
    showTab('client','c-orders', null);
    setClientTab(document.querySelector('.client-bottom-nav a:nth-child(3)'));
    showOrderSuccessBanner(orderNum, order.name);
  }, 800);
}

function showOrderSuccessBanner(orderNum, orderName) {
  const existing = document.getElementById('orderSuccessBanner');
  if (existing) existing.remove();
  const banner = document.createElement('div');
  banner.id = 'orderSuccessBanner';
  banner.style.cssText = 'background:linear-gradient(135deg,var(--accent),#7c3aed);color:white;border-radius:14px;padding:20px 24px;margin-bottom:20px;display:flex;align-items:center;gap:16px;animation:fadeIn .4s ease';
  banner.innerHTML = `
    <div style="font-size:32px">🎉</div>
    <div style="flex:1">
      <div style="font-size:15px;font-weight:800;margin-bottom:4px">#${orderNum} 접수 완료!</div>
      <div style="font-size:13px;opacity:.9">${orderName}</div>
      <div style="font-size:12px;opacity:.8;margin-top:4px">우리은행 1005-304-593104 (주식회사 온니바이어)로 입금 후 카카오톡으로 안내드립니다.</div>
    </div>
    <button onclick="document.getElementById('orderSuccessBanner').remove()" style="background:rgba(255,255,255,0.2);border:none;color:white;font-size:16px;cursor:pointer;border-radius:8px;padding:4px 10px">✕</button>
  `;
  const orderTab = document.getElementById('tab-c-orders');
  if (orderTab) orderTab.insertBefore(banner, orderTab.firstChild);
}

// ===== 수정 이력 =====
function addRevInput() {
  const list = document.getElementById('rev-input-list');
  const row = document.createElement('div');
  row.className = 'rev-input-row';
  row.innerHTML = `
    <input class="form-input rev-point-input" placeholder="수정 내용을 구체적으로 입력해주세요" style="flex:1;font-size:13px">
    <button class="btn btn-outline" style="padding:8px 12px;font-size:12px;color:var(--red);border-color:var(--red)" onclick="this.parentElement.remove()">✕</button>`;
  list.appendChild(row);
  row.querySelector('input').focus();
}

function submitRevision() {
  var inputs = document.querySelectorAll('.rev-point-input');
  var points = [].slice.call(inputs).map(function(i){ return i.value.trim(); }).filter(Boolean);
  if (!points.length) { showToast('⚠️ 수정 내용을 한 개 이상 입력해주세요'); return; }

  var oid = window._currentClientOrderId;
  if (!oid) { showToast('⚠️ 주문 정보를 찾을 수 없습니다. 다시 시도해주세요.'); return; }

  var user = window._fbAuth && window._fbAuth.currentUser;
  if (!user) { showToast('⚠️ 로그인이 필요합니다.'); return; }

  var today = new Date();
  var dateStr = today.getFullYear() + '.' +
    String(today.getMonth()+1).padStart(2,'0') + '.' +
    String(today.getDate()).padStart(2,'0');

  // Firestore에 저장할 수정 요청 객체
  if (!window._db) { showToast('⚠️ 서버 연결을 확인해주세요.'); return; }

  // arrayUnion 내부에는 serverTimestamp() 사용 불가 → ISO 문자열 사용
  var revisionEntry = {
    items:       points,
    date:        dateStr,
    status:      'pending',
    requestedBy: user.uid,
    requestedAt: new Date().toISOString(),
  };

  import('https://www.gstatic.com/firebasejs/11.6.0/firebase-firestore.js').then(function(fs) {

    // 1단계: orderId 필드로 쿼리
    var q = fs.query(fs.collection(window._db,'orders'), fs.where('orderId','==',oid), fs.limit(1));

    fs.getDocs(q).then(function(snap) {
      var docRef;
      if (!snap.empty) {
        docRef = snap.docs[0].ref;
        console.log('[Revision] orderId 쿼리 성공, docId:', docRef.id);
      } else {
        // 2단계: 문서ID 직접 시도
        docRef = fs.doc(window._db, 'orders', oid);
        console.log('[Revision] orderId 쿼리 없음, docId 직접 사용:', oid);
      }

      // setDoc merge:true — 문서 없어도 생성, 있으면 병합
      return fs.setDoc(docRef, {
        revisionRequests: fs.arrayUnion(revisionEntry),
        updatedAt: fs.serverTimestamp(),
      }, { merge: true });

    }).then(function() {
      console.log('[Revision] ✅ 저장 완료 orderId:', oid);
      showToast('✅ 수정 요청이 접수되었습니다. 에디터에게 전달됩니다.');
      // 입력란 초기화
      var allInputs = document.querySelectorAll('#rev-input-list .rev-point-input');
      allInputs[0].value = '';
      [].slice.call(allInputs).slice(1).forEach(function(inp) {
        var row = inp.closest('.rev-input-row');
        if (row) row.remove();
      });
      _appendRevisionBlock(points, dateStr, 'pending');
    }).catch(function(e) {
      console.error('[Revision] ❌ 실패 code:', e.code, 'msg:', e.message);
      showToast('⚠️ 저장 실패 (' + (e.code || e.message) + ')');
    });

  }).catch(function(e) {
    console.error('[Revision] import 실패:', e.message);
    showToast('⚠️ 서버 연결 오류. 새로고침 후 재시도해주세요.');
  });
}

// 수정이력 블록 렌더링 헬퍼
function _appendRevisionBlock(items, dateStr, status, revIdx) {
  var rounds = document.querySelectorAll('#revisionList .rev-round');
  var numLabel = (revIdx !== undefined ? revIdx + 1 : rounds.length + 1) + '차';
  var isDone = status === 'completed' || status === 'done';
  var block = document.createElement('div');
  block.className = 'rev-round ' + (isDone ? 'done' : 'active');
  var itemsHtml = (items || []).map(function(p) {
    return '<div class="rev-item ' + (isDone ? 'done' : 'pending') + '">' +
      '<span class="rev-check ' + (isDone ? '' : 'pend') + '">' + (isDone ? '✓' : '→') + '</span>' + p + '</div>';
  }).join('');
  block.innerHTML =
    '<div class="rev-round-header">' +
      '<div style="display:flex;align-items:center;gap:8px">' +
        '<span class="rev-num" style="' + (isDone ? '' : 'background:var(--orange);color:white') + '">' + numLabel + '</span>' +
        '<span class="rev-date">' + (dateStr || '') + '</span>' +
        (isDone ? '' : '<span style="font-size:11px;color:var(--orange);font-weight:600">· 에디터 확인 중</span>') +
      '</div>' +
      '<span class="badge ' + (isDone ? 'badge-done' : 'badge-pending') + '" style="font-size:11px">' +
        (isDone ? '반영 완료' : '에디터 확인 중') + '</span>' +
    '</div>' +
    '<div class="rev-items">' + itemsHtml + '</div>';
  var listEl = document.getElementById('revisionList');
  if (listEl) {
    // 빈 상태 메시지 제거 후 appendChild
    var empty = listEl.querySelector('[style*="text-align:center"]');
    if (empty) empty.remove();
    listEl.appendChild(block);
  }
}

// ===== PAYMENT MODAL =====
let _payPlan = {}, _payMethod = 'card';

function openPayment(plan, price, desc, deadline) {
  // 엔터프라이즈 → 결제 팝업 대신 B2B 문의 안내
  if (plan === 'ENTERPRISE' || parseInt(price) === 0) {
    showToast('💼 ENTERPRISE 플랜은 맞춤 견적 후 진행됩니다.');
    setTimeout(function() { openB2B(); }, 400);
    return;
  }
  _payPlan = { plan, price: parseInt(price), desc, deadline };
  document.getElementById('pay-plan-badge').textContent = plan;
  document.getElementById('pay-plan-price').textContent = '₩' + parseInt(price).toLocaleString('ko-KR');
  document.getElementById('opt-express-price').textContent = '+₩' + Math.round(parseInt(price) * 0.5).toLocaleString('ko-KR');
  // 인풋 초기화
  ['pay-title','pay-length','pay-memo','pay-filelink','pay-cardnum','pay-expiry','pay-cvc'].forEach(id => {
    const el = document.getElementById(id); if (el) el.value = '';
  });
  ['opt-express','opt-subtitle','opt-thumbnail'].forEach(id => { document.getElementById(id).checked = false; });
  document.getElementById('pay-quantity').value = '1';
  document.getElementById('pay-rawlength').value = '0';
  document.getElementById('raw-surcharge-notice').style.display = 'none';
  document.getElementById('pay-installment').value = '0';
  // 스텝 리셋
  showPayStep(1);
  document.getElementById('paymentModal').style.display = 'flex';
  if (typeof window._trackBeginCheckout === 'function') window._trackBeginCheckout(plan, parseInt(price));
  document.body.style.overflow = 'hidden';
}

function closePayment() {
  document.getElementById('paymentModal').style.display = 'none';
  document.body.style.overflow = '';
}

function showPayStep(n) {
  [1,2,3].forEach(i => {
    document.getElementById('pay-step' + i).style.display = i === n ? 'block' : 'none';
    const dot = document.getElementById('ps' + i);
    dot.className = 'pay-step-dot' + (i === n ? ' active' : i < n ? ' done' : '');
    if (i < 3) {
      const line = document.getElementById('pl' + i);
      line.className = 'pay-step-line' + (i < n ? ' done' : '');
    }
  });
}

function updateRawSurcharge() {
  const sel = document.getElementById('pay-rawlength');
  const pct = parseInt(sel.value);
  const notice = document.getElementById('raw-surcharge-notice');
  const label = document.getElementById('raw-surcharge-label');
  if (pct === 0) {
    notice.style.display = 'none';
  } else {
    notice.style.display = 'block';
    const add = Math.round(_payPlan.price * pct / 100);
    label.textContent = `원본 분량 할증 +${pct}% → +₩${add.toLocaleString('ko-KR')} 추가`;
  }
}

function calcTotal() {
  let total = _payPlan.price;
  const rawPct = parseInt((document.getElementById('pay-rawlength') || {}).value || '0');
  total += Math.round(_payPlan.price * rawPct / 100);
  if (document.getElementById('opt-express').checked) total += Math.round(_payPlan.price * 0.5);
  if (document.getElementById('opt-subtitle').checked) total += 30000;
  if (document.getElementById('opt-thumbnail').checked) total += 15000;
  return Math.round(total * 1.1); // VAT 10%
}

function payStep(n) {
  if (n === 2) {
    if (!document.getElementById('pay-title').value.trim()) {
      showToast('⚠️ 프로젝트 제목을 입력해주세요'); return;
    }
    // 주문 요약 업데이트
    document.getElementById('pay-summary-plan').textContent = _payPlan.plan + ' 플랜';
    document.getElementById('pay-summary-base').textContent = '₩' + _payPlan.price.toLocaleString('ko-KR');
    let optRows = '';
    const rawPct = parseInt(document.getElementById('pay-rawlength').value || '0');
    if (rawPct > 0) {
      const rawAdd = Math.round(_payPlan.price * rawPct / 100);
      const rawLabel = rawPct === 20 ? '원본 분량 할증 (1~3시간)' : '원본 분량 할증 (3시간+)';
      optRows += `<div style="display:flex;justify-content:space-between;margin-bottom:4px"><span>${rawLabel}</span><span>+₩${rawAdd.toLocaleString('ko-KR')}</span></div>`;
    }
    if (document.getElementById('opt-express').checked)
      optRows += `<div style="display:flex;justify-content:space-between;margin-bottom:4px"><span>익스프레스 납품</span><span>+₩${Math.round(_payPlan.price*0.5).toLocaleString('ko-KR')}</span></div>`;
    if (document.getElementById('opt-subtitle').checked)
      optRows += `<div style="display:flex;justify-content:space-between;margin-bottom:4px"><span>일·한 자막 번역</span><span>+₩30,000</span></div>`;
    if (document.getElementById('opt-thumbnail').checked)
      optRows += `<div style="display:flex;justify-content:space-between;margin-bottom:4px"><span>썸네일 추가 제작</span><span>+₩15,000</span></div>`;
    optRows += `<div style="display:flex;justify-content:space-between;margin-bottom:4px;color:var(--gray-400)"><span>부가세(VAT 10%)</span><span></span></div>`;
    document.getElementById('pay-opt-rows').innerHTML = optRows;
    const total = calcTotal();
    document.getElementById('pay-total').textContent = '₩' + total.toLocaleString('ko-KR');
    document.getElementById('pay-submit-btn').textContent = '₩' + total.toLocaleString('ko-KR') + ' 결제하기';
    // 증빙 서류 select addEventListener (STEP2 진입 시 1회 등록)
    var _taxSel = document.getElementById('pay-tax-type');
    if (_taxSel && !_taxSel._listenerAdded) {
      _taxSel.addEventListener('change', function() {
        var v = this.value;
        var td = document.getElementById('pay-tax-detail');
        var rd = document.getElementById('pay-receipt-detail');
        if (td) td.style.display = v === 'tax'     ? 'block' : 'none';
        if (rd) rd.style.display = v === 'receipt' ? 'block' : 'none';
      });
      _taxSel._listenerAdded = true;
    }
  }
  if (n === 3) {
    // NDA 동의 확인
    var ndaCk = document.getElementById('pay-nda-agree');
    if (!ndaCk || !ndaCk.checked) {
      alert('비밀유지 서약(NDA) 동의가 필요합니다.');
      return;
    }
    // 카드 기본 validation
    if (_payMethod === 'card') {
      const cn = document.getElementById('pay-cardnum').value.replace(/\s/g,'');
      if (cn.length < 15) { showToast('⚠️ 카드 번호를 확인해주세요'); return; }
      const ex = document.getElementById('pay-expiry').value;
      if (ex.length < 5) { showToast('⚠️ 유효기간을 확인해주세요'); return; }
      if (document.getElementById('pay-cvc').value.length < 3) { showToast('⚠️ CVC를 확인해주세요'); return; }
    }
    // 결제 완료 화면
    const total = calcTotal();
    const orderId = '#FC-' + (1000 + Math.floor(Math.random()*9000));
    document.getElementById('pay-order-num').textContent = orderId;
    document.getElementById('done-plan').textContent = _payPlan.plan;
    document.getElementById('done-deadline').textContent = _payPlan.deadline;
    document.getElementById('done-amount').textContent = '₩' + total.toLocaleString('ko-KR');
  }
  showPayStep(n);
}

function selectPayMethod(el, method) {
  _payMethod = method;
  document.querySelectorAll('.pay-method-card').forEach(c => c.classList.remove('active'));
  el.classList.add('active');
  document.getElementById('pay-card-form').style.display = method === 'card' ? 'block' : 'none';
  document.getElementById('pay-vbank-form').style.display = method === 'vbank' ? 'block' : 'none';
  const labels = { card:'카드 결제하기', kakao:'카카오페이로 결제하기', naver:'네이버페이로 결제하기', vbank:'가상계좌 발급받기' };
  const total = calcTotal();
  document.getElementById('pay-submit-btn').textContent = '₩' + total.toLocaleString('ko-KR') + ' ' + (labels[method] || '결제하기');
}

function formatCard(el) {
  let v = el.value.replace(/\D/g,'').substring(0,16);
  el.value = v.replace(/(.{4})/g,'$1 ').trim();
}
function formatExpiry(el) {
  let v = el.value.replace(/\D/g,'').substring(0,4);
  if (v.length >= 2) v = v.substring(0,2) + ' / ' + v.substring(2);
  el.value = v;
}

// ===== 실시간 작업 현황 애니메이션 =====
(function() {
  let _stepStarted = false;

  function runStepAnim() {
    if (_stepStarted) return;
    _stepStarted = true;
    const rows = document.querySelectorAll('.step-flow .step-row');
    rows.forEach((row, i) => {
      setTimeout(() => {
        row.classList.add('visible');
        // 완료 행은 done 클래스 추가
        if (row.querySelector('.status-done')) {
          row.classList.add('done');
        }
      }, i * 320);
    });
  }

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) runStepAnim(); });
  }, { threshold: 0.4 });

  document.addEventListener('DOMContentLoaded', () => {
    const flow = document.querySelector('.step-flow');
    if (flow) observer.observe(flow);
  });
})();

// ===== PROCESS STEP ANIMATION =====
(function() {
  let _procIdx = 0;
  let _procTimer = null;
  let _procStarted = false;
  const TOTAL = 5;
  const STEP_DELAY = 1400; // 각 단계 간격 ms
  const PAUSE_AFTER_DONE = 1800; // 완료 후 대기 ms

  // 진행 라인 너비 계산 (0→25→50→75→100%)
  const lineWidths = [0, 20, 40, 60, 80];

  function setStep(idx) {
    const steps = document.querySelectorAll('.process-step');
    const line = document.getElementById('processLineFill');
    if (!steps.length || !line) return;

    steps.forEach((s, i) => {
      s.classList.remove('active', 'done');
      if (i < idx) s.classList.add('done');
      if (i === idx) s.classList.add('active');
      // done 상태는 숫자 숨기고 ✓ 표시
      const num = s.querySelector('.process-num');
      if (num) {
        if (i < idx) {
          num.style.fontSize = '0px';
        } else {
          num.style.fontSize = i === idx ? '18px' : '16px';
        }
      }
    });

    // 라인 진행
    const pct = idx === 0 ? 0 : (idx / (TOTAL - 1)) * 80;
    line.style.width = pct + '%';
  }

  function nextStep() {
    _procIdx = (_procIdx + 1) % TOTAL;
    setStep(_procIdx);

    if (_procIdx === TOTAL - 1) {
      // 마지막 단계 도달 — 잠시 대기 후 리셋
      clearInterval(_procTimer);
      setTimeout(() => {
        _procIdx = 0;
        setStep(0);
        _procTimer = setInterval(nextStep, STEP_DELAY);
      }, PAUSE_AFTER_DONE);
    }
  }

  function startProcessAnim() {
    if (_procStarted) return;
    _procStarted = true;
    setStep(0);
    _procTimer = setInterval(nextStep, STEP_DELAY);
  }

  // 화면에 보일 때 시작
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) startProcessAnim();
    });
  }, { threshold: 0.3 });

  document.addEventListener('DOMContentLoaded', () => {
    const section = document.getElementById('processSteps');
    if (section) observer.observe(section);
  });
})();

// ===== 고객 원본 파일 업로드 =====
function openClientDrive() {
  // 실제 배포 시 주문번호별 전용 드라이브 폴더 URL로 교체
  const driveUrl = 'https://drive.google.com';
  window.open(driveUrl, '_blank');
}

function submitClientUpload() {
  const link = document.getElementById('clientFileLink')?.value?.trim();
  if (!link) { showToast('파일 링크를 입력해주세요'); return; }

  // 현재 주문 ID 가져오기 (주문 상세에서 data-order-id 속성 또는 전역 변수)
  const orderId = window._currentClientOrderId;

  // Firestore sourceFileUrl 업데이트
  if (orderId && window._db && window._fsDoc && window._fsUpdateDoc) {
    const ref = window._fsDoc(window._db, 'orders', orderId);
    window._fsUpdateDoc(ref, {
      sourceFileUrl: link,
      uploadedAt: new Date().toISOString(),
      status: 'waiting'
    }).then(function() {
      console.log('[Firestore] 파일 링크 저장 완료:', orderId);
    }).catch(function(e) {
      console.warn('[Firestore] 파일 링크 저장 실패:', e.message);
    });
  }

  document.getElementById('clientUploadUI').style.display = 'none';
  document.getElementById('clientUploadDone').style.display = 'block';
  const spItems = document.querySelectorAll('.sp-item');
  if (spItems[0]) { spItems[0].classList.add('done'); spItems[0].querySelector('.sp-dot').textContent = '✓'; }
  showToast('✓ 파일이 업로드되었습니다. 에이컷 팀에 전달됩니다!');
}

// ===== 히어로 배경 영상 — 인디케이터 연동 =====
const _heroVideos = [
  'https://assets.mixkit.co/videos/21546/21546-720.mp4',
  'https://assets.mixkit.co/videos/50610/50610-720.mp4',
  'https://assets.mixkit.co/videos/44054/44054-720.mp4'
];
let _heroVideoIdx = 0;

function playHeroVideo(index) {
  const video = document.getElementById('heroBgVideo');
  if (!video) return;
  _heroVideoIdx = ((index % _heroVideos.length) + _heroVideos.length) % _heroVideos.length;
  video.src = _heroVideos[_heroVideoIdx];
  video.load();
  const p = video.play();
  if (p !== undefined) {
    p.catch(() => {
      // 자동재생 실패 시 다음 영상 시도
      setTimeout(() => playHeroVideo(_heroVideoIdx + 1), 1000);
    });
  }
}

(function() {
  const video = document.getElementById('heroBgVideo');
  if (!video) return;

  // 영상 끝나면 부드럽게 다음 영상
  video.addEventListener('ended', function() {
    const next = (_heroVideoIdx + 1) % _heroVideos.length;
    // 슬라이드 인디케이터 동기화
    goSlide(next);
    // 부드러운 전환 — 페이드 없이 바로 다음 영상
    _heroVideoIdx = next;
    video.src = _heroVideos[_heroVideoIdx];
    video.load();
    video.play().catch(() => {});
  });

  // 영상 로드 오류 시 다음 영상
  video.addEventListener('error', function() {
    const next = (_heroVideoIdx + 1) % _heroVideos.length;
    setTimeout(() => {
      _heroVideoIdx = next;
      video.src = _heroVideos[_heroVideoIdx];
      video.load();
      video.play().catch(() => {});
    }, 500);
  });

  // 영상이 멈춘 경우 감지 후 재생 재시도
  video.addEventListener('stalled', function() {
    setTimeout(() => {
      if (video.paused) video.play().catch(() => {});
    }, 2000);
  });

  video.addEventListener('waiting', function() {
    setTimeout(() => {
      if (video.paused && video.readyState >= 2) {
        video.play().catch(() => {});
      }
    }, 3000);
  });

  // 페이지 가시성 변경 시 재생 재개 (탭 전환 후 복귀)
  document.addEventListener('visibilitychange', function() {
    if (!document.hidden && video.paused) {
      video.play().catch(() => {});
    }
  });

  // 4초 내 로드 안 되면 다음 영상
  setTimeout(function() {
    if (video.readyState === 0) {
      _heroVideoIdx = 1;
      video.src = _heroVideos[1];
      video.load();
      video.play().catch(() => {});
    }
  }, 4000);

  playHeroVideo(0);
})();

