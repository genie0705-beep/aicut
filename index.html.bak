  </div>
  <div style="display:flex;justify-content:center;align-items:center;gap:0;flex-wrap:nowrap;margin-bottom:clamp(32px,5vw,60px);padding:clamp(20px,4vw,48px) clamp(12px,3vw,60px);max-width:960px;margin-left:auto;margin-right:auto;background:rgba(255,255,255,0.04);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,0.08);border-radius:24px">

