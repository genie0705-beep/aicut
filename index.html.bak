  <!-- 헤더 -->
  <div style="text-align:center;margin-bottom:64px;padding:0 24px">
    <span class="section-eyebrow" style="color:#7c5df8">CLIENT REVIEWS</span>
    <h2 class="section-title" style="color:white;margin-bottom:6px"><span data-i18n="reviews_h">에이컷 고객사 만족도</span> <span style="color:#a78bfa">4.9점</span></h2>
    <p style="font-size:13px;color:rgba(255,255,255,0.4)" data-i18n="reviews_sub2">실제 이용 고객 후기 · 월 정기 편집 파트너</p>
