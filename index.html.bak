<!-- PROCESS STEPS -->
<section id="steps-section" class="reveal" style="background:var(--gray-50);padding:clamp(80px,8vw,120px) 0;text-align:center">

  <!-- 헤더 -->
  <div style="padding:0 clamp(16px,4vw,48px);margin-bottom:36px">
    <span class="section-eyebrow">PROCESS</span>
    <h2 class="section-title" style="color:var(--primary);word-break:keep-all;margin-bottom:40px" data-i18n="process_title">온보딩부터 납품까지<br data-i18n="process_sub">정기 편집 5단계</h2>

    <!-- 스텝 인디케이터 -->
    <div style="display:flex;align-items:flex-start;justify-content:center;position:relative;max-width:760px;margin:0 auto" id="psSteps">
      <!-- 연결선 -->
      <div style="position:absolute;top:22px;left:8%;right:8%;height:2px;background:var(--gray-200);z-index:0"></div>
      <div id="psLine" style="position:absolute;top:22px;left:8%;height:2px;background:#5c3de8;z-index:1;width:0%;transition:width .5s ease"></div>

      <div class="ps-si active" onclick="pGoSlide(0)" style="display:flex;flex-direction:column;align-items:center;gap:8px;cursor:pointer;flex:1;position:relative;z-index:2">
        <div class="ps-sn" style="width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:800;transition:all .3s;background:#5c3de8;color:white;border:2px solid #5c3de8;box-shadow:0 0 0 5px rgba(92,61,232,0.15)">1</div>
        <div style="font-size:14px;font-weight:700;color:#5c3de8;white-space:nowrap" data-i18n="how_step1">영상 업로드</div>
      </div>
      <div class="ps-si" onclick="pGoSlide(1)" style="display:flex;flex-direction:column;align-items:center;gap:8px;cursor:pointer;flex:1;position:relative;z-index:2">
        <div class="ps-sn" style="width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:800;transition:all .3s;background:var(--gray-100);color:var(--gray-400);border:2px solid var(--gray-200)">2</div>
        <div style="font-size:14px;color:var(--gray-400);white-space:nowrap" data-i18n="step2_title">에디터 배정</div>
      </div>
      <div class="ps-si" onclick="pGoSlide(2)" style="display:flex;flex-direction:column;align-items:center;gap:8px;cursor:pointer;flex:1;position:relative;z-index:2">
        <div class="ps-sn" style="width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:800;transition:all .3s;background:var(--gray-100);color:var(--gray-400);border:2px solid var(--gray-200)">3</div>
        <div style="font-size:14px;color:var(--gray-400);white-space:nowrap" data-i18n="step3_title">편집 진행</div>
      </div>
      <div class="ps-si" onclick="pGoSlide(3)" style="display:flex;flex-direction:column;align-items:center;gap:8px;cursor:pointer;flex:1;position:relative;z-index:2">
        <div class="ps-sn" style="width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:800;transition:all .3s;background:var(--gray-100);color:var(--gray-400);border:2px solid var(--gray-200)">4</div>
        <div style="font-size:14px;color:var(--gray-400);white-space:nowrap">검수 &amp; 수정</div>
      </div>
      <div class="ps-si" onclick="pGoSlide(4)" style="display:flex;flex-direction:column;align-items:center;gap:8px;cursor:pointer;flex:1;position:relative;z-index:2">
