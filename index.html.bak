<section id="stats-section" style="background:radial-gradient(ellipse at 20% 50%, rgba(108,99,255,0.18) 0%, transparent 60%),radial-gradient(ellipse at 80% 50%, rgba(255,101,132,0.12) 0%, transparent 60%),linear-gradient(135deg,#0f0f1a 0%,#1a1040 50%,#0a0f2e 100%);padding:clamp(48px,8vw,80px) clamp(16px,4vw,0px);overflow:hidden;position:relative">

