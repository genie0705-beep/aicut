    const idx = Math.floor(Math.random() * _fcFallbacks.length);
    fcBotMsg(_fcFallbacks[idx]);
    // 운영팀 연결 안내
    setTimeout(() => {
      fcBotMsg('직접 상담을 원하시면 아래 버튼을 눌러주세요 😊');
